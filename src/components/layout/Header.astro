---
import logo from "../../assets/icons/logo-quimica.svg";
---

<header class="site-header">
  <div class="announcement">
    <div class="announcement__inner">
      <span>
        Venta mayorista y minorista
        <span class="envios"> - Envíos a todo el país</span>
      </span>
      <span>Alberdi 629 &middot; Victoria, Entre Ríos</span>
    </div>
  </div>
  <div class="nav-shell">
    <a
      href="#inicio"
      class="brand"
      aria-label="Quimica Estampados, ir al inicio"
      ><img src={logo.src} width="48" height="48" alt="" /></a
    >
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-menu"
    >
      <span class="visually-hidden">Abrir menu</span><span></span><span
      ></span><span></span>
    </button>
    <nav id="main-menu" class="main-nav" aria-label="Navegacion principal">
      <ul class="nav-list">
        <li><a class="nav-link is-active" href="#inicio" aria-current="page">Inicio</a></li>
        <li class="nav-item--services">
          <button
            class="nav-menu__trigger"
            type="button"
            aria-expanded="false"
            aria-controls="services-menu"
          >
            Servicios <span class="chevron" aria-hidden="true"></span>
          </button>
          <ul id="services-menu" class="services-menu" hidden>
            <li><a href="#servicios">Calcos</a></li>
            <li><a href="#servicios">Plotters</a></li>
            <li><a href="#servicios">Diseño gráfico</a></li>
            <li class="services-menu__nested">
              <button
                class="services-submenu__trigger"
                type="button"
                aria-expanded="false"
                aria-controls="textile-menu"
              >
                Estampado textil <span class="chevron" aria-hidden="true"></span>
              </button>
              <ul id="textile-menu" class="services-submenu" hidden>
                <li><a href="#servicios">Remeras</a></li>
                <li><a href="#servicios">Camperas</a></li>
                <li><a href="#servicios">Gorras</a></li>
                <li><a href="#servicios">Egresaditos</a></li>
                <li><a href="#servicios">Infantil</a></li>
              </ul>
            </li>
          </ul>
        </li>
        <li><a class="nav-link" href="#trabajos">Trabajos</a></li>
        <li><a class="nav-link" href="#nosotros">Nosotros</a></li>
        <li><a class="nav-link" href="#contacto">Contacto</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const button = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>(".main-nav");
  const servicesItem = document.querySelector<HTMLElement>(".nav-item--services");
  const servicesTrigger = document.querySelector<HTMLButtonElement>(".nav-menu__trigger");
  const servicesMenu = document.querySelector<HTMLElement>(".services-menu");
  const textileTrigger = document.querySelector<HTMLButtonElement>(".services-submenu__trigger");
  const textileMenu = document.querySelector<HTMLElement>(".services-submenu");
  const navOptions = document.querySelectorAll<HTMLElement>(".nav-link, .nav-menu__trigger");

  const updateHeaderSize = () => {
    header?.classList.toggle("is-scrolled", window.scrollY > 24);
  };

  updateHeaderSize();
  window.addEventListener("scroll", updateHeaderSize, { passive: true });

  const setActiveOption = (activeOption: HTMLElement) => {
    navOptions.forEach((option) => {
      option.classList.toggle("is-active", option === activeOption);
      option.removeAttribute("aria-current");
    });
    activeOption.setAttribute("aria-current", "page");
  };

  const closeServicesMenu = () => {
    servicesTrigger?.setAttribute("aria-expanded", "false");
    if (servicesMenu) servicesMenu.hidden = true;
    textileTrigger?.setAttribute("aria-expanded", "false");
    if (textileMenu) textileMenu.hidden = true;
  };

  const closeMenu = () => {
    button?.setAttribute("aria-expanded", "false");
    menu?.classList.remove("is-open");
  };

  button?.addEventListener("click", () => {
    const isOpen = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!isOpen));
    menu?.classList.toggle("is-open", !isOpen);
  });

  servicesTrigger?.addEventListener("click", () => {
    const isOpen = servicesTrigger.getAttribute("aria-expanded") === "true";
    servicesTrigger.setAttribute("aria-expanded", String(!isOpen));
    if (servicesMenu) servicesMenu.hidden = isOpen;
    setActiveOption(servicesTrigger);
  });

  textileTrigger?.addEventListener("click", () => {
    const isOpen = textileTrigger.getAttribute("aria-expanded") === "true";
    textileTrigger.setAttribute("aria-expanded", String(!isOpen));
    if (textileMenu) textileMenu.hidden = isOpen;
  });

  menu?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => {
      if (link.closest(".services-menu")) {
        if (servicesTrigger) setActiveOption(servicesTrigger);
      } else {
        setActiveOption(link);
      }
      closeServicesMenu();
      closeMenu();
    });
  });

  document.addEventListener("click", (event) => {
    if (!servicesItem?.contains(event.target as Node)) closeServicesMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeServicesMenu();
      closeMenu();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(7, 7, 7, 0.94);
    display: flex;
    flex-direction: column;
    width: 100vw;
    transition: box-shadow var(--transition);
  }
  .site-header.is-scrolled {
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }
  .announcement {
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.875rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    height: 3.375rem;
    letter-spacing: 0.088rem;
    text-transform: uppercase;
    overflow: hidden;
    transition:
      height var(--transition),
      opacity var(--transition),
      border-color var(--transition);
  }
  .site-header.is-scrolled .announcement {
    height: 0;
    opacity: 0;
    border-bottom-color: transparent;
    pointer-events: none;
  }
  .announcement__inner {
    width: 100%;
    min-height: 27px;
    padding-inline: var(--container-padding);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    color: #777;
  }
  .announcement__inner > span:first-child {
    grid-column: 2;
  }
  .announcement__inner > span:last-child {
    grid-column: 3;
    justify-self: end;
  }
  .envios {
    color: var(--color-cyan);
  }
  .announcement__accent {
    color: var(--color-cyan);
  }
  .nav-shell {
    width: 100%;
    height: 6.25rem;
    min-height: 100px;
    padding-inline: clamp(24px, 4.2vw, 80px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
    transition:
      height var(--transition),
      min-height var(--transition);
  }
  .brand img {
    width: 80px;
    height: 80px;   
    display: block;
    transition:
      width var(--transition),
      height var(--transition);
  }
  .site-header.is-scrolled .nav-shell {
    height: 68px;
    min-height: 68px;
  }
  .site-header.is-scrolled .brand img {
    width: 50px;
    height: 50px;
  }
  .main-nav {
    display: flex;
    align-items: center;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .nav-list > li {
    position: relative;
  }
  .nav-link,
  .nav-menu__trigger {
    min-height: 42px;
    padding: 0.68rem 1.15rem;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: #8d8d8d;
    background: transparent;
    border: 1px solid transparent;
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.088rem;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition);
  }
  .nav-link.is-active,
  .nav-menu__trigger.is-active {
    color: var(--color-magenta);
    border: 1px solid var(--color-magenta);
  }
  .chevron {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    margin-top: -0.2rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--transition);
  }
  [aria-expanded="true"] > .chevron {
    margin-top: 0.2rem;
    transform: rotate(225deg);
  }
  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-menu__trigger:hover,
  .nav-menu__trigger:focus-visible {
    color: #fff;
  }
  .services-menu,
  .services-submenu {
    list-style: none;
  }
  .services-menu {
    position: absolute;
    top: calc(100% + 0.65rem);
    left: 0;
    z-index: 30;
    width: max-content;
    min-width: 190px;
    padding: 0.4rem 0.2rem 0.7rem;
    background: #0d0d0d;
    border: 1px solid var(--color-border);
  }
  .services-menu[hidden],
  .services-submenu[hidden] {
    display: none;
  }
  .services-menu a,
  .services-submenu__trigger {
    width: 100%;
    padding: 0.48rem 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    color: #e6e6e6;
    background: transparent;
    border: 0;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
  }
  .services-menu a:hover,
  .services-menu a:focus-visible,
  .services-submenu__trigger:hover,
  .services-submenu__trigger:focus-visible,
  .services-submenu__trigger[aria-expanded="true"] {
    color: var(--color-magenta);
  }
  .services-submenu {
    padding: 0.1rem 0 0.2rem 0.65rem;
  }
  .services-submenu a {
    color: #d0d0d0;
  }
  .menu-toggle {
    display: none;
    width: 38px;
    height: 38px;
    padding: 9px;
    border: 1px solid var(--color-border);
    background: transparent;
  }
  .menu-toggle span:not(.visually-hidden) {
    display: block;
    height: 1px;
    margin: 5px 0;
    background: #fff;
  }
  @media (max-width: 760px) {
    .announcement__inner {
      min-height: 22px;
      font-size: 0.44rem;
    }
    .announcement__inner span:first-child {
      display: none;
    }
    .nav-shell {
      height: 58px;
      min-height: 58px;
      padding-inline: var(--container-padding);
    }
    .brand img {
      width: 34px;
      height: 34px;
    }
    .site-header.is-scrolled .nav-shell {
      height: 58px;
      min-height: 58px;
    }
    .site-header.is-scrolled .brand img {
      width: 34px;
      height: 34px;
    }
    .menu-toggle {
      display: block;
    }
    .main-nav {
      position: absolute;
      inset: 100% var(--container-padding) auto;
      display: none;
      padding: 1.5rem;
      align-items: stretch;
      flex-direction: column;
      gap: 1.5rem;
      background: #0d0d0d;
      border: 1px solid var(--color-border);
      box-shadow: 0 25px 60px #000;
    }
    .main-nav.is-open {
      display: flex;
    }
    .nav-list {
      align-items: stretch;
      flex-direction: column;
      gap: 1.2rem;
    }
    .nav-link,
    .nav-menu__trigger {
      width: 100%;
      justify-content: space-between;
    }
    .services-menu {
      position: static;
      width: 100%;
      margin-top: 0.35rem;
      padding-left: 0.5rem;
      background: transparent;
      border: 0;
    }
  }
</style>
