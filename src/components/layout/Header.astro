---
import logo from "../../assets/icons/logo-quimica.svg";
import { siteConfig } from "../../data/site";
import { catalogList } from "../../data/pricing";
import { visibleProducts } from "../../data/products";

const isProductRoute = Astro.url.pathname.startsWith("/productos/");
const productLinks = new Map<string, string>(
  visibleProducts.filter((product) => !product.requiresConsultation)
    .map((product) => [product.pricingId, `/productos/${product.slug}/`]),
);
const visibleCatalog = catalogList.filter((product) => productLinks.has(product.id));
const textileCategories = new Set(["Remeras", "Chombas", "Buzos", "Gorras"]);
const catalogLink = (product: (typeof catalogList)[number]) => ({
  label: product.name,
  href: productLinks.get(product.id)!,
});
const serviceGroups = [
  ...[...new Set(visibleCatalog.map((product) => product.category))]
    .filter((category) => !textileCategories.has(category))
    .map((category) => ({
      label: category,
      links: visibleCatalog.filter((product) => product.category === category).map(catalogLink),
    })),
  {
    label: "Estampado textil",
    links: [
      ...visibleCatalog.filter((product) => textileCategories.has(product.category)).map(catalogLink),
      ...visibleProducts.filter((product) => product.requiresConsultation).map((product) => ({
        label: product.title,
        href: `/productos/${product.slug}/`,
      })),
    ],
  },
];
---

<header class="site-header">
  <div class="announcement">
    <div class="announcement__inner">
      <span>
        Venta mayorista y minorista
        <span class="envios"> - Productos personalizados</span>
      </span>
      <span>{siteConfig.address.street} - {siteConfig.address.city}, {siteConfig.address.province}</span>
    </div>
  </div>
  <div class="nav-shell">
    <a
      href="/#inicio"
      class="brand"
      aria-label="Química Estampados, ir al inicio"
      ><img src={logo.src} width="48" height="48" alt="" /></a
    >
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="main-menu"
    >
      <span class="visually-hidden">Abrir menú</span><span></span><span
      ></span><span></span>
    </button>
    <nav id="main-menu" class="main-nav" aria-label="Navegación principal">
      <ul class="nav-list">
        <li>
          <a
            class:list={["nav-link", { "is-active": !isProductRoute }]}
            href="/#inicio"
            aria-current={!isProductRoute ? "page" : undefined}
          >Inicio</a>
        </li>
        <li class="nav-item--services">
          <button
            class:list={["nav-menu__trigger", { "is-active": isProductRoute }]}
            type="button"
            aria-expanded="false"
            aria-controls="services-menu"
            aria-current={isProductRoute ? "page" : undefined}
          >
            Servicios <span class="chevron" aria-hidden="true"></span>
          </button>
          <ul id="services-menu" class="services-menu" hidden>
            {serviceGroups.map((group, index) => group.links.length === 1 ? (
              <li><a href={group.links[0].href}>{group.label}</a></li>
            ) : (
              <li class="services-menu__nested">
                <button
                  class="services-submenu__trigger"
                  type="button"
                  aria-expanded="false"
                  aria-controls={`services-group-${index}`}
                >{group.label}<span class="chevron" aria-hidden="true"></span></button>
                <ul id={`services-group-${index}`} class="services-submenu" hidden>
                  {group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
                </ul>
              </li>
            ))}
          </ul>
        </li>
        <li><a class="nav-link" href="/#trabajos">Trabajos</a></li>
        <li><a class="nav-link" href="/#nosotros">Nosotros</a></li>
        <li><a class="nav-link" href="/#contacto">Contacto</a></li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header");
  const announcement = document.querySelector<HTMLElement>(".announcement");
  const button = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>(".main-nav");
  const servicesItem = document.querySelector<HTMLElement>(".nav-item--services");
  const servicesTrigger = document.querySelector<HTMLButtonElement>(".nav-menu__trigger");
  const servicesMenu = document.querySelector<HTMLElement>(".services-menu");
  const submenuTriggers = document.querySelectorAll<HTMLButtonElement>(".services-submenu__trigger");
  const navOptions = document.querySelectorAll<HTMLElement>(".nav-link, .nav-menu__trigger");
  const compactAt = announcement?.offsetHeight || 40;

  let scrollFrame: number | undefined;

  const updateHeaderOnScroll = () => {
    header?.classList.toggle("is-scrolled", window.scrollY >= compactAt);
    scrollFrame = undefined;
  };

  updateHeaderOnScroll();
  window.addEventListener("scroll", () => {
    if (scrollFrame === undefined) {
      scrollFrame = window.requestAnimationFrame(updateHeaderOnScroll);
    }
  }, { passive: true });

  const setActiveOption = (activeOption: HTMLElement) => {
    navOptions.forEach((option) => {
      option.classList.toggle("is-active", option === activeOption);
      option.removeAttribute("aria-current");
    });
    activeOption.setAttribute("aria-current", "page");
  };

  const closeSubmenus = () => {
    submenuTriggers.forEach((trigger) => {
      trigger.setAttribute("aria-expanded", "false");
      const submenu = document.getElementById(trigger.getAttribute("aria-controls") ?? "");
      if (submenu) submenu.hidden = true;
    });
  };

  const closeServicesMenu = () => {
    servicesTrigger?.setAttribute("aria-expanded", "false");
    if (servicesMenu) servicesMenu.hidden = true;
    closeSubmenus();
  };

  const closeMenu = (restoreFocus = false) => {
    closeServicesMenu();
    const wasOpen = button?.getAttribute("aria-expanded") === "true";
    button?.setAttribute("aria-expanded", "false");
    menu?.classList.remove("is-open");
    if (restoreFocus && wasOpen) button?.focus();
  };

  button?.addEventListener("click", () => {
    const isOpen = button.getAttribute("aria-expanded") === "true";
    button.setAttribute("aria-expanded", String(!isOpen));
    menu?.classList.toggle("is-open", !isOpen);
  });

  servicesTrigger?.addEventListener("click", () => {
    const isOpen = servicesTrigger.getAttribute("aria-expanded") === "true";
    servicesTrigger.setAttribute("aria-expanded", String(!isOpen));
    if (isOpen) closeServicesMenu();
    else if (servicesMenu) servicesMenu.hidden = false;
    setActiveOption(servicesTrigger);
  });

  submenuTriggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const isOpen = trigger.getAttribute("aria-expanded") === "true";
      closeSubmenus();
      if (isOpen) return;
      const submenu = document.getElementById(trigger.getAttribute("aria-controls") ?? "");
      trigger.setAttribute("aria-expanded", "true");
      if (submenu) submenu.hidden = false;
    });
  });

  menu?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => {
      if (link.closest(".services-menu")) {
        if (servicesTrigger) setActiveOption(servicesTrigger);
      } else {
        setActiveOption(link);
      }
      closeServicesMenu();
      closeMenu();
    });
  });

  document.addEventListener("click", (event) => {
    if (!servicesItem?.contains(event.target as Node)) closeServicesMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") {
      closeServicesMenu();
      closeMenu(true);
    }
  });

  window.matchMedia("(min-width: 56.01rem)").addEventListener("change", (event) => {
    if (event.matches) closeMenu();
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
    height: 154px;
    background: rgba(10, 10, 10, 0.96);
    display: flex;
    flex-direction: column;
    width: 100%;
    transition: box-shadow var(--transition);
  }
  .site-header.is-scrolled {
    background: transparent;
  }
  .announcement {
    border-bottom: 0;
    font-family: var(--font-jetbrains-mono);
    font-size: 0.875rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    height: 54px;
    letter-spacing: 0.088rem;
    text-transform: uppercase;
    overflow: hidden;
    transition:
      height var(--transition),
      opacity var(--transition),
      border-color var(--transition);
  }
  .site-header.is-scrolled .announcement {
    height: 0;
    opacity: 0;
    border-bottom-color: transparent;
    pointer-events: none;
  }
  .announcement__inner {
    width: 100%;
    min-height: 27px;
    padding-inline: 25px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    color: #d7d7d7;
  }
  .announcement__inner > span:first-child {
    grid-column: 2;
  }
  .announcement__inner > span:last-child {
    grid-column: 3;
    justify-self: end;
  }
  .envios {
    color: var(--color-cyan);
  }
  .announcement__accent {
    color: var(--color-cyan);
  }
  .nav-shell {
    position: relative;
    width: 100%;
    height: 100px;
    min-height: 100px;
    padding: 0 82px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 0;
    transition:
      height var(--transition),
      min-height var(--transition),
      padding var(--transition);
  }
  .brand img {
    width: 80px;
    height: 80px;   
    display: block;
    transition:
      width var(--transition),
      height var(--transition);
  }
  .site-header.is-scrolled .nav-shell {
    position: fixed;
    inset: 0 0 auto;
    z-index: 20;
    height: 82px;
    min-height: 82px;
    padding: 10px 82px 14px;
    background: rgba(7, 7, 7, 0.96);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
  }
  .site-header.is-scrolled .brand img {
    width: 58px;
    height: 58px;
  }
  .main-nav {
    display: flex;
    align-items: center;
  }
  .nav-list {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .nav-list > li {
    position: relative;
  }
  .nav-link,
  .nav-menu__trigger {
    min-height: 20px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: #d7d7d7;
    background: transparent;
    border: 1px solid transparent;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 1.4px;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition);
  }
  .nav-link.is-active,
  .nav-menu__trigger.is-active {
    min-height: 35px;
    padding: 7.5px 17px;
    color: var(--color-magenta);
    border: 1px solid var(--color-magenta);
  }
  .chevron {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    margin-top: -0.2rem;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    transition: transform var(--transition);
  }
  [aria-expanded="true"] > .chevron {
    margin-top: 0.2rem;
    transform: rotate(225deg);
  }
  .nav-link:hover,
  .nav-link:focus-visible,
  .nav-menu__trigger:hover,
  .nav-menu__trigger:focus-visible {
    color: #fff;
  }
  .services-menu,
  .services-submenu {
    list-style: none;
  }
  .services-menu {
    position: absolute;
    top: calc(100% + 0.65rem);
    left: 0;
    z-index: 30;
    width: max-content;
    min-width: 190px;
    max-width: min(22rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 11rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding: 0.4rem 0.2rem 0.7rem;
    background: #0d0d0d;
    border: 1px solid var(--color-border);
  }
  .services-menu[hidden],
  .services-submenu[hidden] {
    display: none;
  }
  .services-menu a,
  .services-submenu__trigger {
    width: 100%;
    padding: 0.48rem 0.75rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    color: #e6e6e6;
    background: transparent;
    border: 0;
    font-family: var(--font-poppins);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.2;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
  }
  .services-menu a:hover,
  .services-menu a:focus-visible,
  .services-submenu__trigger:hover,
  .services-submenu__trigger:focus-visible,
  .services-submenu__trigger[aria-expanded="true"] {
    color: var(--color-magenta);
  }
  .services-submenu {
    padding: 0.1rem 0 0.2rem 0.65rem;
  }
  .services-submenu a {
    color: #d0d0d0;
  }
  .menu-toggle {
    display: none;
    width: 38px;
    height: 38px;
    padding: 9px;
    border: 1px solid var(--color-border);
    background: transparent;
  }
  .menu-toggle span:not(.visually-hidden) {
    display: block;
    height: 1px;
    margin: 5px 0;
    background: #fff;
  }
  @media (min-width: 56.01rem) and (max-width: 75.625rem) {
    .announcement__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.72fr);
      gap: 1rem;
      padding-inline: 32px;
      font-size: 0.75rem;
      letter-spacing: 0.06rem;
      line-height: 1.25;
    }
    .announcement__inner > span:first-child {
      grid-column: 1;
      min-width: 0;
    }
    .announcement__inner > span:last-child {
      grid-column: 2;
      min-width: 0;
      text-align: right;
    }
    .nav-shell {
      padding-inline: 32px;
    }
    .brand img {
      width: 64px;
      height: 64px;
    }
    .nav-list {
      gap: 20px;
    }
    .nav-link,
    .nav-menu__trigger {
      font-size: 0.75rem;
      letter-spacing: 0.08rem;
    }
  }
  @media (max-width: 56rem) {
    :global(:root) {
      --header-height: 84px;
    }

    .site-header {
      --mobile-menu-offset: 170px;
      height: 170px;
    }
    .site-header.is-scrolled {
      --mobile-menu-offset: 82px;
    }
    .announcement {
      height: 86px;
      min-height: 86px;
    }
    .site-header.is-scrolled .announcement {
      min-height: 0;
    }
    .announcement__inner {
      min-height: 0;
      height: 86px;
      padding: 0 12px;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 54px 32px;
      gap: 0;
      font-size: 14px;
      letter-spacing: 1.4px;
      line-height: 20px;
      text-align: center;
    }
    .announcement__inner span:first-child {
      display: block;
      grid-column: 1;
      align-self: center;
      justify-self: center;
      white-space: normal;
    }
    .announcement__inner > span:last-child {
      grid-column: 1;
      align-self: start;
      justify-self: center;
      color: var(--color-magenta);
      font-size: 12px;
    }
    .envios {
      display: inline;
      font-size: inherit;
    }
    .nav-shell {
      height: 84px;
      min-height: 84px;
      padding-inline: 12px;
      padding-bottom: 24px;
    }
    .brand img {
      width: 60px;
      height: 60px;
    }
    .site-header.is-scrolled .nav-shell {
      height: 82px;
      min-height: 82px;
      padding: 10px 12px 12px;
    }
    .site-header.is-scrolled .brand img {
      width: 60px;
      height: 60px;
    }
    .menu-toggle {
      display: block;
      transform: none;
    }
    .main-nav {
      position: absolute;
      inset: 100% 12px auto;
      display: none;
      max-height: calc(100dvh - var(--mobile-menu-offset) - 12px);
      padding: 1rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      align-items: stretch;
      flex-direction: column;
      gap: 1.5rem;
      background: #0d0d0d;
      border: 1px solid var(--color-border);
      box-shadow: 0 25px 60px #000;
      transform: none;
    }
    .main-nav.is-open {
      display: flex;
    }
    .site-header.is-scrolled .main-nav {
      position: fixed;
      inset: 82px 12px auto;
    }
    .nav-list {
      align-items: stretch;
      flex-direction: column;
      gap: 1.2rem;
    }
    .nav-link,
    .nav-menu__trigger {
      width: 100%;
      min-height: 44px;
      padding: 0.75rem;
      justify-content: space-between;
    }
    .nav-link.is-active,
    .nav-menu__trigger.is-active {
      min-height: 44px;
      padding: 0.75rem;
    }
    .services-menu a,
    .services-submenu__trigger {
      min-height: 44px;
    }
    .services-menu {
      position: static;
      width: 100%;
      min-width: 0;
      max-width: none;
      max-height: none;
      overflow: visible;
      margin-top: 0.35rem;
      padding-left: 0.5rem;
      background: transparent;
      border: 0;
    }
  }

  @media (max-width: 30rem) {
    .announcement__inner {
      font-size: 0.6875rem;
      letter-spacing: 0.055rem;
      line-height: 1.35;
    }

    .envios { display: block; }

    .nav-shell {
      padding-inline: 0.75rem;
    }
  }
</style>
