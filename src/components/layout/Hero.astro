---
import { Image } from "astro:assets";
import mainProduct from "../../assets/images/hero-shirt.png";
import smallHoodie from "../../assets/images/hero-hoodie.png";
import cap from "../../assets/images/hero-cap.png";
import BackgroundText from "../shared/BackgroundText.astro";

const tickerItems = Array(7).fill("Dale vida a tu marca");
---

<section id="inicio" class="hero">
  <BackgroundText />

  <div class="hero__ticker" aria-hidden="true">
    <div class="hero__ticker-track">
      <div class="hero__ticker-group">
        {tickerItems.map((item) => <span>{item}</span>)}
      </div>
      <div class="hero__ticker-group">
        {tickerItems.map((item) => <span>{item}</span>)}
      </div>
    </div>
  </div>

  <div class="hero__grid">
    <div class="hero__intro">
      <p class="hero__rail" aria-hidden="true">
        <span class="copy-desktop">Creamos</span>
        <span class="copy-responsive">Estampamos</span>
      </p>

      <h1>
        <span class="visually-hidden">Química Estampados: tu marca, idea y negocio</span>
        <span class="hero__headline copy-desktop" aria-hidden="true">
          <span>Lo</span>
          <span>que tu</span>
          <span>marca</span>
          <span>necesita</span>
        </span>
        <span class="hero__headline copy-responsive" aria-hidden="true">
          <span>Tu</span>
          <span>marca</span>
          <span>idea y</span>
          <span>negocio</span>
        </span>
      </h1>

      <ul class="hero__list">
        <li>Diseño y personalización de productos para tu marca</li>
        <li>
          <span class="copy-desktop">Estampados · Diseño · Impresión</span>
          <span class="copy-responsive">Estampados textiles • DTF • Sublimación</span>
        </li>
        <li>
          <span class="copy-desktop">100% algodón peinado 24.1</span>
          <span class="copy-responsive">100% algodón premium</span>
        </li>
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <Image
        class="hero__shirt"
        src={mainProduct}
        alt=""
        loading="eager"
        fetchpriority="high"
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 40rem) 92vw, (max-width: 64rem) 60vw, 32vw"
      />
      <Image
        class="hero__hoodie"
        src={smallHoodie}
        alt=""
        loading="eager"
        widths={[160, 240, 320, 480]}
        sizes="(max-width: 40rem) 28vw, (max-width: 64rem) 18vw, 13vw"
      />
      <Image
        class="hero__cap"
        src={cap}
        alt=""
        loading="eager"
        widths={[240, 360, 480, 640, 800]}
        sizes="(max-width: 40rem) 42vw, (max-width: 64rem) 28vw, 18vw"
      />
    </div>

    <div class="hero__actions">
      <a class="button button--primary" href="#contacto">Solicitar presupuesto</a>
      <a class="button" href="#trabajos">Ver trabajos realizados</a>
    </div>
  </div>
</section>

<style>
  .hero {
    --background-text-left: 3.59375%;

    position: relative;
    isolation: isolate;
    width: 100%;
    height: clamp(42rem, 46.875vw, 56.25rem);
    min-height: clamp(42rem, 46.875vw, 56.25rem);
    overflow: hidden;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__ticker {
    position: absolute;
    inset: 11px 0 auto;
    z-index: 4;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.4);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 1px;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero__ticker-track {
    width: max-content;
    display: flex;
    align-items: center;
    animation: ticker-scroll 70s linear infinite;
    will-change: transform;
  }

  .hero__ticker-group {
    width: max-content;
    flex: 0 0 auto;
    padding-right: 60px;
    display: flex;
    align-items: center;
    gap: 60px;
  }

  @keyframes ticker-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
  }

  .hero__intro {
    position: absolute;
    top: 25%;
    left: 4.3229%;
    width: 30.2604%;
    height: 65.8889%;
    display: grid;
    grid-template-columns: clamp(2.5rem, 2.9167vw, 3.5rem) minmax(0, 1fr);
    grid-template-rows: 67.6667% 23%;
    align-items: end;
    column-gap: clamp(0.7rem, 1.1458vw, 1.375rem);
    row-gap: 8.1667%;
  }

  .hero__rail {
    grid-column: 1;
    grid-row: 1;
    color: var(--color-magenta);
    font-family: var(--font-montserrat);
    height: 100%;
    font-size: clamp(3rem, 3.75vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  h1 {
    grid-column: 2;
    grid-row: 1;
    color: #ffffff;
    font-family: var(--font-montserrat);
    font-size: clamp(1.9rem, 2.3438vw, 2.8125rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.095;
    text-transform: uppercase;
  }

  h1 span {
    display: block;
  }

  .copy-responsive { display: none; }

  .hero__list {
    grid-column: 1 / -1;
    grid-row: 2;
    min-width: 0;
    height: 100%;
    margin-top: 0;
    display: grid;
    align-content: space-between;
    color: #ffffff;
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.65rem, 0.7292vw, 0.875rem);
    font-weight: 700;
    letter-spacing: 1.8px;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero__list li {
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .hero__list li::before {
    content: "";
    width: 2px;
    height: 26px;
    margin-right: 10px;
    flex: 0 0 auto;
    background: var(--color-cyan);
  }

  .hero__list li:nth-child(2)::before {
    background: var(--color-magenta);
  }

  .hero__list li:nth-child(3)::before {
    background: var(--color-yellow);
  }

  .hero__visual {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__visual img {
    position: absolute;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 34px 24px rgba(0, 0, 0, 0.72));
  }

  .hero__shirt {
    z-index: 2;
    top: 50%;
    left: 50%;
    width: 39.0625%;
    transform: translate(-50%, -50%);
    filter: drop-shadow(0 0 2px rgba(255, 255, 255, 0.7));
  }

  .hero__hoodie {
    z-index: 1;
    top: 42.1111%;
    left: 61.09375%;
    width: 19.7396%;
  }

  .hero__cap {
    z-index: 3;
    top: 56.4444%;
    left: 82.4479%;
    width: 13.0208%;
  }

  .hero__actions {
    position: absolute;
    bottom: clamp(1rem, 1.0938vw, 1.3125rem);
    left: 50%;
    z-index: 3;
    width: min(31.5625%, 606px);
    display: flex;
    gap: clamp(0.85rem, 1.25vw, 1.5rem);
    transform: translateX(-50%);
  }

  .hero__actions .button {
    position: relative;
    width: calc((100% - clamp(0.85rem, 1.25vw, 1.5rem)) / 2);
    min-width: 0;
    min-height: clamp(2.75rem, 2.8646vw, 3.4375rem);
    padding: 0.65rem 0.75rem;
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.625rem, 0.7292vw, 0.875rem);
    letter-spacing: 1.4px;
    white-space: nowrap;
  }

  .hero__actions .button::before,
  .hero__actions .button::after {
    content: "";
    position: absolute;
    height: 2px;
    background: var(--color-background);
    pointer-events: none;
  }

  .hero__actions .button::before {
    top: -1px;
    left: 11px;
    width: 25px;
  }

  .hero__actions .button::after {
    right: 11px;
    bottom: -1px;
    width: 45px;
    background: linear-gradient(
      90deg,
      var(--color-background) 0 25px,
      transparent 25px 35px,
      var(--color-background) 35px 45px
    );
  }

  @media (max-width: 80rem) {
    .hero {
      height: auto;
      min-height: 0;
    }

    .copy-desktop { display: none; }
    .copy-responsive { display: block; }

    .hero__ticker { font-size: 0.625rem; }
    .hero__ticker-group { padding-right: 2.5rem; gap: 2.5rem; }

    .hero__grid {
      position: relative;
      inset: auto;
      height: auto;
      padding: 4.75rem clamp(1.25rem, 5vw, 3rem) 2rem;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto clamp(28rem, 55vw, 36rem) auto;
      grid-template-areas: "intro" "visual" "actions";
      gap: 2rem;
    }

    .hero__intro {
      position: relative;
      top: auto;
      left: auto;
      width: min(100%, 38rem);
      height: auto;
      grid-area: intro;
      grid-template-columns: 3.25rem minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 0.9rem;
      row-gap: 0;
      justify-self: start;
    }

    .hero__rail { height: auto; font-size: 3.25rem; }
    h1 { font-size: 2.125rem; }

    .hero__list {
      height: auto;
      margin-top: 2rem;
      gap: 1.1rem;
      align-content: initial;
      font-size: 0.7rem;
      line-height: 1.4;
    }

    .hero__list li { max-width: 36rem; white-space: normal; }

    .hero__visual {
      position: relative;
      inset: auto;
      grid-area: visual;
    }

    .hero__shirt {
      top: -1.5rem;
      left: 50%;
      width: min(60vw, 31.25rem);
      transform: translateX(-50%);
    }

    .hero__cap {
      top: 11rem;
      left: 66%;
      width: min(28vw, 15.625rem);
    }

    .hero__hoodie {
      top: 17rem;
      left: 82%;
      width: min(18vw, 10rem);
    }

    .hero__actions {
      position: relative;
      bottom: auto;
      left: auto;
      width: min(100%, 37.875rem);
      grid-area: actions;
      margin-inline: auto;
      transform: none;
    }

    .hero__actions .button { font-size: 0.75rem; }
  }

  @media (min-width: 40.0625rem) and (max-width: 80rem) {
    .hero {
      height: 57.3125rem;
      min-height: 57.3125rem;
    }

    .hero__grid {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      padding: 0;
      display: block;
    }

    .hero__intro {
      position: absolute;
      top: 5.5rem;
      left: 0;
      width: 56%;
      height: 43.75rem;
      display: grid;
      grid-template-columns: 5.5rem minmax(0, 1fr);
      grid-template-rows: 33.75rem 8.625rem;
      column-gap: 0.5rem;
      row-gap: 1.375rem;
    }

    .hero__rail {
      width: 5.5rem;
      height: 33.75rem;
      font-size: 4rem;
    }

    h1 {
      align-self: end;
      font-size: 3rem;
      line-height: 1.25;
    }

    .hero__list {
      width: min(34rem, calc(100vw - 2.75rem));
      margin-left: 1.375rem;
      font-size: 0.875rem;
      line-height: 1.25;
    }

    .hero__visual {
      position: absolute;
      inset: 0;
    }

    .hero__visual .hero__shirt {
      top: 6.5rem;
      left: calc(50% + 3.75rem);
      width: 24.75rem;
      height: 29.0625rem;
      object-fit: cover;
      object-position: center;
      transform: translateX(-50%);
    }

    .hero__hoodie {
      top: 25.125rem;
      right: 2.0625rem;
      left: auto;
      width: 13.0625rem;
      height: 16.5rem;
      object-fit: cover;
    }

    .hero__cap { display: none; }

    .hero__actions {
      position: absolute;
      right: 15.2344%;
      bottom: 1.8125rem;
      left: auto;
      width: 59.1797%;
      margin: 0;
      display: flex;
      transform: none;
    }
  }

  @media (max-width: 40rem) {

    .hero__ticker {
      inset: 0.625rem 0 auto;
      font-size: 0.875rem;
      line-height: normal;
    }

    .hero__ticker-group {
      padding-right: 3.75rem;
      gap: 3.75rem;
    }

    .hero__grid {
      width: calc(100% - 1.5rem);
      min-height: 47.625rem;
      margin: 3.25rem auto 0;
      padding: 0;
      grid-template-columns: 2.0625rem minmax(0, 1fr);
      grid-template-rows: 26.3125rem 12.9375rem 8.375rem;
      grid-template-areas: none;
      gap: 0;
    }

    .hero__intro { display: contents; }

    .hero__rail {
      z-index: 3;
      grid-column: 1;
      grid-row: 1;
      width: 1.75rem;
      height: 18.75rem;
      margin-top: 7.5625rem;
      align-self: start;
      font-size: 2.5rem;
      white-space: nowrap;
    }

    h1 {
      z-index: 3;
      grid-column: 2;
      grid-row: 1;
      align-self: end;
      font-size: 1.5rem;
      line-height: 1.08;
    }

    .hero__list {
      z-index: 3;
      grid-column: 1 / -1;
      grid-row: 2;
      height: auto;
      margin-top: 2.125rem;
      align-self: start;
      gap: 1.125rem;
      font-size: 0.75rem;
      letter-spacing: 0.1125rem;
      line-height: 1.4;
    }

    .hero__list li {
      min-height: 1.625rem;
      padding: 0.25rem 0.5rem;
    }

    .hero__list li::before {
      height: calc(100% + 0.5rem);
      margin: -0.25rem 0.5rem -0.25rem -0.5rem;
    }

    .hero__visual {
      position: relative;
      inset: auto;
      z-index: 1;
      grid-area: auto;
      grid-column: 1 / -1;
      grid-row: 1;
      overflow: hidden;
    }

    .hero__visual .hero__shirt {
      top: 2.1875rem;
      left: 50%;
      width: 15.125rem;
      height: 20.75rem;
      object-fit: cover;
      object-position: center;
      transform: translateX(-50%);
    }

    .hero__cap,
    .hero__hoodie { display: none; }

    .hero__actions {
      position: relative;
      inset: auto;
      grid-area: auto;
      grid-column: 1 / -1;
      grid-row: 3;
      align-self: end;
      justify-self: center;
      width: min(100%, 16.0625rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      transform: none;
    }

    .hero__actions .button {
      width: 100%;
      min-height: 3.4375rem;
      font-size: 0.875rem;
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__ticker-track {
      animation: none;
    }
  }
</style>
