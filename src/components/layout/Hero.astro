---
import hoodie from "../../assets/images/Gemini_Generated_Image_idmhueidmhueidmh-removebg-preview 2.png";
import shirt from "../../assets/images/Untitled - 22 de julio de 2026 a las 20.54.55 3.png";
---

<section id="inicio" class="hero section-grid">
  <div class="section-rail section-rail--magenta" aria-hidden="true">
    Estampamos
  </div>

  <div class="hero__content">
    <p class="kicker">Diseño · personalización · impresión</p>
    <h1>Tu marca<br />idea y<br />negocio</h1>
    <ul class="hero__list">
      <li>Diseño y asesoramiento</li>
      <li>Productos para tu marca</li>
      <li>Producción integral</li>
    </ul>
    <div class="hero__actions">
      <a class="button button--primary" href="#impresiones"
        >Nuestros productos</a
      >
      <a class="button" href="#trabajos">Ver trabajos realizados</a>
    </div>
  </div>

  <div class="hero__visual">
    <img
      class="hero__shirt"
      src={shirt.src}
      width={shirt.width}
      height={shirt.height}
      alt="Remera negra estampada con el logo de Química Estampados"
    />
    <img
      class="hero__hoodie"
      src={hoodie.src}
      width={hoodie.width}
      height={hoodie.height}
      alt="Buzo negro estampado con el logo de Química Estampados"
    />
  </div>
</section>

<style>
  .hero {
    min-height: clamp(700px, 50vw, 930px);
    padding-block: clamp(48px, 5vw, 92px) 70px;
    align-items: center;
    isolation: isolate;
  }

  .hero::before {
    content: "ESTAMPAMOS TU\A MARCA IDEA Y\A NEGOCIO";
    position: absolute;
    inset: 2% 0 auto 7%;
    z-index: -1;
    color: rgba(255, 255, 255, 0.021);
    font-family: var(--font-display);
    font-size: clamp(7rem, 12.2vw, 14.5rem);
    font-weight: 900;
    line-height: 0.71;
    letter-spacing: -0.045em;
    white-space: pre;
  }

  .hero__content {
    grid-column: content-start / span 5;
    align-self: center;
    padding-left: clamp(24px, 3.2vw, 58px);
    transform: translateY(3%);
  }

  .kicker {
    margin-bottom: 1.2rem;
  }

  h1 {
    max-width: 530px;
    font-family: var(--font-display);
    font-size: clamp(4.2rem, 6.7vw, 8rem);
    font-weight: 900;
    line-height: 0.73;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .hero__list {
    margin-top: 2.4rem;
    display: grid;
    gap: 0.72rem;
    color: #a2a2a2;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .hero__list li::before {
    content: "";
    display: inline-block;
    width: 3px;
    height: 0.82em;
    margin-right: 0.8rem;
    background: var(--color-cyan);
  }

  .hero__list li:nth-child(2)::before {
    background: var(--color-magenta);
  }
  .hero__list li:nth-child(3)::before {
    background: var(--color-yellow);
  }

  .hero__actions {
    margin-top: 2.4rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .hero__visual {
    grid-column: 6 / content-end;
    align-self: stretch;
    position: relative;
    min-height: 580px;
  }

  .hero__visual img {
    position: absolute;
    object-fit: contain;
    filter: drop-shadow(0 42px 28px rgba(0, 0, 0, 0.82));
  }

  .hero__shirt {
    width: min(57%, 590px);
    left: 7%;
    top: 0;
    z-index: 2;
  }
  .hero__hoodie {
    width: min(36%, 380px);
    right: 1%;
    bottom: 3%;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 700px;
    }
    .hero__content {
      grid-column: content-start / span 6;
      padding-left: 1rem;
    }
    .hero__visual {
      grid-column: 6 / content-end;
      min-height: 500px;
    }
    .hero__shirt {
      width: 70%;
      left: 4%;
      top: 2%;
    }
    .hero__hoodie {
      width: 47%;
      right: -2%;
      bottom: 4%;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 660px;
      padding-block: 26px 48px;
      align-items: start;
    }
    .hero::before {
      inset: 12% 0 auto 9%;
      font-size: 5.2rem;
      line-height: 0.7;
    }
    .hero__content {
      grid-column: content-start / span 8;
      align-self: end;
      padding: 0 0 1rem 0.4rem;
      transform: none;
      z-index: 3;
    }
    h1 {
      font-size: clamp(3rem, 15.7vw, 4.05rem);
      line-height: 0.72;
    }
    .kicker {
      max-width: 135px;
      margin-bottom: 0.7rem;
      font-size: 0.46rem;
    }
    .hero__list {
      margin-top: 1.35rem;
      gap: 0.45rem;
      font-size: 0.48rem;
    }
    .hero__actions {
      max-width: 212px;
      margin-top: 1.35rem;
      flex-direction: column;
      gap: 0.55rem;
    }
    .hero__actions .button {
      min-height: 36px;
      padding: 0.7rem 0.8rem;
    }
    .hero__visual {
      position: absolute;
      width: 62%;
      min-height: 350px;
      top: 21px;
      right: -2px;
    }
    .hero__shirt {
      width: 78%;
      left: -2%;
      top: 0;
    }
    .hero__hoodie {
      width: 49%;
      right: -3%;
      bottom: 5%;
    }
  }
</style>
