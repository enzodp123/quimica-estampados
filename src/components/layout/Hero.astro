---
import hoodie from "../../assets/images/Gemini_Generated_Image_idmhueidmhueidmh-removebg-preview 2.png";
import shirt from "../../assets/images/Untitled - 22 de julio de 2026 a las 20.54.55 3.png";
import BackgroundText from "../shared/BackgroundText.astro";

const tickerItems = Array(7).fill("Dale vida a tu marca");
---

<section id="inicio" class="hero">
  <BackgroundText />
  <div class="hero__ticker" aria-hidden="true">
    <div class="hero__ticker-track">
      <div class="hero__ticker-group">
        {tickerItems.map((item) => <span>{item}</span>)}
      </div>
      <div class="hero__ticker-group">
        {tickerItems.map((item) => <span>{item}</span>)}
      </div>
    </div>
  </div>

  <div class="section-rail section-rail--magenta" aria-hidden="true">
    Estampamos
  </div>

  <div class="hero__content">
    <h1>
      <span>Tu</span>
      <span>Marca</span>
      <span>Idea y</span>
      <span>Negocio</span>
    </h1>

    <ul class="hero__list">
      <li>Diseño y personalización de productos para tu marca</li>
      <li>Estampados textiles · DTF · Sublimación</li>
      <li>100% algodón premium</li>
    </ul>
  </div>

  <div class="hero__visual" aria-hidden="true">
    <img
      class="hero__shirt"
      src={shirt.src}
      width={shirt.width}
      height={shirt.height}
      alt=""
      fetchpriority="high"
    />
    <img
      class="hero__hoodie"
      src={hoodie.src}
      width={hoodie.width}
      height={hoodie.height}
      alt=""
      fetchpriority="high"
    />
  </div>

  <div class="hero__actions">
    <a class="button button--primary" href="#contacto">Solicitar presupuesto</a>
    <a class="button" href="#trabajos">Ver trabajos realizados</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: max(760px, 100svh);
    overflow: hidden;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__ticker {
    position: absolute;
    inset: 11px 0 auto;
    z-index: 4;
    overflow: hidden;
    color: #666;
    font-family: var(--font-jetbrains-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero__ticker-track {
    width: max-content;
    display: flex;
    align-items: center;
    animation: ticker-scroll 30s linear infinite;
    will-change: transform;
  }

  .hero__ticker-group {
    width: max-content;
    flex: 0 0 auto;
    padding-right: 7rem;
    display: flex;
    align-items: center;
    gap: 7rem;
  }

  @keyframes ticker-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .section-rail {
    position: absolute;
    top: 10%;
    left: var(--editorial-rail-left);
    z-index: 4;
    padding: 0;
    font-family: var(--font-montserrat);
    font-size: var(--vertical-title-font-size);
    font-weight: var(--vertical-title-font-weight);
    letter-spacing: -0.045em;
  }

  .hero__content {
    position: absolute;
    top: 40.25%;
    left: var(--editorial-title-left);
    z-index: 4;
  }

  h1 {
    color: #f7f7f5;
    font-family: var(--font-montserrat);
    font-size: 4rem;
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  h1 span {
    display: block;
  }

  .hero__list {
    margin-top: 3.25rem;
    margin-left: -4.45rem;
    display: grid;
    gap: 1.75rem;
    color: #c2c2c2;
    font-family: var(--font-jetbrains-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.095em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .hero__list li {
    display: flex;
    align-items: center;
    white-space: nowrap;
  }

  .hero__list li::before {
    content: "";
    flex: 0 0 auto;
    width: 2px;
    height: 1.8em;
    margin-right: 0.5rem;
    background: var(--color-cyan);
  }

  .hero__list li:nth-child(2)::before {
    background: var(--color-magenta);
  }

  .hero__list li:nth-child(3)::before {
    background: var(--color-yellow);
  }

  .hero__visual {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .hero__visual img {
    position: absolute;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 34px 24px rgba(0, 0, 0, 0.78));
  }

  .hero__shirt {
    top: 6.1%;
    left: 46.4%;
    width: 39.2vw;
    z-index: 2;
  }

  .hero__hoodie {
    top: 28.2%;
    left: 81.5%;
    width: 17vw;
    z-index: 1;
  }

  .hero__actions {
    position: absolute;
    bottom: 5.3%;
    left: 50%;
    z-index: 5;
    display: flex;
    gap: 1.5rem;
    transform: translateX(-50%);
  }

  .hero__actions .button {
    width: 18.25rem;
    min-width: 18.25rem;
    min-height: 3.5rem;
    padding: 0.75rem 1.35rem;
    font-family: var(--font-jetbrains-mono);
    font-size: 0.875rem;
    letter-spacing: 0.08em;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 700px;
    }

    .section-rail {
      left: var(--editorial-rail-left);
    }

    .hero__content {
      top: 38%;
      left: 10%;
    }

    .hero__list {
      margin-top: 2.25rem;
      margin-left: 0;
      gap: 1.08rem;
    }

    .hero__shirt {
      top: 8%;
      left: 43%;
      width: min(55vw, 500px);
    }

    .hero__hoodie {
      top: 31%;
      left: 74%;
      width: min(28vw, 250px);
    }

    .hero__actions {
      bottom: 5%;
    }
  }

  @media (max-width: 640px) {
    .hero {
      min-height: 760px;
    }

    .section-rail {
      top: 8%;
      left: 18px;
      font-size: var(--vertical-title-font-size);
    }

    .hero__content {
      top: 40%;
      left: 56px;
    }

    h1 {
      font-size: 3.5rem;
    }

    .hero__list {
      max-width: calc(100vw - 72px);
      margin-top: 1.5rem;
      gap: 0.72rem;
      font-size: 0.75rem;
    }

    .hero__list li {
      white-space: normal;
    }

    .hero__shirt {
      top: 4%;
      left: 22%;
      width: 78vw;
      opacity: 0.72;
    }

    .hero__hoodie {
      top: 18%;
      left: 62%;
      width: 43vw;
      opacity: 0.82;
    }

    .hero__actions {
      right: auto;
      bottom: 32px;
      left: 56px;
      width: 220px;
      flex-direction: column;
      gap: 0.55rem;
      transform: none;
    }

    .hero__actions .button {
      width: 100%;
      min-width: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__ticker-track {
      animation: none;
    }
  }
</style>
