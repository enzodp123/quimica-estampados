---
import { Image } from "astro:assets";
import mainHoodie from "../../assets/images/buzo_capucha.png";
import smallHoodie from "../../assets/images/Gemini_Generated_Image_idmhueidmhueidmh-removebg-preview 2.png";
import cap from "../../assets/images/gorra_hero.png";
import BackgroundText from "../shared/BackgroundText.astro";

const tickerItems = Array(7).fill("Dale vida a tu marca");
---

<section id="inicio" class="hero">
  <BackgroundText />

  <div class="hero__ticker" aria-hidden="true">
    <div class="hero__ticker-track">
      <div class="hero__ticker-group">
        {tickerItems.map((item) => <span>{item}</span>)}
      </div>
      <div class="hero__ticker-group">
        {tickerItems.map((item) => <span>{item}</span>)}
      </div>
    </div>
  </div>

  <div class="hero__grid">
    <div class="hero__intro">
      <p class="hero__rail" aria-hidden="true">Creamos</p>

      <h1>
        <span class="visually-hidden">Creamos </span>
        <span>Lo</span>
        <span>que tu</span>
        <span>marca</span>
        <span>necesita</span>
      </h1>

      <ul class="hero__list">
        <li>Diseño y personalización de productos para tu marca</li>
        <li>Estampados textiles • DTF • Sublimación</li>
        <li>100% algodón premium</li>
      </ul>
    </div>

    <div class="hero__visual" aria-hidden="true">
      <Image
        class="hero__shirt"
        src={mainHoodie}
        alt=""
        loading="eager"
        fetchpriority="high"
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 40rem) 82vw, (max-width: 64rem) 60vw, 32vw"
      />
      <Image
        class="hero__hoodie"
        src={smallHoodie}
        alt=""
        loading="eager"
        widths={[160, 240, 320, 480]}
        sizes="(max-width: 40rem) 28vw, (max-width: 64rem) 18vw, 13vw"
      />
      <Image
        class="hero__cap"
        src={cap}
        alt=""
        loading="eager"
        widths={[240, 360, 480, 640, 800]}
        sizes="(max-width: 40rem) 42vw, (max-width: 64rem) 28vw, 18vw"
      />
    </div>

    <div class="hero__actions">
      <a class="button button--primary" href="#contacto">Solicitar presupuesto</a>
      <a class="button" href="#trabajos">Ver trabajos realizados</a>
    </div>
  </div>
</section>

<style>
  .hero {
    --background-text-inset: clamp(3.5rem, 4.43vw, 5.3125rem) -5%
      clamp(3.4rem, 4.32vw, 5.1875rem) clamp(2rem, 3.6vw, 4.3125rem);

    position: relative;
    isolation: isolate;
    width: 100%;
    height: clamp(42rem, 46.875vw, 56.25rem);
    min-height: clamp(42rem, 46.875vw, 56.25rem);
    overflow: hidden;
    background: var(--color-background);
    border-bottom: 1px solid var(--color-border);
  }

  .hero__ticker {
    position: absolute;
    inset: 11px 0 auto;
    z-index: 4;
    overflow: hidden;
    color: rgba(255, 255, 255, 0.4);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 1px;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .hero__ticker-track {
    width: max-content;
    display: flex;
    align-items: center;
    animation: ticker-scroll 70s linear infinite;
    will-change: transform;
  }

  .hero__ticker-group {
    width: max-content;
    flex: 0 0 auto;
    padding-right: 60px;
    display: flex;
    align-items: center;
    gap: 60px;
  }

  @keyframes ticker-scroll {
    to {
      transform: translateX(-50%);
    }
  }

  .hero__grid {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
  }

  .hero__intro {
    position: absolute;
    top: 25%;
    left: 4.3229%;
    width: 30.2604%;
    height: 65.8889%;
    display: grid;
    grid-template-columns: clamp(2.5rem, 2.9167vw, 3.5rem) minmax(0, 1fr);
    grid-template-rows: 67.6667% 23%;
    align-items: end;
    column-gap: clamp(0.7rem, 1.1458vw, 1.375rem);
    row-gap: 8.1667%;
  }

  .hero__rail {
    grid-column: 1;
    grid-row: 1;
    color: var(--color-magenta);
    font-family: var(--font-montserrat);
    height: 100%;
    font-size: clamp(3rem, 3.75vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  h1 {
    grid-column: 2;
    grid-row: 1;
    color: #ffffff;
    font-family: var(--font-montserrat);
    font-size: clamp(1.9rem, 2.3438vw, 2.8125rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.095;
    text-transform: uppercase;
  }

  h1 span {
    display: block;
  }

  .hero__list {
    grid-column: 1 / -1;
    grid-row: 2;
    min-width: 0;
    height: 100%;
    margin-top: 0;
    display: grid;
    align-content: space-between;
    color: #ffffff;
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.65rem, 0.7292vw, 0.875rem);
    font-weight: 700;
    letter-spacing: 1.8px;
    line-height: 1;
    text-transform: uppercase;
  }

  .hero__list li {
    min-width: 0;
    display: flex;
    align-items: center;
  }

  .hero__list li::before {
    content: "";
    width: 2px;
    height: 26px;
    margin-right: 10px;
    flex: 0 0 auto;
    background: var(--color-cyan);
  }

  .hero__list li:nth-child(2)::before {
    background: var(--color-magenta);
  }

  .hero__list li:nth-child(3)::before {
    background: var(--color-yellow);
  }

  .hero__visual {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .hero__visual img {
    position: absolute;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 34px 24px rgba(0, 0, 0, 0.72));
  }

  .hero__shirt {
    z-index: 2;
    top: 16%;
    left: 34.0625%;
    width: 31.875%;
  }

  .hero__hoodie {
    z-index: 1;
    top: 56.1111%;
    left: 84.9479%;
    width: 12.7083%;
  }

  .hero__cap {
    z-index: 3;
    top: 43.4444%;
    left: 64.5833%;
    width: 17.8125%;
  }

  .hero__actions {
    position: absolute;
    bottom: clamp(1rem, 1.0938vw, 1.3125rem);
    left: 50%;
    z-index: 3;
    width: min(31.5625%, 606px);
    display: flex;
    gap: clamp(0.85rem, 1.25vw, 1.5rem);
    transform: translateX(-50%);
  }

  .hero__actions .button {
    position: relative;
    width: calc((100% - clamp(0.85rem, 1.25vw, 1.5rem)) / 2);
    min-width: 0;
    min-height: clamp(2.75rem, 2.8646vw, 3.4375rem);
    padding: 0.65rem 0.75rem;
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.625rem, 0.7292vw, 0.875rem);
    letter-spacing: 1.4px;
    white-space: nowrap;
  }

  .hero__actions .button::before,
  .hero__actions .button::after {
    content: "";
    position: absolute;
    height: 2px;
    background: var(--color-background);
    pointer-events: none;
  }

  .hero__actions .button::before {
    top: -1px;
    left: 11px;
    width: 25px;
  }

  .hero__actions .button::after {
    right: 11px;
    bottom: -1px;
    width: 45px;
    background: linear-gradient(
      90deg,
      var(--color-background) 0 25px,
      transparent 25px 35px,
      var(--color-background) 35px 45px
    );
  }

  @media (max-width: 64rem) {
    .hero {
      --background-text-inset: 3.5rem -28% 2rem 1.5rem;
      height: auto;
      min-height: 0;
    }

    .hero__ticker { font-size: 0.625rem; }
    .hero__ticker-group { padding-right: 2.5rem; gap: 2.5rem; }

    .hero__grid {
      position: relative;
      inset: auto;
      height: auto;
      padding: 4.75rem clamp(1.25rem, 5vw, 3rem) 2rem;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto clamp(28rem, 55vw, 36rem) auto;
      grid-template-areas: "intro" "visual" "actions";
      gap: 2rem;
    }

    .hero__intro {
      position: relative;
      top: auto;
      left: auto;
      width: min(100%, 38rem);
      height: auto;
      grid-area: intro;
      grid-template-columns: 3.25rem minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 0.9rem;
      row-gap: 0;
      justify-self: start;
    }

    .hero__rail { height: auto; font-size: 3.25rem; }
    h1 { font-size: 2.125rem; }

    .hero__list {
      height: auto;
      margin-top: 2rem;
      gap: 1.1rem;
      align-content: initial;
      font-size: 0.7rem;
      line-height: 1.4;
    }

    .hero__list li { max-width: 36rem; white-space: normal; }

    .hero__visual {
      position: relative;
      inset: auto;
      grid-area: visual;
    }

    .hero__shirt {
      top: -1.5rem;
      left: 50%;
      width: min(60vw, 31.25rem);
      transform: translateX(-50%);
    }

    .hero__cap {
      top: 11rem;
      left: 66%;
      width: min(28vw, 15.625rem);
    }

    .hero__hoodie {
      top: 17rem;
      left: 82%;
      width: min(18vw, 10rem);
    }

    .hero__actions {
      position: relative;
      bottom: auto;
      left: auto;
      width: min(100%, 37.875rem);
      grid-area: actions;
      margin-inline: auto;
      transform: none;
    }

    .hero__actions .button { font-size: 0.75rem; }
  }

  @media (max-width: 40rem) {
    .hero { --background-text-inset: 3.2rem -55% 1rem 0.75rem; }
    .hero__ticker { font-size: 0.55rem; }
    .hero__ticker-group { padding-right: 3rem; gap: 3rem; }

    .hero__grid {
      padding: 3.75rem 1rem 1.5rem;
      grid-template-rows: auto clamp(18rem, 80vw, 24rem) auto;
      gap: 1.5rem;
    }

    .hero__intro { width: 100%; grid-template-columns: 2.5rem minmax(0, 1fr); column-gap: 0.65rem; }
    .hero__rail { font-size: clamp(2.25rem, 10vw, 3rem); }
    h1 { font-size: clamp(1.45rem, 7vw, 2rem); line-height: 1.08; }

    .hero__list {
      margin-top: 1.5rem;
      gap: 0.85rem;
      font-size: clamp(0.58rem, 2.45vw, 0.7rem);
      letter-spacing: 0.08em;
      line-height: 1.45;
    }

    .hero__list li::before { height: 1.8em; margin-right: 0.5rem; }
    .hero__shirt { top: -1.25rem; width: min(82vw, 21.25rem); }
    .hero__cap { top: 42%; left: 58%; width: min(42vw, 11.5rem); }
    .hero__hoodie { top: 60%; left: 79%; width: min(28vw, 8.5rem); }

    .hero__actions {
      width: min(100%, 22rem);
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }

    .hero__actions .button {
      width: 100%;
      min-height: 2.75rem;
      font-size: 0.58rem;
      white-space: normal;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__ticker-track {
      animation: none;
    }
  }
</style>
