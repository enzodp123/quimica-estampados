---
import logo from "../../assets/icons/logo-quimica.svg";
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <img src={logo.src} width="48" height="48" alt="" />
      <h2>Qu&iacute;mica Estampados</h2>
      <p>
        Dise&ntilde;o, estampado y producci&oacute;n para marcas que quieren
        dejar huella.
      </p>
      <div class="color-dots" aria-hidden="true"><i></i><i></i><i></i></div>
    </div>
    <div>
      <h3>Navegaci&oacute;n</h3><a href="#impresiones">Impresiones</a><a
        href="#servicios">Servicios</a
      ><a href="#trabajos">Trabajos</a>
    </div>
    <div>
      <h3>Ayuda</h3><a href="#contacto">Contacto</a><a href="#preguntas"
        >Preguntas frecuentes</a
      ><a href="#nosotros">Nosotros</a>
    </div>
    <div>
      <h3>Seguinos</h3><a href="#">Instagram</a><a href="#">Facebook</a><a
        href="#">WhatsApp</a>
    </div>
  </div>
  <div class="container footer__bottom">
    <span>&copy; {new Date().getFullYear()} Qu&iacute;mica Estampados</span
    ><span>Victoria &middot; Entre R&iacute;os &middot; Argentina</span>
  </div>
</footer>

<style>
  .footer {
    padding: 4.5rem 0 1.5rem;
    background: #050505;
    border-top: 1px solid var(--color-border);
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 2fr repeat(3, 1fr);
    gap: 3rem;
  }
  .footer__brand h2 {
    margin-top: 1rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .footer__brand p {
    max-width: 350px;
    margin-top: 0.6rem;
    color: #777;
    font-size: 0.68rem;
  }
  .footer h3 {
    margin-bottom: 1rem;
    color: var(--color-magenta);
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .footer a {
    margin-bottom: 0.65rem;
    display: block;
    color: #777;
    font-size: 0.65rem;
  }
  .footer a:hover {
    color: #fff;
  }
  .color-dots {
    margin-top: 1rem;
    display: flex;
    gap: 4px;
  }
  .color-dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-cyan);
  }
  .color-dots i:nth-child(2) {
    background: var(--color-magenta);
  }
  .color-dots i:nth-child(3) {
    background: var(--color-yellow);
  }
  .footer__bottom {
    margin-top: 3rem;
    padding-top: 1.2rem;
    display: flex;
    justify-content: space-between;
    color: #3f3f3f;
    font-size: 0.53rem;
    letter-spacing: 0.12em;
    border-top: 1px solid var(--color-border);
    text-transform: uppercase;
  }
  @media (max-width: 640px) {
    .footer {
      padding-top: 3.5rem;
    }
    .footer__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1rem;
    }
    .footer__brand {
      grid-column: 1 / -1;
    }
    .footer__bottom {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
