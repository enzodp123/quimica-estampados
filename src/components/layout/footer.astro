---
import logo from "../../assets/icons/logo-quimica.svg";
import { siteConfig } from "../../data/site";

const year = new Date().getFullYear();
---

<footer class="footer" data-figma-node="1031:2067">
  <div class="footer__grid">
    <div class="footer__brand">
      <img src={logo.src} width="76" height="76" alt="Química Estampados" />
      <h2>Química Estampados</h2>
      <p>
        Estudio creativo <strong>especializado</strong> en estampados<br />
        <strong>personalizados</strong>, branding y <strong>soluciones gráficas</strong>.
      </p>
      <div class="footer__dots" aria-hidden="true"><i></i><i></i><i></i></div>
    </div>

    <nav class="footer__column" aria-label="Servicios">
      <h3>Servicios</h3>
      <a href="/#servicios">Sublimación</a>
      <a href="/#servicios">DTF</a>
      <a href="/productos/calcos-papel/">Calcos</a>
      <a href="/#servicios">Corpóreos</a>
    </nav>

    <nav class="footer__column" aria-label="Empresa">
      <h3>Empresa</h3>
      <a href="/#nosotros">Nosotros</a>
      <a href="/#trabajos">Proyectos</a>
      <a href="/#contacto">Contacto</a>
    </nav>

    <div class="footer__column footer__contact">
      <h3>Contacto</h3>
      {siteConfig.social.instagram ? (
        <a href={siteConfig.social.instagram} target="_blank" rel="noreferrer" aria-label="Instagram">
          <span>Instagram</span><span class="footer__arrow" aria-hidden="true">›</span>
        </a>
      ) : (
        <span class="footer__placeholder" title="Enlace pendiente de configurar">
          <span>Instagram</span><span class="footer__arrow" aria-hidden="true">›</span>
        </span>
      )}
      {siteConfig.social.facebook ? (
        <a href={siteConfig.social.facebook} target="_blank" rel="noreferrer" aria-label="Facebook">
          <span>Facebook</span><span class="footer__arrow" aria-hidden="true">›</span>
        </a>
      ) : (
        <span class="footer__placeholder" title="Enlace pendiente de configurar">
          <span>Facebook</span><span class="footer__arrow" aria-hidden="true">›</span>
        </span>
      )}
      <a href={`mailto:${siteConfig.email}`}>
        <span>{siteConfig.email}</span><span class="footer__arrow" aria-hidden="true">›</span>
      </a>
    </div>
  </div>

  <div class="footer__bottom" data-figma-node="1031:2128">
    <p><strong>© {year} Química Estampados.</strong> Todos los derechos reservados.</p>
    <p>
      Desarrollado por
      {siteConfig.developer.url ? (
        <a href={siteConfig.developer.url} target="_blank" rel="noreferrer">{siteConfig.developer.label}</a>
      ) : (
        <span>{siteConfig.developer.label}</span>
      )}
    </p>
  </div>
</footer>

<style>
  .footer {
    height: 24.104375rem;
    min-height: 24.104375rem;
    padding-top: 1.8125rem;
    background: var(--color-background);
    border-top: 0.0625rem solid var(--color-border);
  }

  .footer__grid { width: calc(100% - 12.5rem); margin-inline: auto; }

  .footer__grid {
    height: 16.416875rem;
    display: grid;
    grid-template-columns: 35.6977% 22.9069% 19.5349% 21.8605%;
    gap: 0;
    align-items: center;
  }

  .footer__brand { align-self: start; }
  .footer__column { align-self: start; margin-top: 2.0209375rem; }
  .footer__grid > .footer__column:first-of-type { padding-left: 3.625rem; }

  .footer__brand img {
    width: clamp(3.5rem, 4vw, 4.75rem);
    height: clamp(3.5rem, 4vw, 4.75rem);
  }

  .footer__brand h2 {
    margin-top: clamp(0.75rem, 0.9vw, 1.05rem);
    color: #f0f0ed;
    font-family: var(--font-montserrat);
    font-size: clamp(1rem, 1.25vw, 1.5rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    line-height: 1.2083;
    text-transform: uppercase;
  }

  .footer__brand > p {
    max-width: 34rem;
    margin-top: clamp(0.7rem, 0.8vw, 0.95rem);
    color: #d0d0cd;
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.75rem, 0.7292vw, 0.875rem);
    letter-spacing: 0.035em;
    line-height: 1.5;
  }

  .footer__brand strong {
    color: var(--color-magenta);
    font-weight: 700;
  }

  .footer__dots {
    margin-top: clamp(0.85rem, 1vw, 1.15rem);
    display: flex;
    gap: 0.3rem;
  }

  .footer__dots i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-cyan);
  }

  .footer__dots i:nth-child(2) { background: var(--color-magenta); }
  .footer__dots i:nth-child(3) { background: var(--color-yellow); }

  .footer__column h3 {
    margin-bottom: clamp(1.1rem, 1.25vw, 1.5rem);
    color: var(--color-magenta);
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.75rem, 0.8333vw, 1rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.625;
    text-transform: uppercase;
  }

  .footer__column > a,
  .footer__column > .footer__placeholder {
    margin-bottom: clamp(0.65rem, 0.72vw, 0.86rem);
    display: block;
    color: #d0d0cd;
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.75rem, 0.7292vw, 0.875rem);
    letter-spacing: 0;
    line-height: 1.2857;
    text-transform: uppercase;
    transition: color var(--transition), border-color var(--transition);
  }

  .footer__column > a:hover,
  .footer__column > a:focus-visible {
    color: #ffffff;
  }

  .footer__column > .footer__placeholder { color: #777774; }

  .footer__contact > a,
  .footer__contact > .footer__placeholder {
    min-height: clamp(2rem, 2.05vw, 2.45rem);
    margin-bottom: clamp(0.45rem, 0.52vw, 0.62rem);
    padding: 0 clamp(0.65rem, 0.72vw, 0.86rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    background: rgba(19, 19, 19, 0.5);
    border: 0.0625rem solid #353534;
    backdrop-filter: blur(2px);
    font-size: clamp(0.6875rem, 0.625vw, 0.75rem);
    letter-spacing: 0.1em;
    line-height: 1.3333;
  }

  .footer__arrow {
    flex: 0 0 auto;
    color: #f0f0ed;
    font-size: 1rem;
    line-height: 1;
  }

  .footer__bottom {
    width: 100%;
    height: 4.125rem;
    margin: 1.75rem 0 0;
    padding: 1.5625rem 3rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    color: #626260;
    border-top: 0.0625rem solid var(--color-border);
    font-family: var(--font-montserrat);
    font-size: clamp(0.75rem, 0.7292vw, 0.875rem);
    font-weight: 400;
    line-height: 1.2143;
  }

  .footer__bottom strong,
  .footer__bottom a,
  .footer__bottom span {
    color: var(--color-magenta);
    font-weight: 400;
  }

  @media (min-width: 64.0625rem) {
    .footer__brand img { width: 5rem; height: 5rem; }
    .footer__brand h2 { margin-top: 1.5rem; }
    .footer__brand > p { max-width: 35.6875rem; margin-top: 1.5rem; font-size: 1rem; }
    .footer__dots { margin-top: 1.5rem; }
    .footer__dots i { width: 0.875rem; height: 0.875rem; }
  }

  @media (min-width: 40.0625rem) and (max-width: 110rem) {
    .footer {
      width: calc(100% - 3rem);
      min-height: 38.875rem;
      margin-inline: auto;
      padding-top: 3.0625rem;
    }

    .footer__grid,
    .footer__bottom { width: 100%; }

    .footer__grid {
      height: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.5rem 0;
    }

    .footer__column { margin-top: 0; }
    .footer__grid > .footer__column:first-of-type { padding-left: 0; }

    .footer__brand { grid-column: 1 / -1; }
    .footer__brand img { width: 5rem; height: 5rem; }
    .footer__brand h2 { margin-top: 1.5rem; font-size: 1.5rem; }
    .footer__brand > p { max-width: 35.6875rem; margin-top: 1.5rem; font-size: 1rem; }
    .footer__brand > p br { display: none; }
    .footer__dots { margin-top: 1.5rem; }
    .footer__dots i { width: 0.875rem; height: 0.875rem; }
    .footer__column h3 { margin-bottom: 1.25rem; font-size: 1rem; }
    .footer__column > a,
    .footer__column > .footer__placeholder { margin-bottom: 0.625rem; font-size: 0.875rem; }
    .footer__contact > a,
    .footer__contact > .footer__placeholder { min-height: 2.5rem; font-size: 0.75rem; }

    .footer__bottom {
      margin-top: 1.5rem;
      min-height: 4.125rem;
      padding: 1.5rem 0;
      font-size: 0.875rem;
    }
  }

  @media (max-width: 40rem) {
    .footer {
      width: calc(100% - 1.5rem);
      min-height: 60.875rem;
      margin-inline: auto;
      padding: 1.8125rem 0 0;
      background: var(--color-background);
    }

    .footer__grid,
    .footer__bottom {
      width: calc(100% - 1.5rem);
    }

    .footer__grid {
      height: auto;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .footer__column { margin-top: 0; }
    .footer__grid > .footer__column:first-of-type { padding-left: 0; }

    .footer__brand,
    .footer__contact {
      grid-column: auto;
    }

    .footer__brand img {
      width: 5rem;
      height: 5rem;
    }

    .footer__brand h2 {
      margin-top: 1.5rem;
      font-size: 1.5rem;
      line-height: 1.2;
    }

    .footer__brand > p {
      margin-top: 1.5rem;
      font-size: 1rem;
      letter-spacing: 0;
      line-height: 1.5;
    }

    .footer__dots {
      margin-top: 1.5rem;
      gap: 0.25rem;
    }

    .footer__dots i {
      width: 0.875rem;
      height: 0.875rem;
    }

    .footer__column h3 {
      margin-bottom: 1.25rem;
      font-size: 1rem;
      line-height: 1.625;
    }

    .footer__column > a,
    .footer__column > .footer__placeholder {
      margin-bottom: 0.625rem;
      font-size: 0.875rem;
      line-height: 1.2857;
    }

    .footer__contact > a,
    .footer__contact > .footer__placeholder {
      min-height: 2.5rem;
      margin-bottom: 0.625rem;
      padding-inline: 0.8125rem 0.3125rem;
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      line-height: 1.3333;
      overflow-wrap: anywhere;
    }

    .footer__bottom {
      margin-top: 1.75rem;
      min-height: 7rem;
      padding: 1.5625rem 0 1.5rem;
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
      font-size: 0.875rem;
      line-height: 1.2143;
    }
  }
</style>
