---
import { Image } from "astro:assets";
import type { ProductCardData } from "../../data/product-cards";
import { formatCatalogPrice, getCatalogComparisonTotal, getCatalogTotal, priceCatalog, resolveCatalogPrice } from "../../data/pricing";

interface Props { card: ProductCardData; }
const { card } = Astro.props;
const { product, name, description, image, badge, consultAction } = card;
const catalog = priceCatalog[product.pricingId];
const quantities = catalog.variants.find(({ key }) => key === "quantity")?.options ?? [];
const packs = quantities.filter(({ value }) => Number(value.slice(1)) > 1)
  .sort((a, b) => Number(a.value.slice(1)) - Number(b.value.slice(1)));
const entry = !product.requiresConsultation && !consultAction && packs[0]
  ? resolveCatalogPrice(product.pricingId, { ...product.priceSelection, quantity: packs[0].value })
  : undefined;
const consultation = !getCatalogTotal(entry);
const comparisonPrice = getCatalogComparisonTotal(entry);
const hasUnitSale = !product.requiresConsultation && !!getCatalogTotal(resolveCatalogPrice(product.pricingId, {
  ...product.priceSelection, quantity: "x1",
}));
---

<a class="product-card" href={`/productos/${product.slug}/`} data-product-card={product.slug}
  aria-label={`Ver ${name}${badge ? ` ${badge.toLowerCase()}` : ""}`}>
  {badge && <span class="product-card__badge">{badge}</span>}
  <div class="product-card__visual">
    <Image class="product-card__image" src={image} alt={name} loading="lazy"
      widths={[280, 350, 525, 700]} sizes="(max-width: 40rem) 80vw, (max-width: 80rem) 18rem, 22rem" format="webp" />
  </div>
  <div class="product-card__body">
    <h3>{name}</h3>
    <p class="product-card__description">{description}</p>
    <div class="product-card__availability">
      {hasUnitSale && <p class="product-card__unit">Venta por unidad</p>}
      <p class="product-card__pack-label">{consultation ? "Consultar packs disponibles" : "Packs disponibles:"}</p>
    </div>
    {consultation ? (
      <span class="product-card__consult">Consultar producto</span>
    ) : (
      <>
        <ul class="product-card__packs" aria-label={`Packs disponibles de ${name}`}>
          {packs.map((pack) => <li>{pack.value.toUpperCase()}</li>)}
        </ul>
        <div class="product-card__price">
          <div class="product-card__price-row"><span>Pack desde</span><strong>{formatCatalogPrice(entry)}</strong></div>
          {comparisonPrice && <s class="product-card__comparison">{comparisonPrice}</s>}
        </div>
      </>
    )}
  </div>
</a>

<style>
  .product-card {
    position: relative;
    min-width: 0;
    min-height: 39.5rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    color: var(--color-text);
    background: #191919;
    border: 1px solid #1081b0;
    scroll-snap-align: start;
    font-family: "JetBrains Mono", "Courier New", monospace;
    text-transform: uppercase;
    transition: transform var(--transition), border-color var(--transition);
  }
  .product-card:hover { transform: translateY(-0.375rem); border-color: var(--color-cyan); }
  .product-card:focus-visible { outline: 2px solid var(--color-cyan); outline-offset: -3px; }
  .product-card__badge { position: absolute; top: 0.5rem; right: 0.5rem; z-index: 1; padding: 0.25rem 0.5rem; background: #191919; border: 1px solid var(--color-cyan); color: var(--color-cyan); font-size: 0.6875rem; }
  .product-card__visual { width: 100%; height: 20rem; flex-shrink: 0; }
  .product-card__image { width: 100%; height: 100%; object-fit: contain; }
  .product-card__body { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  h3 { color: var(--color-cyan); font-size: 1.25rem; font-weight: 700; line-height: 1.4; }
  .product-card__description { margin-top: 0.75rem; font-size: 0.875rem; line-height: 1.5; }
  .product-card__availability { margin-top: 1rem; font-size: 0.75rem; line-height: 1.6; }
  .product-card__unit { color: var(--color-cyan); font-size: 0.625rem; }
  .product-card__pack-label { color: #ffffffb3; }
  .product-card__packs { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .product-card__packs li { min-width: 2.5rem; min-height: 2.5rem; padding: 0.375rem; display: grid; place-items: center; border: 1px solid #353534; color: var(--color-cyan); font-size: 0.75rem; }
  .product-card__price { margin-top: auto; padding-top: 1rem; text-align: right; }
  .product-card__price-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: flex-end; gap: 0.375rem; }
  .product-card__price-row > span { font-size: 0.75rem; }
  .product-card__price strong { color: var(--color-cyan); font-size: 1.25rem; line-height: 1.4; white-space: nowrap; }
  .product-card__comparison { display: block; color: #aaa; font-size: 1rem; line-height: 1.5; }
  .product-card__consult { align-self: flex-start; margin-top: 1.5rem; padding: 0.75rem; border: 1px solid var(--color-cyan); color: var(--color-cyan); font-size: 0.875rem; }
  @media (max-width: 110rem) {
    .product-card { padding: 1.5rem; gap: 1.5rem; }
    .product-card__visual { height: 18rem; }
  }
  @media (max-width: 40rem) {
    .product-card { min-height: 34.5rem; padding: 1.5rem; gap: 2rem; }
    .product-card__visual { height: 14rem; }
    h3 { font-size: 1.125rem; }
  }
  @media (prefers-reduced-motion: reduce) { .product-card { transition: none; } .product-card:hover { transform: none; } }
</style>