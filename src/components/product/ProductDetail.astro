---
import { getImage } from "astro:assets";
import type { Product } from "../../data/products";
import { getRecommendationCards } from "../../data/product-cards";
import ProductCarousel from "./ProductCarousel.astro";
import { priceCatalog, type CatalogProduct } from "../../data/pricing";
import ProductInfo from "./ProductInfo.astro";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const isPhotoProduct = product.slug === "remera-oversize";
const catalog: CatalogProduct = priceCatalog[product.pricingId];
const gallery = await Promise.all(product.gallery.map(async (image) => ({
  main: await getImage({ src: image, width: Math.min(1200, image.width), format: "webp", quality: 82 }),
  thumb: await getImage({ src: image, width: Math.min(180, image.width), format: "webp", quality: 78 }),
})));
const heroImage = product.heroImage ? await getImage({ src: product.heroImage, width: Math.min(1200, product.heroImage.width), format: "webp", quality: 82 }) : gallery[0].main;
const relatedProducts = getRecommendationCards(product);
---

{product.ticker && (
  <aside class="product-ticker" aria-label="Dale vida a tu marca">
    <div class="product-ticker__track">
      {Array.from({ length: 9 }, () => <span>Dale vida a tu marca</span>)}
    </div>
  </aside>
)}

<main
  id="main-content"
  class:list={["product-page", `product-page--${product.slug}`]}
  data-figma-nodes={product.figmaNodes.join(",")}
>
  <section class="product-hero" aria-labelledby="product-title">
    <div class="product-gallery" data-product-gallery>
      <div class="product-gallery__thumbs" role="group" aria-label="Galería del producto">
        {gallery.map((image, index) => (
          <button
            class:list={["product-gallery__thumb", { "is-active": index === 0 }]}
            type="button"
            data-gallery-thumb
            data-src={image.main.src}
            aria-label={`Ver imagen ${index + 1} de ${product.title}`}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <img src={image.thumb.src} alt="" loading={index === 0 ? "eager" : "lazy"} />
          </button>
        ))}
      </div>

      <div class:list={["product-gallery__main", { "is-photo": isPhotoProduct }]}>
        <img
          data-gallery-main
          src={heroImage.src}
          alt={product.title}
          fetchpriority="high"
        />
      </div>
    </div>

    <ProductInfo product={product} />
  </section>

  <section class="product-description" aria-labelledby="description-heading">
    <div>
      <h2 id="description-heading">Descripción</h2>
      <p>{product.requiresConsultation ? product.description : catalog.description ?? product.description}</p>
    </div>
    {product.sizeTable && (
      <details class="size-guide">
        <summary>Guía de tamaños</summary>
        <ul>{product.sizeTable.map((row) => <li>{row}</li>)}</ul>
      </details>
    )}
  </section>

  <section class="related" aria-labelledby="related-heading">
    <div class="related__heading">
      <h2 id="related-heading">Otros productos</h2>
    </div>
    <ProductCarousel id="related-products" label="Otros productos recomendados" cards={relatedProducts} />
  </section>
</main>

<script>
  document.querySelectorAll<HTMLElement>("[data-product-gallery]").forEach((gallery) => {
    const mainImage = gallery.querySelector<HTMLImageElement>("[data-gallery-main]");
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]");
    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        if (mainImage && thumb.dataset.src) mainImage.src = thumb.dataset.src;
        thumbs.forEach((item) => {
          const active = item === thumb;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-pressed", String(active));
        });
      });
    });
  });

  document.querySelectorAll<HTMLElement>("[data-product-choice-group]").forEach((group) => {
    const choices = group.querySelectorAll<HTMLButtonElement>("[data-product-choice]");
    choices.forEach((choice) => {
      choice.addEventListener("click", () => {
        choices.forEach((item) => {
          const active = item === choice;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-pressed", String(active));
        });
      });
    });
  });

</script>

<style>
  .product-ticker { height: 2.625rem; overflow: hidden; color: #ffffff66; background: var(--color-background); font: 700 0.875rem/1.5 var(--font-poppins); letter-spacing: 0.0625rem; text-transform: uppercase; }
  .product-ticker__track { display: flex; align-items: center; justify-content: center; gap: 3.75rem; min-width: max-content; height: 100%; white-space: nowrap; }
  .product-page { padding: 4.1875rem 0 7rem; background: var(--color-background); }
  .product-hero, .product-description, .related { width: min(calc(100% - 6rem), 87.3125rem); margin-inline: auto; }
  .product-hero { display: grid; grid-template-columns: minmax(0, 1.342fr) minmax(0, 1fr); gap: 2rem; align-items: start; }
  .product-gallery { display: grid; grid-template-columns: 9.375rem minmax(0, 1fr); gap: 2rem; min-width: 0; }
  .product-gallery__thumbs { align-self: start; padding: 1.5625rem; display: flex; flex-direction: column; gap: 1.4375rem; border: 1px solid #353534; background: #13131380; min-width: 0; overflow-x: hidden; overflow-y: auto; scrollbar-width: none; }
  .product-gallery__thumbs::-webkit-scrollbar { display: none; }
  .product-gallery__thumb { max-width: 100%; width: 6.25rem; height: 6.25rem; flex: 0 0 6.25rem; padding: 0; border: 0; overflow: hidden; background: transparent; cursor: pointer; }
  .product-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }
  .product-gallery__thumb:focus-visible { outline-color: var(--color-magenta); }
  .product-gallery__main { aspect-ratio: 1; min-width: 0; overflow: hidden; background: var(--color-background); }
  .product-gallery__main img { width: 100%; height: 100%; object-fit: contain; }
  .product-gallery__main.is-photo img { object-fit: cover; }
  .product-description { margin-top: 2rem; }
  .product-description h2, .related h2 { margin: 0; border-left: 2px solid var(--color-magenta); padding-left: 1.125rem; color: var(--color-magenta); font: 400 1rem/1 var(--font-poppins); letter-spacing: 0.075rem; text-transform: uppercase; }
  .product-description > div > p { max-width: 45.25rem; margin-top: 1rem; color: #ffffffb3; font: 400 1rem/1.5 var(--font-poppins); }
  .size-guide { max-width: 45.25rem; margin-top: 1.25rem; color: #ffffffb3; font: 400 0.875rem/1.5 var(--font-poppins); }
  .size-guide summary { cursor: pointer; color: var(--color-magenta); }
  .size-guide ul { margin-top: 1rem; display: grid; gap: 0.5rem; }
  .related { margin-top: 3rem; }
  .related__heading { margin-bottom: 2.75rem; }
  .related h2 { color: var(--color-cyan); border-color: var(--color-cyan); }
  
  
  
  
  
  
  
  @media (max-width: 80rem) { .product-hero, .product-description, .related { width: calc(100% - 3rem); } .product-hero { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 1.5rem; } .product-gallery { grid-template-columns: 6.25rem minmax(0, 1fr); gap: 1.25rem; } .product-gallery__thumbs { padding: 0.75rem; gap: 1rem; } .product-gallery__thumb { width: 4.625rem; height: 4.625rem; flex-basis: 4.625rem; }   }
  @media (max-width: 56rem) { .product-hero { grid-template-columns: 1fr; gap: 2rem; } .product-gallery { width: 100%; grid-template-columns: 6.25rem minmax(0, 1fr); } .product-gallery__main { max-height: 36rem; }  }
  @media (max-width: 40rem) { .product-page { padding: 1.5rem 0 4rem; } .product-hero, .product-description, .related { width: calc(100% - 2rem); } .product-ticker { font-size: 0.7rem; } .product-gallery { display: flex; flex-direction: column-reverse; gap: 0.75rem; } .product-gallery__main { width: 100%; aspect-ratio: 1; } .product-gallery__thumbs { max-width: 100%; flex-direction: row; overflow-x: auto; overflow-y: hidden; gap: 0.75rem; }  }
</style>
