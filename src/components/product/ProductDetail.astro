---
import { Image, getImage } from "astro:assets";
import type { Product } from "../../data/products";
import relatedShirt from "../../assets/products/remera-oversize/main.png";
import relatedSticker from "../../assets/products/shared-calco.png";
import relatedCap from "../../assets/products/shared-gorra.png";
import { whatsappUrl } from "../../data/site";

interface Props {
  product: Product;
}

const { product } = Astro.props;
const isPhotoProduct = product.slug === "remera-oversize";
const gallery = await Promise.all(product.gallery.map(async (image) => ({
  main: await getImage({ src: image, width: Math.min(1200, image.width), format: "webp", quality: 82 }),
  thumb: await getImage({ src: image, width: Math.min(180, image.width), format: "webp", quality: 78 }),
})));
const relatedProducts = [
  {
    name: "Remera oversize",
    copy: "Algodón premium peinado 24.1",
    price: "$160.000",
    href: "/productos/remera-oversize/",
    image: relatedShirt,
  },
  {
    name: "Calcos",
    copy: "Papel, vinilo o DTF UV",
    price: "$6.000",
    href: "/productos/calcos-papel/",
    image: relatedSticker,
  },
  {
    name: "Gorra trucker",
    copy: "Frente personalizable",
    price: "$47.500",
    href: "/productos/gorra-trucker/",
    image: relatedCap,
  },
];
---

{product.ticker && (
  <aside class="product-ticker" aria-label="Promociones">
    <div class="product-ticker__track">
      <span>3 cuotas sin interés</span><i></i><span>Envío gratis desde 10 unidades</span><i></i><span>Producción personalizada</span><i></i><span>3 cuotas sin interés</span>
    </div>
  </aside>
)}

<main
  id="main-content"
  class:list={["product-page", `product-page--${product.slug}`]}
  data-figma-nodes={product.figmaNodes.join(",")}
>
  <section class="product-hero" aria-labelledby="product-title">
    <div class="product-gallery" data-product-gallery>
      <div class="product-gallery__thumbs" role="group" aria-label="Galería del producto">
        {gallery.map((image, index) => (
          <button
            class:list={["product-gallery__thumb", { "is-active": index === 0 }]}
            type="button"
            data-gallery-thumb
            data-src={image.main.src}
            aria-label={`Ver imagen ${index + 1} de ${product.title}`}
            aria-pressed={index === 0 ? "true" : "false"}
          >
            <img src={image.thumb.src} alt="" loading={index === 0 ? "eager" : "lazy"} />
          </button>
        ))}
      </div>

      <div class:list={["product-gallery__main", { "is-photo": isPhotoProduct }]}>
        <img
          data-gallery-main
          src={gallery[0].main.src}
          alt={product.title}
          fetchpriority="high"
        />
      </div>
    </div>

    <article class="product-info">
      <p class="product-info__breadcrumb">{product.breadcrumb}</p>
      <h1 id="product-title">{product.title}</h1>
      <p class="product-info__pack-label">{product.packLabel}</p>

      <div class="product-info__price-row">
        <strong>{product.price}</strong>
        {product.oldPrice && <del>{product.oldPrice}</del>}
      </div>
      {product.installments && <p class="product-info__installments">{product.installments}</p>}
      {product.discount && <p class="product-info__discount">{product.discount}</p>}

      {product.quantities.length > 0 && (
        <fieldset class="product-selector">
          <legend>{product.quantityLabel ?? "Cantidad"}</legend>
          <div class="product-selector__values" data-product-choice-group>
            {product.quantities.map((quantity, index) => (
              <button
                class:list={["product-chip", { "is-active": index === 0 }]}
                type="button"
                data-product-choice
                aria-pressed={index === 0 ? "true" : "false"}
              >{quantity}</button>
            ))}
          </div>
        </fieldset>
      )}

      <p class="product-info__shipping"><span aria-hidden="true">▰</span>{product.shipping}</p>

      {product.options.map((option) => (
        <fieldset class="product-selector product-selector--wide">
          <legend>{option.label}</legend>
          <div class="product-selector__values" data-product-choice-group>
            {option.values.map((value) => value.href ? (
              <a class:list={["product-chip", { "is-active": value.active }]} href={value.href}>{value.label}</a>
            ) : (
              <button
                class:list={["product-chip", { "is-active": value.active }]}
                type="button"
                data-product-choice
                aria-pressed={value.active ? "true" : "false"}
              >{value.label}</button>
            ))}
          </div>
          {option.note && <p class="product-selector__note">{option.note}</p>}
        </fieldset>
      ))}

      {(product.colorLabel || product.sizeValue) && (
        <div class="product-info__attributes">
          {product.colorLabel && (
            <div>
              <span>{product.colorLabel}</span>
              {product.colors ? (
                <div class="color-swatches" role="group" aria-label={product.colorLabel} data-product-choice-group>
                  {product.colors.map((color, index) => (
                    <button
                      class:list={{ "is-active": index === 0 }}
                      type="button"
                      style={`--swatch:${color}`}
                      data-product-choice
                      aria-label={`${product.colorLabel}, opción ${index + 1}`}
                      aria-pressed={index === 0 ? "true" : "false"}
                    ></button>
                  ))}
                </div>
              ) : product.sizeValue && <strong>{product.sizeValue}</strong>}
            </div>
          )}
          {product.sizeLabel && (
            <div><span>{product.sizeLabel}</span><strong>{product.sizeValue}</strong></div>
          )}
          {!product.colorLabel && product.sizeValue && (
            <div class="product-info__material"><strong>{product.sizeValue}</strong></div>
          )}
        </div>
      )}

      <div class="product-info__actions">
        {product.actions?.map((action) => (
          <a
            class:list={["product-action", { "product-action--primary": action === "consultar" }]}
            href={whatsappUrl(`Hola, quisiera consultar por ${product.title}.`)}
            target="_blank"
            rel="noreferrer"
          >
            {action === "cotizar" ? "Cotizá tu medida" : "Consultar por WhatsApp"}
          </a>
        ))}
      </div>

      {product.promotion && <p class="product-info__promotion">{product.promotion}</p>}
      <div class="product-info__notices">
        {product.notices.map((notice, index) => (
          <p><span aria-hidden="true">{index === 0 ? "✦" : "↗"}</span>{notice}</p>
        ))}
      </div>
    </article>
  </section>

  <section class="product-description" aria-labelledby="description-heading">
    <div>
      <p class="section-kicker">Información</p>
      <h2 id="description-heading">Descripción del producto</h2>
      <p>{product.description}</p>
    </div>
    {product.sizeTable && (
      <div class="size-guide">
        <h3>Tabla de talles</h3>
        <ul>{product.sizeTable.map((row) => <li>{row}</li>)}</ul>
      </div>
    )}
  </section>

  <section class="related" aria-labelledby="related-heading">
    <div class="related__heading">
      <p class="section-kicker">También te puede interesar</p>
      <h2 id="related-heading">Otros productos</h2>
    </div>
    <div class="related__grid">
      {relatedProducts.map((related) => (
        <a class="related-card" href={related.href}>
          <div class="related-card__image">
            <Image src={related.image} alt={related.name} loading="lazy" widths={[280, 480, 640]} sizes="(max-width: 40rem) 80vw, 28vw" />
          </div>
          <div class="related-card__body">
            <h3>{related.name}</h3>
            <p>{related.copy}</p>
            <div><span>Desde</span><strong>{related.price}</strong></div>
          </div>
        </a>
      ))}
    </div>
  </section>
</main>

<script>
  document.querySelectorAll<HTMLElement>("[data-product-gallery]").forEach((gallery) => {
    const mainImage = gallery.querySelector<HTMLImageElement>("[data-gallery-main]");
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb]");
    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        if (mainImage && thumb.dataset.src) mainImage.src = thumb.dataset.src;
        thumbs.forEach((item) => {
          const active = item === thumb;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-pressed", String(active));
        });
      });
    });
  });

  document.querySelectorAll<HTMLElement>("[data-product-choice-group]").forEach((group) => {
    const choices = group.querySelectorAll<HTMLButtonElement>("[data-product-choice]");
    choices.forEach((choice) => {
      choice.addEventListener("click", () => {
        choices.forEach((item) => {
          const active = item === choice;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-pressed", String(active));
        });
      });
    });
  });

</script>

<style>
  .product-ticker {
    height: 2.375rem;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #050505;
    background: var(--color-cyan);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .product-ticker__track {
    width: max-content;
    min-width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 2.5rem;
    white-space: nowrap;
  }

  .product-ticker i {
    width: 0.45rem;
    height: 0.45rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-magenta);
  }

  .product-page {
    padding: 3rem 0 6rem;
    color: #f5f5f2;
    background: var(--color-background);
  }

  .product-hero,
  .product-description,
  .related {
    width: min(calc(100% - 6rem), 87.3125rem);
    margin-inline: auto;
  }

  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.342fr) minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .product-gallery {
    display: grid;
    grid-template-columns: 9.375rem minmax(0, 1fr);
    gap: 2rem;
    min-width: 0;
  }

  .product-gallery__thumbs {
    min-height: 32.4375rem;
    padding: 1.5625rem;
    display: flex;
    flex-direction: column;
    gap: 1.45rem;
    border: 1px solid #343434;
    overflow-y: auto;
    scrollbar-width: thin;
  }

  .product-gallery__thumb {
    width: 6.25rem;
    height: 6.25rem;
    padding: 0;
    flex: 0 0 6.25rem;
    overflow: hidden;
    border: 1px solid transparent;
    background: #111;
    cursor: pointer;
    transition: border-color var(--transition), opacity var(--transition);
  }

  .product-gallery__thumb.is-active { border-color: var(--color-cyan); }
  .product-gallery__thumb:not(.is-active) { opacity: 0.72; }
  .product-gallery__thumb img { width: 100%; height: 100%; object-fit: cover; }

  .product-gallery__main {
    aspect-ratio: 1;
    min-width: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #090909;
  }

  .product-gallery__main img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .product-gallery__main.is-photo img { object-fit: cover; }

  .product-info {
    min-width: 0;
    font-family: var(--font-jetbrains-mono);
  }

  .product-info__breadcrumb,
  .section-kicker {
    color: #8c8c89;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .product-info h1 {
    margin-top: 1.5rem;
    color: var(--color-magenta);
    font-family: var(--font-montserrat);
    font-size: clamp(1.65rem, 1.7vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .product-info__pack-label {
    margin-top: 1.2rem;
    color: #bababa;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .product-info__price-row {
    margin-top: 0.45rem;
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }

  .product-info__price-row strong {
    color: #fff;
    font-size: clamp(1.75rem, 2vw, 2.25rem);
    font-weight: 800;
    line-height: 1.15;
  }

  .product-info__price-row del { color: #767674; font-size: 0.875rem; }
  .product-info__installments,
  .product-info__discount { margin-top: 0.45rem; color: #bfbfbd; font-size: 0.72rem; line-height: 1.45; }
  .product-info__discount { color: var(--color-cyan); }

  .product-selector {
    min-width: 0;
    margin-top: 1.35rem;
    padding: 0;
    border: 0;
  }

  .product-selector legend {
    margin-bottom: 0.65rem;
    color: #d7d7d4;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    text-transform: uppercase;
  }

  .product-selector__values { display: flex; flex-wrap: wrap; gap: 0.55rem; }
  .product-chip {
    min-width: 3rem;
    min-height: 2.35rem;
    padding: 0.55rem 0.75rem;
    display: inline-grid;
    place-items: center;
    color: #aaa;
    background: transparent;
    border: 1px solid #3a3a39;
    font: 700 0.68rem/1.1 var(--font-jetbrains-mono);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    cursor: pointer;
  }
  .product-chip.is-active { color: var(--color-cyan); border-color: var(--color-cyan); }
  .product-selector__note { max-width: 34rem; margin-top: 0.65rem; color: #828280; font-size: 0.66rem; line-height: 1.5; }

  .product-info__shipping {
    margin-top: 1.35rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: #d0d0ce;
    font-size: 0.72rem;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }
  .product-info__shipping span { color: var(--color-yellow); transform: skewX(-15deg); }

  .product-info__attributes {
    margin-top: 1.35rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .product-info__attributes > div { min-height: 3.1rem; padding-left: 0.8rem; border-left: 2px solid var(--color-magenta); }
  .product-info__attributes span { display: block; color: #8c8c89; font-size: 0.65rem; font-weight: 700; text-transform: uppercase; }
  .product-info__attributes strong { margin-top: 0.45rem; display: block; color: #eee; font-size: 0.72rem; line-height: 1.35; }
  .product-info__material { grid-column: 1 / -1; }

  .color-swatches { margin-top: 0.5rem; display: flex; gap: 0.45rem; }
  .color-swatches button {
    width: 1rem;
    height: 1rem;
    padding: 0;
    border: 1px solid #777;
    border-radius: 50%;
    background: var(--swatch);
    cursor: pointer;
  }
  .color-swatches button.is-active { outline: 2px solid var(--color-cyan); outline-offset: 2px; }

  .product-info__actions { margin-top: 1.35rem; display: flex; flex-wrap: wrap; gap: 0.65rem; }
  .product-action {
    min-height: 2.85rem;
    padding: 0.75rem 1rem;
    display: inline-flex;
    flex: 1 1 12rem;
    align-items: center;
    justify-content: center;
    color: var(--color-cyan);
    border: 1px solid var(--color-cyan);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-align: center;
    text-transform: uppercase;
    transition: color var(--transition), background var(--transition);
  }
  .product-action:hover,
  .product-action:focus-visible,
  .product-action--primary { color: #050505; background: var(--color-cyan); }
  .product-action--primary:hover,
  .product-action--primary:focus-visible { color: #fff; background: transparent; }

  .product-info__promotion { margin-top: 1rem; color: var(--color-yellow); font-size: 0.7rem; font-weight: 700; }
  .product-info__notices { margin-top: 1.15rem; display: grid; gap: 0.6rem; }
  .product-info__notices p { display: flex; gap: 0.65rem; color: #8f8f8c; font-size: 0.65rem; line-height: 1.45; }
  .product-info__notices span { color: var(--color-magenta); }

  .product-description {
    margin-top: 5rem;
    padding: 2.75rem 0;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(19rem, 0.8fr);
    gap: 5rem;
    border-top: 1px solid #313130;
    border-bottom: 1px solid #313130;
    font-family: var(--font-jetbrains-mono);
  }
  .product-description h2,
  .related h2 { margin-top: 0.8rem; color: #f1f1ee; font: 800 clamp(1.5rem, 2vw, 2.25rem)/1.1 var(--font-montserrat); letter-spacing: -0.035em; text-transform: uppercase; }
  .product-description > div > p:last-child { max-width: 48rem; margin-top: 1.35rem; color: #a9a9a6; font-size: 0.78rem; line-height: 1.75; }
  .size-guide h3 { color: var(--color-cyan); font-size: 0.8rem; text-transform: uppercase; }
  .size-guide ul { margin-top: 1rem; display: grid; gap: 0.55rem; }
  .size-guide li { padding-bottom: 0.55rem; color: #9a9a97; border-bottom: 1px solid #242424; font-size: 0.67rem; line-height: 1.45; }

  .related { margin-top: 5rem; }
  .related__heading { text-align: center; }
  .related__grid {
    margin-top: 2.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 4rem) / 3);
    gap: 2rem;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-behavior: smooth;
    scroll-snap-type: inline mandatory;
    scrollbar-width: none;
  }
  .related__grid::-webkit-scrollbar { display: none; }
  .related-card { min-width: 0; padding: 1.5rem; display: block; border: 1px solid #323231; background: #0c0c0c; scroll-snap-align: start; transition: transform var(--transition), border-color var(--transition); }
  .related-card:hover,
  .related-card:focus-visible { transform: translateY(-0.35rem); border-color: var(--color-cyan); }
  .related-card__image { height: 18rem; display: grid; place-items: center; overflow: hidden; }
  .related-card__image :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .related-card__body { padding-top: 1.15rem; font-family: var(--font-jetbrains-mono); text-transform: uppercase; }
  .related-card h3 { color: var(--color-cyan); font-size: 1rem; font-weight: 800; }
  .related-card p { margin-top: 0.55rem; color: #aaa; font-size: 0.68rem; font-weight: 700; }
  .related-card__body > div { margin-top: 1rem; display: flex; justify-content: flex-end; align-items: baseline; gap: 0.55rem; }
  .related-card__body span { color: #777; font-size: 0.65rem; }
  .related-card__body strong { color: #eee; font-size: 1rem; }
  @media (max-width: 68.75rem) {
    .product-page { padding-top: 2.25rem; }
    .product-hero,
    .product-description,
    .related { width: calc(100% - 3rem); }
    .product-hero { grid-template-columns: minmax(0, 1.122fr) minmax(0, 1fr); gap: 1.5rem; }
    .product-gallery { grid-template-columns: 9.375rem minmax(0, 1fr); gap: 1.5rem; }
    .product-gallery__main { aspect-ratio: 340 / 537; }
    .product-gallery__thumbs { min-height: 33.5625rem; }
    .product-description { gap: 2.5rem; }
    .related-card__image { height: 15rem; }
  }

  @media (min-width: 40.0625rem) and (max-width: 56rem) {
    .product-hero { display: flex; flex-direction: column; }
    .product-gallery { width: 100%; grid-template-columns: 9.375rem minmax(0, 1fr); }
    .product-gallery__main { aspect-ratio: 1; }
    .product-gallery__thumbs { min-height: 0; max-height: none; }
    .product-info { width: 100%; }
    .product-description { grid-template-columns: 1fr; gap: 2.5rem; }
    .related__grid { grid-auto-columns: calc((100% - 2rem) / 2); }
  }

  @media (max-width: 40rem) {
    .product-ticker { height: 3.25rem; font-size: 0.65rem; }
    .product-ticker__track { justify-content: flex-start; gap: 1.5rem; animation: ticker 22s linear infinite; }
    .product-ticker__track span:nth-of-type(n + 3),
    .product-ticker__track i:nth-of-type(n + 3) { display: none; }
    @keyframes ticker { to { transform: translateX(-48%); } }

    .product-page { padding: 1.5rem 0 4rem; }
    .product-hero,
    .product-description,
    .related { width: calc(100% - 1.5rem); }
    .product-hero { display: flex; flex-direction: column; gap: 1.5rem; }
    .product-gallery { width: 100%; display: flex; flex-direction: column-reverse; gap: 0.75rem; }
    .product-gallery__main { width: 100%; aspect-ratio: 351 / 482; }
    .product-gallery__thumbs { width: 100%; min-height: 0; height: 8.125rem; padding: 1.5rem; flex-direction: row; gap: 1rem; overflow-x: auto; overflow-y: hidden; }
    .product-gallery__thumb { width: 5rem; height: 5rem; flex-basis: 5rem; }
    .product-info { width: 100%; }
    .product-info h1 { margin-top: 1.25rem; font-size: 1.75rem; }
    .product-info__price-row strong { font-size: 2rem; }
    .product-selector { margin-top: 1.5rem; }
    .product-chip { min-height: 2.5rem; }
    .product-info__attributes { grid-template-columns: 1fr 1fr; }
    .product-info__actions { flex-direction: column; }
    .product-action { width: 100%; min-height: 3.25rem; flex: 0 0 auto; }

    .product-description { margin-top: 4rem; padding: 2rem 0; display: block; }
    .product-description h2,
    .related h2 { font-size: 1.75rem; }
    .size-guide { margin-top: 2rem; }

    .related { margin-top: 4rem; }
    .related__heading { text-align: left; }
    .related__grid { margin-top: 1.75rem; grid-auto-columns: 100%; gap: 1rem; }
    .related-card { width: 100%; padding: 1.5rem; }
    .related-card__image { height: 18rem; }
  }
</style>
