---
import { getImage } from "astro:assets";
import type { Product } from "../../data/products";
import { outlinedGarmentSlugs } from "../../data/garment-outlines";
import { getRecommendationCards } from "../../data/product-cards";
import ProductCarousel from "./ProductCarousel.astro";
import { priceCatalog, type CatalogProduct } from "../../data/pricing";
import ProductInfo from "./ProductInfo.astro";
import BrandTicker from "../shared/BrandTicker.astro";

// Import size guide assets to include them directly in the product carousel
import buzoCanguroNinoGuide from "../../assets/talles/buzo-canguro-nino.webp";
import buzoCanguroPremiumGuide from "../../assets/talles/buzo-canguro-premium.webp";
import buzoCanguroGuide from "../../assets/talles/buzo-canguro.webp";
import buzoRedondoGuide from "../../assets/talles/buzo-cuello-redondo.webp";
import camperaCapuchaGuide from "../../assets/talles/campera-capucha.webp";
import chombaAlgodonGuide from "../../assets/talles/chomba-algodon.webp";
import chombaDamaGuide from "../../assets/talles/chomba-dama.webp";
import chombaPiqueGuide from "../../assets/talles/chomba-pique.webp";
import remeraDamaGuide from "../../assets/talles/remera-dama.webp";
import remeraNinoGuide from "../../assets/talles/remera-nino.webp";
import remeraUnisexGuide from "../../assets/talles/remera-unisex.webp";

const sizeGuideMap: Record<string, { image: ImageMetadata; label: string; kind: string }[]> = {
  "remera-unisex": [
    { image: remeraUnisexGuide, label: "Tabla de talles unisex", kind: "unisex" },
    { image: remeraDamaGuide, label: "Tabla de talles dama", kind: "dama" },
  ],
  "remera-nino": [
    { image: remeraNinoGuide, label: "Tabla de talles niño", kind: "nino" },
  ],
  "remera-egresadito": [
    { image: remeraNinoGuide, label: "Tabla de talles infantil", kind: "nino" },
  ],
  "chomba-algodon": [
    { image: chombaAlgodonGuide, label: "Tabla de talles hombre", kind: "unisex" },
    { image: chombaDamaGuide, label: "Tabla de talles dama", kind: "dama" },
  ],
  "chomba-pique": [
    { image: chombaPiqueGuide, label: "Tabla de talles hombre", kind: "unisex" },
    { image: chombaDamaGuide, label: "Tabla de talles dama", kind: "dama" },
  ],
  "buzo-cuello-redondo": [
    { image: buzoRedondoGuide, label: "Tabla de talles", kind: "unisex" },
  ],
  "buzo-canguro": [
    { image: buzoCanguroGuide, label: "Tabla de talles", kind: "unisex" },
  ],
  "buzo-canguro-premium": [
    { image: buzoCanguroPremiumGuide, label: "Tabla de talles", kind: "unisex" },
  ],
  "buzo-canguro-nino": [
    { image: buzoCanguroNinoGuide, label: "Tabla de talles niño", kind: "nino" },
  ],
  "campera-capucha": [
    { image: camperaCapuchaGuide, label: "Tabla de talles", kind: "unisex" },
  ],
};

interface Props {
  product: Product;
}

const { product } = Astro.props;
const hasGarmentOutline = outlinedGarmentSlugs.has(product.slug);
const showHeroImageInGallery = product.slug !== "remera-egresadito";
const galleryImages = product.heroImage
  ? [
      ...(showHeroImageInGallery ? [product.heroImage] : []),
      ...product.gallery.filter((image) => image !== product.heroImage),
    ]
  : product.gallery;
const catalog: CatalogProduct = priceCatalog[product.pricingId];

// Size guide demonstration images included in the carousel
const sizeGuides = sizeGuideMap[product.slug] ?? [];

const allSlides = [
  ...galleryImages.map((image) => ({
    image,
    isSizeGuide: false,
    label: "",
    kind: "",
    hasGarmentOutline: hasGarmentOutline && image === product.heroImage,
  })),
  ...sizeGuides.map((guide) => ({
    image: guide.image,
    isSizeGuide: true,
    label: guide.label,
    kind: guide.kind,
    hasGarmentOutline: false,
  })),
];

const gallery = await Promise.all(
  allSlides.map(async (slide) => ({
    ...slide,
    main: await getImage({
      src: slide.image,
      width: Math.min(slide.image.width, Math.ceil(1200 * Math.max(1, slide.image.width / slide.image.height))),
      format: "webp",
      quality: 85,
    }),
    thumb: await getImage({
      src: slide.image,
      width: Math.min(180, slide.image.width),
      format: "webp",
      quality: 80,
    }),
  }))
);

const relatedProducts = getRecommendationCards(product);
---

{product.ticker && <BrandTicker variant="product" />}

<main
  id="main-content"
  class:list={["product-page", `product-page--${product.slug}`]}
  data-figma-nodes={product.figmaNodes.join(",")}
>
  <section class="product-hero" aria-labelledby="product-title">
    <div class="product-gallery" data-product-gallery>
      <div class="product-gallery__thumbs" role="group" aria-label="Galería del producto">
        <button class="product-gallery__thumb-control" type="button" data-gallery-thumb-previous aria-label="Ver miniaturas anteriores" disabled>⌃</button>
        <div class="product-gallery__thumb-track" data-gallery-thumb-track>
          {gallery.map((item, index) => (
            <button
              class:list={[
                "product-gallery__thumb",
                { "is-active": index === 0 },
                { "product-gallery__thumb--size-guide": item.isSizeGuide },
              ]}
              type="button"
              data-gallery-thumb={item.isSizeGuide ? undefined : ""}
              data-size-thumb={item.isSizeGuide ? "" : undefined}
              data-src={item.main.src}
              data-is-size-guide={item.isSizeGuide ? "true" : "false"}
              data-size-kind={item.kind}
              aria-label={item.isSizeGuide ? item.label : `Ver imagen ${index + 1} de ${product.title}`}
              aria-pressed={index === 0 ? "true" : "false"}
            >
              <img
                class:list={{ "has-garment-outline": item.hasGarmentOutline }}
                src={item.thumb.src}
                alt=""
                loading={index === 0 ? "eager" : "lazy"}
              />
              {item.isSizeGuide && (
                <span class="product-gallery__thumb-badge" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="10" height="10" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21.3 15.3l-8.6-8.6a2 2 0 0 0-2.8 0L2.7 13.9a2 2 0 0 0 0 2.8l7.2 7.2a2 2 0 0 0 2.8 0l8.6-8.6a2 2 0 0 0 0-2.8z"></path>
                    <path d="m14.5 12.5 2-2"></path>
                    <path d="m11.5 9.5 2-2"></path>
                    <path d="m8.5 6.5 2-2"></path>
                  </svg>
                  <span>Talles</span>
                </span>
              )}
            </button>
          ))}
        </div>
        <button class="product-gallery__thumb-control" type="button" data-gallery-thumb-next aria-label="Ver miniaturas siguientes" disabled>⌄</button>
      </div>

      <div class="product-gallery__main">
        {gallery.length > 1 && (
          <button
            class="product-gallery__arrow product-gallery__arrow--prev"
            type="button"
            data-gallery-prev
            aria-label="Ver imagen anterior"
            disabled
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="15 18 9 12 15 6"></polyline>
            </svg>
          </button>
        )}

        <div class="product-gallery__track" data-gallery-track role="group" aria-label={`Imágenes de ${product.title}`} aria-roledescription="carrusel" tabindex="0">
          {gallery.map((item, index) => (
            <div
              class:list={[
                "product-gallery__slide",
                { "product-gallery__slide--size-guide": item.isSizeGuide },
              ]}
              data-gallery-slide
              data-is-size-guide={item.isSizeGuide ? "true" : "false"}
              data-size-kind={item.kind}
              aria-label={item.isSizeGuide ? item.label : `Imagen ${index + 1} de ${gallery.length}`}
            >
              <img
                class:list={{ "has-garment-outline": item.hasGarmentOutline }}
                src={item.main.src}
                alt={item.isSizeGuide ? item.label : index === 0 ? product.title : `${product.title}, imagen ${index + 1}`}
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : undefined}
              />
              {item.isSizeGuide && (
                <button
                  type="button"
                  class="product-gallery__zoom-btn"
                  data-zoom-image={item.main.src}
                  data-zoom-title={item.label}
                  aria-label={`Ampliar ${item.label}`}
                >
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                    <line x1="11" y1="8" x2="11" y2="14"></line>
                    <line x1="8" y1="11" x2="14" y2="11"></line>
                  </svg>
                  <span>Ampliar tabla</span>
                </button>
              )}
            </div>
          ))}
        </div>

        {gallery.length > 1 && (
          <button
            class="product-gallery__arrow product-gallery__arrow--next"
            type="button"
            data-gallery-next
            aria-label="Ver imagen siguiente"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="9 18 15 12 9 6"></polyline>
            </svg>
          </button>
        )}

        <p class="product-gallery__counter" aria-live="polite" aria-atomic="true">
          <span data-gallery-current>1</span>/{gallery.length}
        </p>
      </div>
    </div>

    <ProductInfo product={product} />
  </section>

  <section class="product-description" aria-labelledby="description-heading">
    <div>
      <h2 id="description-heading">Descripción</h2>
      <p>{product.requiresConsultation ? product.description : catalog.description ?? product.description}</p>
    </div>
    {product.sizeTable && (
      <details class="size-guide">
        <summary>Guía de tamaños</summary>
        <ul>{product.sizeTable.map((row) => <li>{row}</li>)}</ul>
      </details>
    )}
  </section>

  <section class="related" aria-labelledby="related-heading">
    <div class="related__heading">
      <h2 id="related-heading">Otros productos</h2>
    </div>
    <ProductCarousel id="related-products" label="Otros productos recomendados" cards={relatedProducts} />
  </section>
</main>

<script>
  const initProductGalleries = () => {
    document.querySelectorAll<HTMLElement>("[data-product-gallery]").forEach((gallery) => {
      if (gallery.dataset.galleryReady) return;
      gallery.dataset.galleryReady = "true";

      const track = gallery.querySelector<HTMLElement>("[data-gallery-track]");
      const thumbTrack = gallery.querySelector<HTMLElement>("[data-gallery-thumb-track]");
      const thumbs = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-thumb], [data-size-thumb]"));
      const slides = Array.from(gallery.querySelectorAll<HTMLElement>("[data-gallery-slide]"));
      const currentIndex = gallery.querySelector<HTMLElement>("[data-gallery-current]");
      const prevBtn = gallery.querySelector<HTMLButtonElement>("[data-gallery-prev]");
      const nextBtn = gallery.querySelector<HTMLButtonElement>("[data-gallery-next]");
      const thumbPrevious = gallery.querySelector<HTMLButtonElement>("[data-gallery-thumb-previous]");
      const thumbNext = gallery.querySelector<HTMLButtonElement>("[data-gallery-thumb-next]");

      if (!track || !slides.length) return;

      const total = slides.length;
      let activeIndex = 0;

      const scrollToIndex = (index: number, smooth = true) => {
        activeIndex = Math.max(0, Math.min(index, total - 1));
        const slide = slides[activeIndex];
        if (!slide) return;

        track.scrollTo({
          left: slide.offsetLeft,
          behavior: smooth && !window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "smooth" : "instant",
        });
        setActive(activeIndex);
      };

      const setActive = (index: number) => {
        activeIndex = Math.max(0, Math.min(index, total - 1));
        if (currentIndex) currentIndex.textContent = String(activeIndex + 1);

        thumbs.forEach((thumb, i) => {
          const isSelected = i === activeIndex;
          thumb.classList.toggle("is-active", isSelected);
          thumb.setAttribute("aria-pressed", String(isSelected));
        });

        if (thumbs[activeIndex] && thumbTrack) {
          const thumb = thumbs[activeIndex];
          const isHorizontal = getComputedStyle(thumbTrack).flexDirection === "row";
          if (isHorizontal) {
            const thumbLeft = thumb.offsetLeft;
            const thumbRight = thumbLeft + thumb.offsetWidth;
            if (thumbLeft < thumbTrack.scrollLeft || thumbRight > thumbTrack.scrollLeft + thumbTrack.clientWidth) {
              thumb.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "smooth" });
            }
          } else {
            const thumbTop = thumb.offsetTop;
            const thumbBottom = thumbTop + thumb.offsetHeight;
            if (thumbTop < thumbTrack.scrollTop || thumbBottom > thumbTrack.scrollTop + thumbTrack.clientHeight) {
              thumb.scrollIntoView({ block: "nearest", inline: "nearest", behavior: "smooth" });
            }
          }
        }

        if (prevBtn) prevBtn.disabled = activeIndex === 0;
        if (nextBtn) nextBtn.disabled = activeIndex === total - 1;
        updateThumbControls();
      };

      thumbs.forEach((thumb, index) => {
        thumb.addEventListener("click", () => scrollToIndex(index, true));
      });

      prevBtn?.addEventListener("click", () => scrollToIndex(activeIndex - 1, true));
      nextBtn?.addEventListener("click", () => scrollToIndex(activeIndex + 1, true));

      let scrollTicking = false;
      track.addEventListener("scroll", () => {
        if (!scrollTicking) {
          requestAnimationFrame(() => {
            const width = track.clientWidth || 1;
            const current = Math.round(track.scrollLeft / width);
            if (current !== activeIndex) {
              setActive(current);
            }
            scrollTicking = false;
          });
          scrollTicking = true;
        }
      }, { passive: true });

      // Mouse Drag support on desktop
      let isDragging = false;
      let startX = 0;
      let startScroll = 0;
      let lastX = 0;
      let velocity = 0;

      track.addEventListener("pointerdown", (e) => {
        if (e.pointerType !== "mouse" || e.button !== 0) return;
        if (e.target instanceof Element && e.target.closest("button, a, input, select, textarea")) return;
        isDragging = true;
        startX = e.clientX;
        lastX = e.clientX;
        startScroll = track.scrollLeft;
        velocity = 0;
        track.classList.add("is-dragging");
        track.setPointerCapture(e.pointerId);
      });

      track.addEventListener("pointermove", (e) => {
        if (!isDragging) return;
        const dx = e.clientX - startX;
        track.scrollLeft = startScroll - dx;
        velocity = -(e.clientX - lastX);
        lastX = e.clientX;
      });

      const endDrag = (e: PointerEvent) => {
        if (!isDragging) return;
        isDragging = false;
        track.classList.remove("is-dragging");
        if (track.hasPointerCapture(e.pointerId)) {
          track.releasePointerCapture(e.pointerId);
        }
        const distance = e.clientX - startX;
        if (Math.abs(distance) > 40 || Math.abs(velocity) > 6) {
          const dir = (distance < 0 || velocity > 4) ? 1 : -1;
          scrollToIndex(activeIndex + dir, true);
        } else {
          scrollToIndex(activeIndex, true);
        }
      };

      track.addEventListener("pointerup", endDrag);
      track.addEventListener("pointercancel", endDrag);

      track.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          scrollToIndex(activeIndex - 1, true);
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          scrollToIndex(activeIndex + 1, true);
        }
      });

      // Jump to size chart slide from external buttons
      document.querySelectorAll<HTMLElement>("[data-scroll-to-size]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const kind = btn.dataset.scrollToSize;
          let targetIndex = -1;
          if (kind) {
            targetIndex = slides.findIndex((s) => s.dataset.sizeKind === kind);
          }
          if (targetIndex === -1) {
            targetIndex = slides.findIndex((s) => s.dataset.isSizeGuide === "true");
          }
          if (targetIndex !== -1) {
            scrollToIndex(targetIndex, true);
            if (window.innerWidth <= 896) {
              gallery.scrollIntoView({ behavior: "smooth", block: "start" });
            }
          }
        });
      });

      // Dialog Lightbox Zoom
      const dialog = document.querySelector<HTMLDialogElement>("#size-guide-dialog");
      const dialogImg = dialog?.querySelector<HTMLImageElement>(".size-lightbox__image");
      if (dialog && dialogImg) {
        gallery.querySelectorAll<HTMLElement>("[data-zoom-image]").forEach((zoomBtn) => {
          zoomBtn.addEventListener("click", (e) => {
            e.stopPropagation();
            const src = zoomBtn.dataset.zoomImage;
            const title = zoomBtn.dataset.zoomTitle || "Tabla de talles";
            if (src) {
              dialogImg.src = src;
              dialogImg.alt = title;
              dialog.setAttribute("aria-label", title);
              dialog.showModal();
              document.documentElement.classList.add("has-open-size-guide");
            }
          });
        });
      }

      const updateThumbControls = () => {
        if (!thumbTrack) return;
        const horizontal = getComputedStyle(thumbTrack).flexDirection === "row";
        const position = horizontal ? thumbTrack.scrollLeft : thumbTrack.scrollTop;
        const viewport = horizontal ? thumbTrack.clientWidth : thumbTrack.clientHeight;
        const extent = horizontal ? thumbTrack.scrollWidth : thumbTrack.scrollHeight;
        if (thumbPrevious) thumbPrevious.disabled = position <= 2;
        if (thumbNext) thumbNext.disabled = position + viewport >= extent - 2;
        if (thumbPrevious && thumbNext && extent <= viewport + 4) {
          thumbPrevious.hidden = true;
          thumbNext.hidden = true;
        }
      };

      thumbPrevious?.addEventListener("click", () => {
        if (!thumbTrack) return;
        const horizontal = getComputedStyle(thumbTrack).flexDirection === "row";
        thumbTrack.scrollBy({
          left: horizontal ? -thumbTrack.clientWidth * 0.75 : 0,
          top: horizontal ? 0 : -thumbTrack.clientHeight * 0.75,
          behavior: "smooth",
        });
      });

      thumbNext?.addEventListener("click", () => {
        if (!thumbTrack) return;
        const horizontal = getComputedStyle(thumbTrack).flexDirection === "row";
        thumbTrack.scrollBy({
          left: horizontal ? thumbTrack.clientWidth * 0.75 : 0,
          top: horizontal ? 0 : thumbTrack.clientHeight * 0.75,
          behavior: "smooth",
        });
      });

      if (thumbTrack) {
        thumbTrack.addEventListener("scroll", updateThumbControls, { passive: true });
        const observer = new ResizeObserver(updateThumbControls);
        observer.observe(thumbTrack);
        document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
      }
      setActive(0);
    });
  };

  initProductGalleries();
  document.addEventListener("astro:page-load", initProductGalleries);
</script>

<style>
  .product-page {
    --font-jetbrains-mono: "JetBrains Mono", "Courier New", monospace;
    padding: 4.1875rem 0 7rem;
    background: var(--color-background);
  }

  .product-hero,
  .product-description,
  .related {
    width: min(calc(100% - 6rem), 87.3125rem);
    margin-inline: auto;
  }

  .product-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.342fr) minmax(0, 1fr);
    gap: 2.5rem;
    align-items: start;
    animation: productHeroFade 350ms ease-out;
  }

  @keyframes productHeroFade {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .product-gallery {
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 1fr);
    gap: 2rem;
    min-width: 0;
  }

  .product-gallery__thumbs {
    align-self: start;
    height: 28rem;
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    border: 1px solid #353534;
    background: #13131380;
    min-width: 0;
  }

  .product-gallery__thumb-track {
    min-height: 0;
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.75rem;
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: none;
  }
  .product-gallery__thumb-track::-webkit-scrollbar { display: none; }

  .product-gallery__thumb-control {
    width: 100%;
    min-height: 2rem;
    flex: 0 0 2rem;
    padding: 0;
    border: 1px solid #353534;
    background: transparent;
    color: #fff;
    cursor: pointer;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  .product-gallery__thumb-control:hover:not(:disabled) {
    background: #252525;
    border-color: #555;
  }
  .product-gallery__thumb-control:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .product-gallery__thumb-control[hidden] { display: none; }

  .product-gallery__thumb {
    position: relative;
    max-width: 100%;
    width: 6.25rem;
    height: 6.25rem;
    flex: 0 0 6.25rem;
    padding: 0;
    border: 1px solid #2a2a29;
    overflow: hidden;
    background: #0d0d0d;
    cursor: pointer;
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .product-gallery__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .product-gallery__thumb:hover {
    border-color: rgba(227, 14, 127, 0.6);
    transform: scale(1.02);
  }

  .product-gallery__thumb:focus-visible,
  .product-gallery__thumb-control:focus-visible {
    outline: 2px solid var(--color-magenta);
    outline-offset: 2px;
  }

  .product-gallery__thumb.is-active {
    border-color: var(--color-magenta);
    box-shadow: 0 0 10px rgba(227, 14, 127, 0.3);
    outline: 1px solid var(--color-magenta);
    outline-offset: 1px;
  }

  .product-gallery__thumb-badge {
    position: absolute;
    bottom: 0.25rem;
    left: 0.25rem;
    right: 0.25rem;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    padding: 0.2rem 0.3rem;
    background: rgba(227, 14, 127, 0.9);
    backdrop-filter: blur(4px);
    color: #fff;
    font: 700 0.58rem/1 var(--font-jetbrains-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-radius: 2px;
  }

  .product-gallery__main {
    position: relative;
    display: flex;
    flex-direction: column;
    aspect-ratio: 1;
    min-width: 0;
    overflow: hidden;
    background: #0d0d0d;
    border: 1px solid #242423;
  }

  .product-gallery__track {
    width: 100%;
    min-height: 0;
    flex: 1;
    display: flex;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    touch-action: pan-x pan-y;
    cursor: grab;
    user-select: none;
  }
  .product-gallery__track::-webkit-scrollbar { display: none; }
  .product-gallery__track:focus-visible {
    outline: 2px solid var(--color-magenta);
    outline-offset: -2px;
  }
  .product-gallery__track.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
  }
  .product-gallery__track.is-dragging img { pointer-events: none; }

  .product-gallery__slide {
    position: relative;
    width: 100%;
    height: 100%;
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    display: flex;
