---
import type { Product } from "../../data/products";
import SizeGuide from "./SizeGuide.astro";
import { priceCatalog, resolveCatalogPrice, formatCatalogPrice, getCatalogTotal, describeCatalogSelection, type CatalogProduct } from "../../data/pricing";
import { whatsappUrl } from "../../data/site";
import truck from "../../assets/icons/product-truck.svg";
import layers from "../../assets/icons/product-layers.svg";
import badge from "../../assets/icons/product-badge.svg";
import chevron from "../../assets/icons/product-chevron.svg";

interface Props { product: Product; }
const { product } = Astro.props;
const catalog: CatalogProduct = priceCatalog[product.pricingId];
const entry = product.requiresConsultation ? undefined : resolveCatalogPrice(product.pricingId, product.priceSelection);
const quantity = catalog.variants.find(({ key }) => key === "quantity");
const otherDimensions = catalog.variants.filter(({ key }) => key !== "quantity");
const isCalco = catalog.category === "Calcos";
const notes = product.requiresConsultation ? ["Consultar opciones de personalización."] : catalog.notes;
const contact = whatsappUrl(`Hola, quisiera consultar por ${product.title}. ${describeCatalogSelection(catalog, product.priceSelection)}. Precio: ${formatCatalogPrice(entry)}.`);
---

<article class="product-info" data-catalog-pricing data-catalog={JSON.stringify(catalog)} data-consult-only={product.requiresConsultation ? "true" : "false"}>
  <p class="product-info__breadcrumb">{product.breadcrumb}</p>
  <h1 id="product-title">{product.title}</h1>
  <p class="product-info__pack-label">{product.packLabel}</p>
  <div class="product-info__pricing" aria-live="polite" aria-atomic="true">
    <div class="product-info__price-row"><strong data-product-price>{formatCatalogPrice(entry)}</strong><span data-price-kind hidden={!getCatalogTotal(entry)}>total</span></div>
    <p data-product-installments hidden={!entry?.installments}>{entry?.installments}</p>
    <p data-price-note hidden={!entry?.note}>{entry?.note}</p>
  </div>

  {product.options.map((option) => (
    <fieldset class="product-selector">
      <legend>{option.label}</legend>
      <div class="product-selector__values">
        {option.values.map((value) => <a class:list={["product-chip", { "is-active": value.active }]} href={value.href} aria-current={value.active ? "page" : undefined}>{value.label}</a>)}
      </div>
    </fieldset>
  ))}

  {quantity && (
    <fieldset class="product-selector" data-price-dimension="quantity">
      <legend>Cantidad: <span data-quantity-label>{quantity.options.find(({ value }) => value === product.priceSelection.quantity)?.label}</span></legend>
      <div class="product-selector__values">
        {quantity.options.map((option) => (
          <button type="button" class:list={["product-chip", { "is-active": option.value === product.priceSelection.quantity }]} data-price-choice={option.value} aria-pressed={option.value === product.priceSelection.quantity ? "true" : "false"}>{option.value.toUpperCase()}</button>
        ))}
      </div>
    </fieldset>
  )}

  <p class="product-info__shipping"><img src={truck.src} alt="" width="28" height="28" />Consultar condiciones de envío</p>

  {otherDimensions.map((dimension) => (
    <fieldset class:list={["product-selector", { "product-selector--measure": dimension.key !== "side" }]} data-price-dimension={dimension.key}>
      <legend>{dimension.key === "size" ? "Seleccionar medida" : dimension.label}</legend>
      {dimension.key === "side" ? (
        <div class="product-selector__values">
          {dimension.options.map((option) => <button type="button" class:list={["product-chip", { "is-active": option.value === product.priceSelection[dimension.key] }]} data-price-choice={option.value} aria-pressed={option.value === product.priceSelection[dimension.key] ? "true" : "false"}>{option.label}</button>)}
        </div>
      ) : (
        <div class="product-select">
          <select aria-label={dimension.label} data-price-select>
            {dimension.options.map((option) => <option value={option.value} selected={option.value === product.priceSelection[dimension.key]}>{dimension.key === "size" ? `Tamaño: ${option.label}` : option.label}</option>)}
            <option value="consultar">Otra medida · Consultar</option>
          </select>
          <img src={chevron.src} alt="" width="18" height="18" />
        </div>
      )}
      {dimension.key === "size" && <p class="product-selector__note">En los packs aparecen medidas estándar, las más usadas. Para otras medidas o cantidades, consultar.</p>}
    </fieldset>
  ))}

  {(isCalco || product.colorLabel || product.sizeValue) && (
    <div class="product-info__attributes">
      {isCalco ? <div><h2>Bases</h2><p>Consultar opciones disponibles</p></div> : <>
        {product.colorLabel && <div><h2>{product.colorLabel}</h2><div class="color-swatches" role="group" aria-label={product.colorLabel} data-product-choice-group>{product.colors?.map((color, index) => <button type="button" class:list={{ "is-active": index === 0 }} style={`--swatch:${color}`} data-product-choice aria-label={`${product.colorLabel}, opción ${index + 1}`} aria-pressed={index === 0 ? "true" : "false"}></button>)}</div></div>}
        {product.sizeValue && <div>
          <h2>{product.sizeLabel ?? "Material"}</h2>
          <p>{product.sizeLabel === "Talles" && !product.sizeGuide ? "Consultar" : product.sizeValue}</p>
          {product.sizeLabel === "Talles" && product.sizeGuide && (
            <SizeGuide src={product.sizeGuide} title={product.seoTitle ?? product.title} />
          )}
        </div>}
      </>}
    </div>
  )}

  <div class="product-info__actions">
    <a class="product-action product-action--quote" href={contact} data-price-contact data-product-title={product.title} target="_blank" rel="noreferrer">Cotizar producto</a>
    <a class="product-action" href={contact} data-price-contact data-product-title={product.title} target="_blank" rel="noreferrer">Consultar producto</a>
  </div>
  <div class="product-info__notices">
    {notes.map((note, index) => <p><img src={index === 0 ? layers.src : badge.src} alt="" width="28" height="28" />{note}</p>)}
    {isCalco && <p><img src={layers.src} alt="" width="28" height="28" />Consultá las opciones de corte y terminación para tu proyecto.</p>}
    <p><img src={badge.src} alt="" width="28" height="28" />Para otras cantidades o personalizaciones: Consultar.</p>
  </div>
</article>

<script>
  import { initCatalogPricing } from "../../scripts/catalog-pricing";
  initCatalogPricing();
</script>

<style>
  .product-info { min-width: 0; font-family: var(--font-poppins); }
  .product-info [hidden] { display: none; }
  .product-info__breadcrumb { margin-bottom: 1.25rem; font: 500 1rem/1.5 var(--font-poppins); color: #ffffffb3; }
  h1 { margin: 0 0 0.75rem; color: var(--color-magenta); font-size: 1.5rem; font-weight: 700; letter-spacing: 0.05625rem; line-height: 1.167; text-transform: uppercase; }
  .product-info__pack-label { color: #ffffffb0; font-size: 1.125rem; font-weight: 700; text-transform: uppercase; }
  .product-info__pricing { margin-top: 0.625rem; font: 500 1rem/1.5 var(--font-poppins); color: #ffffffb3; }
  .product-info__price-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem; }
  .product-info__price-row strong { color: var(--color-magenta); font: 700 1.375rem/1.4 var(--font-poppins); }
  .product-info__pricing > p { margin-top: 0.25rem; }
  .product-selector { min-width: 0; margin: 1.25rem 0 0; padding: 0; border: 0; }
  .product-selector legend { margin-bottom: 0.875rem; padding: 0; color: #fff; font-size: 0.8125rem; font-weight: 700; text-transform: uppercase; }
  .product-selector__values { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .product-chip { display: inline-flex; align-items: center; justify-content: center; min-height: 2.25rem; padding: 0.46875rem 1.0625rem; color: var(--color-magenta); border: 1px solid #353534; background: transparent; font: 700 0.875rem/1.25rem var(--font-poppins); letter-spacing: 0.0875rem; text-transform: uppercase; cursor: pointer; }
  .product-chip.is-active, .product-chip:hover { border-color: var(--color-magenta); }
  .product-info__shipping { display: flex; align-items: center; gap: 0.625rem; margin-top: 1.25rem; color: #ffffffb3; font: 500 1rem/1.5 var(--font-poppins); }
  .product-info img { flex: 0 0 auto; object-fit: contain; }
  .product-selector--measure legend, .product-info__attributes h2 { border-left: 2px solid var(--color-magenta); padding-left: 1.125rem; color: var(--color-magenta); font: 500 1rem/1 var(--font-poppins); letter-spacing: 0.075rem; text-transform: uppercase; }
  .product-select { position: relative; display: inline-flex; max-width: 100%; }
  select { max-width: 100%; min-height: 2.25rem; appearance: none; padding: 0.45rem 2rem 0.45rem 1rem; border: 1px solid #353534; border-radius: 0; background: var(--color-background); color: var(--color-magenta); font: 700 0.875rem/1.25rem var(--font-poppins); text-transform: uppercase; cursor: pointer; }
  .product-select img { position: absolute; right: 0.45rem; top: 50%; transform: translateY(-50%); pointer-events: none; }
  .product-selector__note { margin-top: 0.75rem; color: #ffffffb3; font: 500 1rem/1.5 var(--font-poppins); }
  .product-info__attributes { display: flex; flex-wrap: wrap; gap: 1.25rem 2.5rem; margin-top: 1.25rem; }
  .product-info__attributes p { margin-top: 0.875rem; font-size: 0.8125rem; text-transform: uppercase; }
  .color-swatches { display: flex; gap: 0.65rem; margin-top: 0.875rem; }
  .color-swatches button { width: 1rem; height: 1rem; padding: 0; border: 1px solid #777; border-radius: 50%; background: var(--swatch); cursor: pointer; }
  .color-swatches button.is-active { outline: 2px solid var(--color-magenta); outline-offset: 3px; }
  .product-info__actions { display: flex; flex-wrap: wrap; gap: 0.625rem; margin-top: 1.25rem; }
  .product-action { position: relative; display: inline-flex; align-items: center; justify-content: center; min-height: 3.4375rem; padding: 1rem 1.5rem; border: 1px solid #fff; color: #fff; font: 700 0.875rem/1.25rem var(--font-poppins); letter-spacing: 0.0875rem; text-transform: uppercase; }
  .product-action { width: 14.4375rem; max-width: 100%; }
  .product-action--quote { width: 16.4375rem; color: var(--color-magenta); border-color: var(--color-magenta); }
  .product-action::before, .product-action::after { content: ""; position: absolute; height: 2px; background: var(--color-background); width: 1.5625rem; }
  .product-action::before { top: -1px; left: 0.6875rem; }
  .product-action::after { bottom: -1px; right: 1.9375rem; box-shadow: 1.25rem 0 var(--color-background); }
  .product-action:hover { border-color: var(--color-magenta); color: var(--color-magenta); }
  .product-info__notices { display: grid; gap: 0.5rem; margin-top: 1.25rem; }
  .product-info__notices p { display: flex; align-items: center; gap: 0.625rem; padding: 0.625rem 0; color: #ffffffb3; font: 500 1rem/1.5 var(--font-poppins); }
  @media (max-width: 68.75rem) { .product-chip { padding-inline: 0.75rem; letter-spacing: 0.04rem; } .product-action { padding-inline: 1rem; letter-spacing: 0.04rem; } }
  @media (max-width: 40rem) { .product-info { width: 100%; } .product-info__actions { display: grid; grid-template-columns: 1fr; } .product-action { width: 100%; } }
</style>
