---
import { Image } from "astro:assets";
import BackgroundText from "../shared/BackgroundText.astro";
import localImage from "../../assets/images/nuestrahistoria.png";
---

<section id="nosotros" class="about" aria-labelledby="about-heading" data-figma-node="1031:1666">
  <BackgroundText />

  <div class="about__rail" aria-hidden="true">Conocé</div>
  <h2 id="about-heading" class="about__title">Nuestra<br />historia</h2>

  <div class="about__content">
    <article class="about__card">
      <div class="about__dots" aria-hidden="true"><span></span><span></span><span></span></div>
      <h3>Química<br />Estampados</h3>

      <p class="about__lead">Somos una empresa especializada en estampados textiles y productos personalizados.</p>
      <p>Desde <strong>2016</strong> ofrecemos soluciones para emprendedores, marcas, empresas e instituciones, combinando producción, creatividad y asesoramiento.</p>
      <p>Acompañando cada proyecto desde la idea inicial hasta el producto final, tenemos un enfoque orientado a la calidad, la atención personalizada y la búsqueda de resultados que potencien la identidad de cada cliente.</p>

      <a class="about__cta" href="#contacto">Conocenos más</a>
      <span class="about__line" aria-hidden="true"></span>
    </article>

    <div class="about__photo">
      <Image
        class="about__image"
        src={localImage}
        alt="Local de Química Estampados"
        loading="lazy"
        widths={[480, 720, 960]}
        sizes="(max-width: 42rem) calc(100vw - 2rem), 30vw"
      />
    </div>
  </div>
</section>

<style>
  .about {
    --about-heading-bottom: 0;
    --background-text-top: 41.945%;
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 63.625rem;
    overflow: hidden;
    background: var(--color-background);
  }

  .about__rail {
    position: absolute;
    bottom: var(--about-heading-bottom);
    left: 3.6458%;
    z-index: 2;
    color: var(--color-yellow);
    font-family: var(--font-montserrat);
    font-size: var(--vertical-title-font-size);
    font-weight: var(--vertical-title-font-weight);
    letter-spacing: -0.045em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .about__title {
    position: absolute;
    bottom: var(--about-heading-bottom);
    left: 8.2292%;
    z-index: 2;
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .about__content {
    position: absolute;
    top: 3.8125rem;
    width: min(64.5vw, 77.5rem);
    margin-left: max(17.75vw, calc((100% - 77.5rem) / 2));
    padding-top: 0;
    display: grid;
    grid-template-columns: 1fr 0.988fr;
    align-items: start;
    gap: min(3.33vw, 4rem);
  }

  .about__card {
    position: relative;
    height: 45.625rem;
    min-height: 0;
    margin-top: 0;
    padding: 3.0625rem 2.6875rem;
    background: rgba(19, 19, 19, 0.5);
    border: 0.0625rem solid #353534;
    backdrop-filter: blur(2px);
  }

  .about__dots {
    margin-bottom: 0.8rem;
    display: flex;
    gap: 0.2rem;
  }

  .about__dots span {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-cyan);
  }

  .about__dots span:nth-child(2) { background: var(--color-magenta); }
  .about__dots span:nth-child(3) { background: var(--color-yellow); }

  .about__card h3 {
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: clamp(1.8rem, 2.2vw, 2.625rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .about__card p {
    max-width: 29rem;
    margin-top: 0.8rem;
    color: #bdbdbb;
    font-family: var(--font-poppins);
    font-size: clamp(0.82rem, 0.94vw, 1.125rem);
    font-weight: 400;
    line-height: 1.45;
  }

  .about__card .about__lead {
    margin-top: 1.9rem;
    color: #eeeeec;
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.65rem, 0.73vw, 0.875rem);
    font-weight: 700;
    letter-spacing: 0.035em;
    line-height: 1.55;
    text-transform: uppercase;
  }

  .about__cta {
    width: 10.875rem;
    min-width: 0;
    min-height: 2.875rem;
    margin-top: 1.9rem;
    padding: 0.75rem 0.5rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-yellow);
    border: 0.0625rem solid var(--color-yellow);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    transition: color var(--transition), background var(--transition);
  }

  .about__cta:hover,
  .about__cta:focus-visible {
    color: #050505;
    background: var(--color-yellow);
  }

  .about__line {
    position: absolute;
    left: 25.7%;
    bottom: 7.4%;
    width: 48.1%;
    height: 0.0625rem;
    background: var(--color-yellow);
    opacity: 0.8;
  }

  .about__photo {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 0.5rem;
  }

  .about__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  @media (min-width: 64.0625rem) {
    .about__dots { gap: 0.25rem; }
    .about__dots span { width: 0.875rem; height: 0.875rem; }
    .about__card h3 { font-size: 2.5rem; }
    .about__card p { max-width: 28rem; font-size: 1rem; line-height: 1.5; }
    .about__card .about__lead { font-size: 0.875rem; line-height: 1.7143; }
  }

  @media (min-width: 40.0625rem) and (max-width: 110rem) {
    .about {
      width: calc(100% - 3rem);
      height: 60rem;
      margin-inline: auto;
    }

    .about__content {
      position: absolute;
      top: 8.625rem;
      left: 4.918%;
      width: 91.803%;
      margin: 0;
      padding: 0;
      grid-template-columns: minmax(0, 44.475%) minmax(0, 51.553%);
      gap: 3.972%;
      align-items: center;
    }

    .about__card {
      width: 100%;
      height: 36.125rem;
      min-height: 36.125rem;
      margin: 0;
      padding: clamp(2rem, 4.785vw, 3.0625rem) clamp(1.375rem, 3.223vw, 2.0625rem) 2.0625rem;
      aspect-ratio: auto;
    }

    .about__card h3 { font-size: clamp(1.5rem, 3.125vw, 2rem); }
    .about__card p { font-size: clamp(0.875rem, 1.5625vw, 1rem); line-height: 1.5; }
    .about__card .about__lead { font-size: clamp(0.75rem, 1.3672vw, 0.875rem); line-height: 1.714; }
    .about__card p:nth-of-type(3) { display: none; }
    .about__cta { font-size: 0.875rem; }
    .about__line { left: 14.5%; bottom: 2.0625rem; width: 71%; }
    .about__photo { width: 100%; aspect-ratio: 462.4 / 578; }

    .about__rail { left: 0; bottom: 0; font-size: 3rem; }
    .about__title { left: 3.6875rem; bottom: 0; font-size: 2.25rem; line-height: 1.05; }
  }

  @media (min-width: 40.0625rem) and (max-width: 52rem) {
    .about { height: 88rem; }

    .about__content {
      top: 5rem;
      left: 8%;
      width: 84%;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .about__card {
      height: auto;
      min-height: 36.125rem;
    }

    .about__photo {
      height: 30rem;
      aspect-ratio: auto;
    }
  }

  @media (max-width: 40rem) {
    .about {
      width: calc(100% - 1.5rem);
      height: auto;
      min-height: 79.234375rem;
      margin-inline: auto;
      padding: 3rem 0 12rem;
    }

    .about__content {
      position: static;
      width: 100%;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .about__card {
      width: 100%;
      min-height: 32.5rem;
      margin: 0;
      padding: 3.0625rem 2.0625rem 2.0625rem;
      aspect-ratio: auto;
    }

    .about__card h3 { font-size: 1.5rem; }
    .about__card p { font-size: 0.875rem; line-height: 1.714; }
    .about__card .about__lead { font-size: 0.875rem; line-height: 1.714; }
    .about__card p:nth-of-type(3) { display: none; }
    .about__cta { font-size: 0.875rem; }
    .about__line { left: 9.8%; bottom: 2.0625rem; width: 80.3%; }
    .about__photo { width: 100%; aspect-ratio: 584 / 730; }

    .about__rail { left: 0; bottom: 3rem; font-size: 2rem; }
    .about__title { left: 2.75rem; bottom: 3rem; font-size: 1.25rem; line-height: 1.05; }
  }
</style>
