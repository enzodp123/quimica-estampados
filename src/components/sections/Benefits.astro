---
import { Icon } from "astro-icon/components";

const benefits = [
  {
    icon: "lucide:badge-check",
    title: "DTF de alta resolución",
    text: "Máxima definición y colores intensos.",
  },
  {
    icon: "lucide:truck",
    title: "Logística",
    text: "Envíos rápidos a cualquier punto del país.",
  },
  {
    icon: "lucide:layers",
    title: "Materiales premium",
    text: "Insumos de calidad para resultados duraderos.",
  },
  {
    icon: "lucide:headset",
    title: "Atención personalizada",
    text: "Te acompañamos desde la idea hasta la entrega.",
  },
  {
    icon: "lucide:store",
    title: "Local físico",
    text: "Asesoramiento presencial para cada proyecto.",
  },
];
---

<section class="benefits" aria-label="Beneficios de trabajar con nosotros">
  <div class="benefits__inner">
    {benefits.map(({ icon, title, text }) => (
      <article class="benefit">
        <Icon class="benefit__icon" name={icon} aria-hidden="true" />
        <h2>{title}</h2>
        <p>{text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .benefits {
    width: 100%;
    height: 20.8125rem;
    display: grid;
    place-items: center;
    background: var(--color-background);
    border-top: 0.0625rem solid var(--color-border);
  }

  .benefits__inner {
    width: min(calc(100% - 4rem), 91.5rem);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 243fr 250fr 262fr 272fr 245fr;
    align-items: start;
    gap: 3rem;
  }

  .benefit {
    min-width: 0;
    padding-inline: 0.25rem;
    text-align: center;
  }

  .benefit__icon {
    width: 3rem;
    height: 3rem;
    margin-inline: auto;
    margin-bottom: 0.9375rem;
    display: block;
    color: var(--color-cyan);
    stroke-width: 1.35;
  }

  .benefit:nth-child(2) .benefit__icon {
    color: var(--color-magenta);
  }

  .benefit:nth-child(3) .benefit__icon {
    color: var(--color-yellow);
  }

  .benefit:nth-child(4) .benefit__icon {
    color: var(--color-text);
  }

  .benefit h2 {
    margin: 0 0 0.453125rem;
    color: #e5e2e1;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.046875rem;
    line-height: 1.40625;
    text-transform: uppercase;
  }

  .benefit p {
    max-width: 13.5rem;
    margin-inline: auto;
    color: #d5dddc;
    font-family: var(--font-poppins);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.392857;
  }

  @media (min-width: 40.0625rem) and (max-width: 64rem) {
    .benefits {
      width: calc(100% - 5.25rem);
      height: 28.375rem;
      margin-inline: auto;
      padding-block: 5.25rem 4.75rem;
    }

    .benefits__inner {
      width: 100%;
      height: 100%;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-content: space-between;
      gap: 2rem 1.25rem;
    }

    .benefit:nth-child(1) { order: 1; }
    .benefit:nth-child(3) { order: 2; }
    .benefit:nth-child(2) { order: 3; }
    .benefit:nth-child(4) { order: 4; }
    .benefit:nth-child(5) { order: 5; }

    .benefit:nth-child(4) { grid-column: 1; }
    .benefit:nth-child(5) { grid-column: 2; }

    .benefit h2 { font-size: 1rem; }
    .benefit p { font-size: 0.875rem; }
  }

  @media (max-width: 40rem) {
    .benefits {
      width: calc(100% - 1.5rem);
      height: 58.8125rem;
      margin-inline: auto;
      padding-block: 3.25rem 3rem;
    }

    .benefits__inner {
      width: 100%;
      height: 100%;
      grid-template-columns: 1fr;
      align-content: space-between;
      gap: 0;
    }

    .benefit {
      width: 100%;
      padding-inline: 0 50%;
      text-align: center;
    }

    .benefit__icon,
    .benefit p {
      margin-inline: auto;
    }

    .benefit h2 {
      font-size: 0.875rem;
    }

    .benefit:nth-child(5) { order: 1; padding-inline: 0 50%; }
    .benefit:nth-child(3) { order: 2; padding-inline: 50% 0; }
    .benefit:nth-child(2) { order: 3; padding-inline: 0 50%; }
    .benefit:nth-child(4) { order: 4; padding-inline: 50% 0; }
    .benefit:nth-child(1) { order: 5; padding-inline: 0 50%; }

    .benefit p { max-width: 10.5rem; }
  }
</style>
