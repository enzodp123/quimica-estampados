---
import { Icon } from "astro-icon/components";

const benefits = [
  {
    icon: "lucide:badge-check",
    title: "DTF de alta resolución",
    text: "Máxima definición y colores intensos.",
  },
  {
    icon: "lucide:truck",
    title: "Logística",
    text: "Envíos rápidos a cualquier punto del país.",
  },
  {
    icon: "lucide:layers-3",
    title: "Materiales premium",
    text: "Insumos de calidad para resultados duraderos.",
  },
  {
    icon: "lucide:headphones",
    title: "Atención personalizada",
    text: "Te acompañamos desde la idea hasta la entrega.",
  },
  {
    icon: "lucide:store",
    title: "Local físico",
    text: "Asesoramiento presencial para cada proyecto.",
  },
];
---

<section class="benefits" aria-label="Beneficios de trabajar con nosotros">
  <div class="benefits__inner">
    {benefits.map(({ icon, title, text }) => (
      <article class="benefit">
        <Icon class="benefit__icon" name={icon} aria-hidden="true" />
        <h2>{title}</h2>
        <p>{text}</p>
      </article>
    ))}
  </div>
</section>

<style>
  .benefits {
    width: 100%;
    height: 20.8125rem;
    display: grid;
    place-items: center;
    background: var(--color-background);
    border-top: 0.0625rem solid var(--color-border);
  }

  .benefits__inner {
    width: min(calc(100% - (var(--container-padding) * 2)), var(--container-width));
    margin-inline: auto;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    align-items: start;
    gap: clamp(1rem, 2.5vw, 3rem);
  }

  .benefit {
    min-width: 0;
    padding-inline: 0.25rem;
    text-align: center;
  }

  .benefit__icon {
    width: 1.75rem;
    height: 1.75rem;
    margin-inline: auto;
    margin-bottom: 0.875rem;
    display: block;
    color: var(--color-cyan);
    stroke-width: 1.35;
  }

  .benefit:nth-child(2) .benefit__icon {
    color: var(--color-magenta);
  }

  .benefit:nth-child(3) .benefit__icon {
    color: var(--color-yellow);
  }

  .benefit:nth-child(4) .benefit__icon {
    color: var(--color-text);
  }

  .benefit h2 {
    margin: 0 0 0.5rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: boldz82lzv;
    letter-spacing: 0.046875rem;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .benefit p {
    max-width: 13.5rem;
    margin-inline: auto;
    color: #c2c2c2;
    font-family: var(--font-poppins);
    font-size: 0.875rem;
    font-weight: 400;
    line-height: 1.35;
  }

  @media (max-width: 56.25rem) {
    .benefits {
      height: auto;
      min-height: 20.8125rem;
      padding-block: 4rem;
    }

    .benefits__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 3.5rem 1.5rem;
    }

    .benefit:last-child {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 35rem) {
    .benefits {
      padding-block: 3.5rem;
    }

    .benefits__inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .benefit:last-child {
      grid-column: auto;
    }
  }
</style>
