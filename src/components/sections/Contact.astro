---
import { Icon } from "astro-icon/components";
import BackgroundText from "../shared/BackgroundText.astro";
---

<section id="contacto" class="contact" aria-labelledby="contact-heading">
  <BackgroundText />

  <div class="contact__rail" aria-hidden="true">Contactanos</div>
  <h2 id="contact-heading" class="contact__title">Resolvemos<br />tus dudas</h2>

  <div class="contact__content">
    <header class="contact__header">
      <div class="contact__dots" aria-hidden="true"><span></span><span></span><span></span></div>
      <h3>Estamos para ayudarte</h3>
      <p>Resolvemos tus dudas sobre producción industrial y procesos<br />técnicos para optimizar tus pedidos.</p>
    </header>

    <div class="contact__layout">
      <form class="contact__form" action="#" method="post">
        <label>
          <span>Nombre</span>
          <input type="text" name="name" placeholder="Tu nombre" autocomplete="name" required />
        </label>
        <label>
          <span>Email</span>
          <input type="email" name="email" placeholder="hola@empresa.com" autocomplete="email" required />
        </label>
        <label class="contact__field--wide">
          <span>Proyecto</span>
          <select name="project">
            <option>DTF Textil</option>
            <option>Corpóreos en polifan</option>
            <option>Calcos y tarjetas personalizadas</option>
          </select>
        </label>
        <label class="contact__field--wide contact__message">
          <span>Mensaje</span>
          <textarea name="message" rows="4" placeholder="Contanos detalles de cantidades, colores y superficies..." required></textarea>
        </label>
        <button class="contact__submit" type="submit">Enviar</button>
        <span class="contact__form-line" aria-hidden="true"></span>
      </form>

      <aside class="contact__aside">
        <section class="contact__info-block">
          <h4>Canales directos</h4>
          <a href="mailto:quimicaestampados@gmail.com"><Icon name="lucide:mail" aria-hidden="true" /><span>quimicaestampados@gmail.com</span></a>
          <a href="https://wa.me/5493431234567"><Icon name="lucide:message-circle" aria-hidden="true" /><span>WhatsApp: +54 9 343 123 4567</span></a>
        </section>

        <section class="contact__info-block contact__hours">
          <h4>Horarios</h4>
          <p>Lunes a viernes<br />08:00 a 12:00 hrs<br />16:30 a 20:00 hrs</p>
        </section>

        <nav class="contact__socials" aria-label="Redes sociales">
          <span aria-hidden="true"><Icon name="lucide:share-2" /></span>
          <a href="#">Instagram <Icon name="lucide:external-link" aria-hidden="true" /></a>
          <a href="#">Facebook <Icon name="lucide:external-link" aria-hidden="true" /></a>
        </nav>

        <div class="contact__map">
          <iframe
            title="Ubicación de Química Estampados en Victoria, Entre Ríos"
            src="https://www.google.com/maps?q=66%20Alem%2C%20Victoria%2C%20Entre%20R%C3%ADos&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact {
    --contact-heading-bottom: 6.25rem;
    position: relative;
    isolation: isolate;
    width: 100%;
    min-height: clamp(46rem, 64vw, 76rem);
    overflow: hidden;
    background: var(--color-background);
  }

  .contact__rail {
    position: absolute;
    bottom: var(--contact-heading-bottom);
    left: var(--editorial-rail-left);
    z-index: 2;
    color: var(--color-magenta);
    font-family: var(--font-montserrat);
    font-size: var(--vertical-title-font-size);
    font-weight: var(--vertical-title-font-weight);
    letter-spacing: -0.045em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .contact__title {
    position: absolute;
    bottom: var(--contact-heading-bottom);
    left: var(--editorial-title-left);
    z-index: 2;
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .contact__content {
    width: min(64.5vw, 77.5rem);
    margin-left: max(17.75vw, calc((100% - 77.5rem) / 2));
    padding-top: clamp(3rem, 5.5vw, 6.5rem);
  }

  .contact__header { margin-bottom: 2.15rem; }

  .contact__dots {
    margin-bottom: 0.65rem;
    display: flex;
    gap: 0.2rem;
  }

  .contact__dots span {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-cyan);
  }

  .contact__dots span:nth-child(2) { background: var(--color-magenta); }
  .contact__dots span:nth-child(3) { background: var(--color-yellow); }

  .contact__header h3 {
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .contact__header p {
    margin-top: 0.8rem;
    color: #dededc;
    font-family: var(--font-jetbrains-mono);
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.55;
    text-transform: uppercase;
  }

  .contact__layout {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    align-items: start;
    gap: clamp(2rem, 3.75vw, 4.5rem);
  }

  .contact__form {
    position: relative;
    min-height: 32.75rem;
    padding: 2.25rem 2rem 3.25rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-auto-rows: min-content;
    column-gap: 2.5rem;
    row-gap: 1.7rem;
    background: rgba(9, 9, 9, 0.84);
    border: 0.0625rem solid var(--color-border);
  }

  .contact__form label { display: block; min-width: 0; }

  .contact__form label > span {
    display: block;
    color: var(--color-magenta);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    line-height: 1;
    text-transform: uppercase;
  }

  .contact__form input,
  .contact__form select,
  .contact__form textarea {
    width: 100%;
    margin-top: 0.65rem;
    padding: 0.85rem 0.45rem;
    color: var(--color-text);
    background: transparent;
    border: 0;
    border-bottom: 0.0625rem solid rgba(255, 255, 255, 0.12);
    border-radius: 0;
    outline: none;
    font-family: var(--font-poppins);
    font-size: 0.72rem;
  }

  .contact__form input::placeholder,
  .contact__form textarea::placeholder { color: #555; opacity: 1; }

  .contact__form select {
    appearance: auto;
    color-scheme: dark;
  }

  .contact__form textarea {
    min-height: 7.75rem;
    resize: vertical;
  }

  .contact__form input:focus,
  .contact__form select:focus,
  .contact__form textarea:focus { border-color: var(--color-magenta); }

  .contact__field--wide { grid-column: 1 / -1; }

  .contact__submit {
    width: 10.875rem;
    min-height: 2.875rem;
    margin-top: 0.2rem;
    color: var(--color-magenta);
    background: transparent;
    border: 0.0625rem solid var(--color-magenta);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .contact__submit:hover,
  .contact__submit:focus-visible { color: #050505; background: var(--color-magenta); }

  .contact__form-line {
    position: absolute;
    right: 29%;
    bottom: 2.25rem;
    width: 33%;
    height: 0.0625rem;
    background: var(--color-magenta);
  }

  .contact__aside { min-width: 0; }

  .contact__info-block {
    padding-left: 1rem;
    border-left: 0.125rem solid var(--color-magenta);
  }

  .contact__info-block h4 {
    margin-bottom: 0.8rem;
    color: var(--color-magenta);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .contact__info-block a {
    min-width: 0;
    margin-top: 0.55rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: #9a9a98;
    font-family: var(--font-poppins);
    font-size: 0.68rem;
  }

  .contact__info-block a :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    flex: 0 0 0.9rem;
  }

  .contact__info-block a span {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .contact__hours { margin-top: 2.3rem; }

  .contact__hours p {
    color: #d2d2d0;
    font-family: var(--font-poppins);
    font-size: 0.7rem;
    line-height: 1.65;
  }

  .contact__socials {
    margin-top: 3.25rem;
    display: grid;
    grid-template-columns: 2.5rem 1fr 1fr;
    gap: 0.65rem;
  }

  .contact__socials span,
  .contact__socials a {
    min-height: 2.65rem;
    padding: 0.6rem 0.9rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #d1d1cf;
    border: 0.0625rem solid var(--color-border);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.57rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact__socials span { padding: 0; justify-content: center; }
  .contact__socials :global(svg) { width: 0.85rem; height: 0.85rem; }

  .contact__map {
    width: 100%;
    height: 15rem;
    margin-top: 5rem;
    overflow: hidden;
    border: 0.0625rem solid var(--color-border);
  }

  .contact__map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.15) invert(0.92) hue-rotate(180deg) brightness(0.62) contrast(1.18) saturate(0.85);
  }

  @media (min-width: 64.0625rem) {
    .contact {
      --contact-heading-bottom: 2rem;
      --background-text-inset: 9.5rem 0 12rem var(--watermark-left);
      --watermark-font-size: clamp(6rem, 9.5vw, 11.4rem);
      --watermark-left: 4.2vw;
      height: 69rem;
      min-height: 69rem;
    }

    .contact__content {
      width: min(66.9vw, 80.25rem);
      margin-left: max(27.9vw, calc(94.8vw - 80.25rem));
      padding-top: clamp(3.5rem, 4.58vw, 5.5rem);
    }

    .contact__header { margin-bottom: clamp(2.15rem, 3.7vw, 4.4375rem); }

    .contact__dots { gap: 0.3125rem; }

    .contact__dots span {
      width: clamp(0.75rem, 0.73vw, 0.875rem);
      height: clamp(0.75rem, 0.73vw, 0.875rem);
    }

    .contact__header h3 { font-size: clamp(1.5rem, 1.67vw, 2rem); }
    .contact__header p {
      font-size: clamp(0.75rem, 0.835vw, 1rem);
      line-height: 1.55;
    }

    .contact__layout {
      grid-template-columns: minmax(0, 1.425fr) minmax(0, 1fr);
      gap: clamp(3.5rem, 4.05vw, 4.875rem);
    }

    .contact__form {
      min-height: clamp(32.75rem, 35.73vw, 42.875rem);
      padding: clamp(2.25rem, 2.7vw, 3.25rem) clamp(2rem, 1.77vw, 2.125rem) 3.25rem;
      column-gap: 2rem;
      row-gap: clamp(1.7rem, 2.065vw, 2.475rem);
    }

    .contact__form label > span {
      font-size: 0.875rem;
      line-height: 1;
    }

    .contact__form input,
    .contact__form select,
    .contact__form textarea {
      padding-block: 0.75rem;
      font-size: 1rem;
      line-height: 1.5;
    }

    .contact__form textarea { min-height: clamp(7.75rem, 7.25vw, 8.6875rem); }

    .contact__submit {
      width: clamp(10.875rem, 11.77vw, 14.125rem);
      min-height: clamp(2.875rem, 2.865vw, 3.4375rem);
      margin-top: clamp(0.2rem, 1.41vw, 1.6875rem);
      font-size: 0.75rem;
      line-height: 1.15;
    }

    .contact__form-line {
      right: auto;
      bottom: 3rem;
      left: 30%;
      width: 40%;
    }

    .contact__aside { margin-top: clamp(-10.25rem, -8.55vw, -5rem); }

    .contact__info-block h4 {
      margin-bottom: 1.7rem;
      font-size: 0.875rem;
      line-height: 1;
    }

    .contact__info-block a {
      font-size: 0.875rem;
      line-height: 1.5;
    }
    .contact__aside > .contact__info-block:first-child { min-height: 7.5rem; }

    .contact__hours {
      min-height: 7rem;
      margin-top: 1.875rem;
    }

    .contact__hours p {
      font-size: 0.875rem;
      line-height: 1.65;
    }

    .contact__socials {
      margin-top: 4.75rem;
      grid-template-columns: 3.25rem 1fr 1fr;
      gap: 1rem;
    }

    .contact__socials span,
    .contact__socials a {
      min-height: 3.25rem;
      font-size: 0.75rem;
      line-height: 1.15;
    }

    .contact__map {
      height: 19.5rem;
      margin-top: 9.125rem;
    }
  }

  @media (min-width: 40.0625rem) and (max-width: 64rem) {
    .contact {
      width: calc(100% - 3rem);
      height: 69rem;
      min-height: 0;
      margin-inline: auto;
    }

    .contact__content {
      position: absolute;
      top: 5.3125rem;
      left: 8.402%;
      width: 83.197%;
      margin: 0;
      padding: 0;
    }

    .contact__header { width: 87.069%; margin-bottom: 5.25rem; }
    .contact__header h3 { font-size: 2rem; }
    .contact__header p { font-size: 1rem; line-height: 1.75; }
    .contact__header p br { display: none; }

    .contact__layout {
      grid-template-columns: minmax(0, 1.7304fr) minmax(0, 1fr);
      gap: clamp(2rem, 6.25vw, 4rem);
    }

    .contact__form {
      min-height: 39.375rem;
      padding: 2.0625rem 1.5625rem;
      column-gap: 2rem;
      row-gap: 2.625rem;
    }

    .contact__form label > span { font-size: 0.875rem; }
    .contact__form input,
    .contact__form select,
    .contact__form textarea { font-size: 1rem; }
    .contact__submit { width: 14.125rem; min-height: 3.4375rem; font-size: 0.875rem; }

    .contact__aside { margin-top: -9.75rem; }
    .contact__info-block h4 { font-size: 1rem; }
    .contact__info-block a,
    .contact__hours p { font-size: 1rem; }
    .contact__socials { margin-top: 3rem; grid-template-columns: 3rem 1fr 1fr; gap: 1rem; }
    .contact__socials span,
    .contact__socials a { min-height: 3rem; font-size: 0.75rem; }
    .contact__map { height: 14.5rem; margin-top: 3rem; }

    .contact__rail { left: 0; bottom: 0; font-size: 3rem; }
    .contact__title { left: 3.875rem; bottom: 0; font-size: 2.25rem; line-height: 1.05; }
  }

  @media (min-width: 40.0625rem) and (max-width: 52rem) {
    .contact {
      height: 112rem;
    }

    .contact__content {
      top: 4rem;
      left: 6%;
      width: 88%;
    }

    .contact__header {
      width: 100%;
      margin-bottom: 3rem;
    }

    .contact__layout {
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .contact__form {
      width: 100%;
    }

    .contact__aside {
      margin-top: 0;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .contact__hours,
    .contact__socials,
    .contact__map { margin-top: 0; }

    .contact__map { width: 100%; }
  }

  @media (max-width: 40rem) {
    .contact {
      width: calc(100% - 1.5rem);
      height: 126.8125rem;
      min-height: 0;
      margin-inline: auto;
      padding-top: 3rem;
    }

    .contact__content {
      position: static;
      width: 100%;
      margin: 0;
      padding: 0;
    }

    .contact__header { min-height: 9.625rem; margin-bottom: 1.5rem; padding-right: 0.625rem; }
    .contact__header h3 { font-size: 1.25rem; }
    .contact__header p { font-size: 1rem; line-height: 1.75; letter-spacing: 0.05625rem; }
    .contact__header p br { display: none; }
    .contact__layout { display: flex; flex-direction: column; gap: 1.5rem; }

    .contact__form {
      min-height: 46.875rem;
      padding: 1.8125rem 1.1875rem;
      grid-template-columns: 1fr;
      row-gap: 2rem;
    }

    .contact__form label > span { font-size: 0.875rem; }
    .contact__form input,
    .contact__form select,
    .contact__form textarea { min-height: 2.75rem; font-size: 1rem; }
    .contact__field--wide { grid-column: auto; }
    .contact__submit { width: 14.125rem; min-height: 3.4375rem; font-size: 0.875rem; }
    .contact__form-line { right: auto; left: 10%; bottom: 2.3125rem; width: 80%; }

    .contact__aside { display: flex; flex-direction: column; gap: 2rem; }
    .contact__info-block { padding-left: 1.125rem; }
    .contact__info-block h4 { font-size: 1rem; }
    .contact__info-block a,
    .contact__hours p { font-size: 1rem; }
    .contact__hours { margin-top: 0; }
    .contact__socials { margin-top: 0; grid-template-columns: 3rem 1fr; gap: 1rem; }
    .contact__socials a:last-child { grid-column: 2; }
    .contact__socials span,
    .contact__socials a { min-height: 3rem; font-size: 0.75rem; }
    .contact__map { width: 100%; height: 17rem; margin-top: 0; }

    .contact__rail { left: 0; bottom: 3rem; font-size: 2rem; }
    .contact__title { left: 2.75rem; bottom: 3rem; font-size: 1.25rem; line-height: 1.05; }
  }
</style>
