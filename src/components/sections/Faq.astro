---
import { Icon } from "astro-icon/components";
import BackgroundText from "../shared/BackgroundText.astro";

const questions = [
  {
    question: "¿Si no tengo un diseño, ustedes lo realizan?",
    title: "Diseño listo para producir",
    answer: "Sí. Podemos adaptar un archivo existente o desarrollar una propuesta desde cero. Antes de producir, te enviamos el diseño para que puedas aprobarlo.",
  },
  {
    question: "¿Sólo hacen estampado textil en remeras, buzos y camperas?",
    title: "Calidad que se mantiene con el tiempo",
    answer: "No, realizamos estampados y personalizaciones en otros productos o telas también para diferentes proyectos.",
  },
  {
    question: "¿Cómo tengo que enviar el diseño?",
    title: "Archivos listos para producción",
    answer: "Podés enviarnos tu archivo en formato AI, CDR, PDF, EPS o SVG. También puede ser PNG en alta resolución.",
  },
  {
    question: "¿Qué demora tienen en entregas?",
    title: "Plazos según cada proyecto",
    answer: "La demora depende de las cantidades, los materiales y la técnica elegida. Confirmamos la fecha de entrega con la cotización, antes de comenzar la producción.",
  },
  {
    question: "¿Qué telas trabajan?",
    title: "La tela adecuada para cada uso",
    answer: "Trabajamos con distintas opciones según la prenda, el uso y la terminación buscada. Te asesoramos para elegir el material más conveniente para tu proyecto.",
  },
  {
    question: "¿Qué estampas realizan?",
    title: "Una técnica para cada necesidad",
    answer: "Realizamos DTF, sublimación y otras personalizaciones. La técnica se define según el diseño, el material, la cantidad y el resultado que necesites.",
  },
  {
    question: "¿Tienen local físico?",
    title: "Atención presencial en Victoria",
    answer: "Sí. Podés visitarnos en 66 Alem, Victoria, Entre Ríos, dentro de los horarios publicados en la sección de contacto.",
  },
  {
    question: "¿Tienen descuento por cantidad?",
    title: "Cotización según volumen",
    answer: "Cotizamos cada pedido según la cantidad, el producto y la técnica. Escribinos para recibir la alternativa más conveniente para tu proyecto.",
  },
];

const initialQuestionIndex = 1;
const initialQuestion = questions[initialQuestionIndex];
---

<section id="preguntas" class="faq-section" aria-labelledby="faq-heading">
  <BackgroundText />

  <header class="faq-header">
    <div class="faq-header__dots" aria-hidden="true"><span></span><span></span><span></span></div>
    <h2 id="faq-heading">Resolvemos tus dudas</h2>
    <p>
      Resolvemos tus dudas sobre producción industrial y procesos técnicos<br />
      para optimizar tus pedidos.
    </p>
  </header>

  <div class="faq-content">
    <div class="faq-list" role="tablist" aria-label="Preguntas frecuentes" aria-orientation="vertical">
      {questions.map(({ question, title, answer }, index) => (
        <button
          id={`faq-tab-${index}`}
          class:list={["faq-list__item", { "is-active": index === initialQuestionIndex }]}
          type="button"
          role="tab"
          aria-selected={index === initialQuestionIndex ? "true" : "false"}
          aria-controls="faq-answer-panel"
          tabindex={index === initialQuestionIndex ? 0 : -1}
          data-faq-tab
          data-faq-title={title}
          data-faq-answer={answer}
        >
          <span>{question}</span>
          <Icon name="lucide:external-link" aria-hidden="true" />
        </button>
      ))}
    </div>

    <aside
      id="faq-answer-panel"
      class="faq-card"
      role="tabpanel"
      aria-live="polite"
      aria-labelledby={`faq-tab-${initialQuestionIndex}`}
    >
      <Icon name="lucide:external-link" aria-hidden="true" />
      <p class="faq-card__question">{initialQuestion.question}</p>
      <h3>{initialQuestion.title}</h3>
      <p class="faq-card__answer">{initialQuestion.answer}</p>
      <span class="faq-card__line" aria-hidden="true"></span>
    </aside>
  </div>

  <div class="faq-label">
    <span aria-hidden="true">Soporte</span>
    <h3>Preguntas<br />frecuentes</h3>
  </div>
</section>

<script>
  const faqTabs = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-faq-tab]"));
  const faqPanel = document.querySelector<HTMLElement>("#faq-answer-panel");
  const faqQuestion = faqPanel?.querySelector<HTMLElement>(".faq-card__question");
  const faqTitle = faqPanel?.querySelector<HTMLElement>("h3");
  const faqAnswer = faqPanel?.querySelector<HTMLElement>(".faq-card__answer");

  const selectFaq = (tab: HTMLButtonElement, moveFocus = false) => {
    faqTabs.forEach((item) => {
      const isSelected = item === tab;
      item.classList.toggle("is-active", isSelected);
      item.setAttribute("aria-selected", String(isSelected));
      item.tabIndex = isSelected ? 0 : -1;
    });

    if (faqPanel) faqPanel.setAttribute("aria-labelledby", tab.id);
    if (faqQuestion) faqQuestion.textContent = tab.textContent?.trim() ?? "";
    if (faqTitle) faqTitle.textContent = tab.dataset.faqTitle ?? "";
    if (faqAnswer) faqAnswer.textContent = tab.dataset.faqAnswer ?? "";
    if (moveFocus) tab.focus();
  };

  faqTabs.forEach((tab, index) => {
    tab.addEventListener("click", () => selectFaq(tab));
    tab.addEventListener("keydown", (event) => {
      let nextIndex: number | undefined;

      if (event.key === "ArrowDown" || event.key === "ArrowRight") nextIndex = (index + 1) % faqTabs.length;
      if (event.key === "ArrowUp" || event.key === "ArrowLeft") nextIndex = (index - 1 + faqTabs.length) % faqTabs.length;
      if (event.key === "Home") nextIndex = 0;
      if (event.key === "End") nextIndex = faqTabs.length - 1;

      if (nextIndex !== undefined) {
        event.preventDefault();
        selectFaq(faqTabs[nextIndex], true);
      }
    });
  });
</script>

<style>
  .faq-section {
    --faq-gutter: clamp(1rem, 5.3vw, 6.4rem);
    --faq-content-left: clamp(9rem, 21.65vw, 26rem);
    --background-text-inset: clamp(7rem, 9.7vw, 11.6rem) 0 clamp(7rem, 9vw, 10.8rem) var(--watermark-left);
    position: relative;
    isolation: isolate;
    height: 69rem;
    min-height: 69rem;
    overflow: hidden;
    padding-top: clamp(6rem, 8vw, 9.6rem);
    background: var(--color-background);
  }

  .faq-header,
  .faq-content,
  .faq-label {
    position: relative;
    z-index: 1;
  }

  .faq-header {
    width: fit-content;
    margin-left: var(--faq-content-left);
  }

  .faq-header__dots {
    margin-bottom: clamp(0.45rem, 0.7vw, 0.82rem);
    display: flex;
    gap: 0.2rem;
  }

  .faq-header__dots span {
    width: clamp(0.55rem, 0.68vw, 0.8rem);
    height: clamp(0.55rem, 0.68vw, 0.8rem);
    border-radius: 50%;
    background: var(--color-cyan);
  }

  .faq-header__dots span:nth-child(2) { background: var(--color-magenta); }
  .faq-header__dots span:nth-child(3) { background: var(--color-yellow); }

  .faq-header h2 {
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: clamp(1.25rem, 1.875vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.0833;
    text-transform: uppercase;
  }

  .faq-header p {
    margin-top: clamp(0.65rem, 0.72vw, 0.86rem);
    color: #dededc;
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.75rem, 0.8333vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.055em;
    line-height: 1.75;
    text-transform: uppercase;
  }

  .faq-content {
    margin: clamp(3.2rem, 3.6vw, 4.3rem) 0 0 var(--faq-content-left);
    display: grid;
    grid-template-columns: minmax(31rem, 37.5rem) minmax(29rem, 36rem);
    gap: clamp(2rem, 3.35vw, 4rem);
    align-items: start;
  }

  .faq-list {
    display: grid;
    gap: clamp(0.4rem, 0.48vw, 0.58rem);
  }

  .faq-list__item {
    width: 100%;
    min-height: clamp(2.25rem, 2.55vw, 3.05rem);
    padding: 0 clamp(0.8rem, 1.15vw, 1.35rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: #ddddda;
    background: rgba(12, 12, 12, 0.76);
    border: 0.0625rem solid var(--color-border);
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.75rem, 0.7292vw, 0.875rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.1429;
    text-align: left;
    text-transform: uppercase;
    cursor: pointer;
    transition: color var(--transition), border-color var(--transition), background var(--transition);
  }

  .faq-list__item:hover,
  .faq-list__item:focus-visible {
    color: #f2f2ef;
    border-color: var(--color-yellow);
    outline: none;
  }

  .faq-list__item.is-active {
    color: #f2f2ef;
    background: rgba(19, 19, 19, 0.72);
    border-color: var(--color-border);
  }

  .faq-list__item :global(svg) {
    width: clamp(0.72rem, 0.78vw, 0.92rem);
    height: clamp(0.72rem, 0.78vw, 0.92rem);
    flex: 0 0 auto;
    color: #f0f0ed;
    stroke-width: 1.4;
  }

  .faq-card {
    min-height: clamp(15.5rem, 18vw, 21.5rem);
    margin-top: clamp(2.8rem, 2.9vw, 3.45rem);
    padding: clamp(1.65rem, 1.85vw, 2.2rem);
    display: flex;
    flex-direction: column;
    background: rgba(13, 13, 13, 0.92);
    border: 0.0625rem solid var(--color-border);
  }

  .faq-card > :global(svg) {
    width: clamp(0.85rem, 0.9vw, 1.05rem);
    height: clamp(0.85rem, 0.9vw, 1.05rem);
    color: var(--color-yellow);
    stroke-width: 1.4;
  }

  .faq-card__question {
    margin-top: clamp(1.5rem, 1.8vw, 2.15rem);
    color: #dededb;
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.6875rem, 0.6771vw, 0.8125rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2308;
    text-transform: uppercase;
  }

  .faq-card h3 {
    margin-top: clamp(0.8rem, 0.9vw, 1.05rem);
    color: var(--color-yellow);
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.875rem, 1.0417vw, 1.25rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .faq-card__answer {
    margin-top: clamp(0.65rem, 0.72vw, 0.86rem);
    color: #9a9a98;
    font-family: var(--font-poppins);
    font-size: clamp(0.875rem, 0.8333vw, 1rem);
    line-height: 1.5;
  }

  .faq-card__line {
    width: clamp(8rem, 10.5vw, 12.5rem);
    height: 0.0625rem;
    margin: auto auto 0;
    background: var(--color-yellow);
  }

  .faq-label {
    position: absolute;
    bottom: clamp(4rem, 4.8vw, 5.75rem);
    left: var(--faq-gutter);
    height: clamp(19rem, 19vw, 22.75rem);
    display: flex;
    align-items: end;
  }

  .faq-label > span {
    position: absolute;
    bottom: 0;
    left: 0;
    color: var(--color-yellow);
    font-family: var(--font-montserrat);
    font-size: 4.5rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .faq-label h3 {
    margin-left: 4rem;
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: clamp(1.4rem, 1.875vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.0833;
    text-transform: uppercase;
  }

  @media (min-width: 40.0625rem) and (max-width: 64rem) {
    .faq-section {
      width: calc(100% - 3rem);
      height: 60.75rem;
      min-height: 0;
      margin-inline: auto;
      padding: 0;
    }

    .faq-header {
      position: absolute;
      top: 3.875rem;
      left: 3.074%;
      width: 87.09%;
      margin: 0;
    }
    .faq-header h2 { font-size: 1.5rem; }
    .faq-header p { font-size: 1rem; line-height: 1.75; }
    .faq-header p br { display: none; }

    .faq-content {
      position: absolute;
      top: 14.25rem;
      left: 3.074%;
      width: 89.754%;
      margin: 0;
      display: grid;
      grid-template-columns: minmax(0, 54.224%) minmax(0, 44.292%);
      gap: 1.484%;
    }
    .faq-list { gap: 0.75rem; }
    .faq-list__item { min-height: 3rem; padding-inline: 0.8125rem; font-size: 0.875rem; }
    .faq-card { width: 100%; min-height: 22.5rem; margin-top: 1.0625rem; padding: 3.0625rem 2.0625rem; }
    .faq-card__question { font-size: 0.8125rem; }
    .faq-card h3 { font-size: 1rem; line-height: 1.75; }
    .faq-card__answer { font-size: 1rem; line-height: 1.5; }

    .faq-label { left: 0; bottom: 0; height: 15.25rem; }
    .faq-label > span { bottom: 0; font-size: 3rem; }
    .faq-label h3 { margin-left: 3.6875rem; font-size: 2.25rem; line-height: 1.05; }
  }

  @media (min-width: 40.0625rem) and (max-width: 52rem) {
    .faq-section { height: 82rem; }

    .faq-header {
      top: 4rem;
      left: 6%;
      width: 88%;
    }

    .faq-content {
      top: 14rem;
      left: 6%;
      width: 88%;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }

    .faq-card {
      min-height: 20.5rem;
      margin-top: 0;
    }
  }

  @media (max-width: 40rem) {
    .faq-section {
      width: calc(100% - 1.5rem);
      height: 86.4375rem;
      min-height: 0;
      margin-inline: auto;
      padding-block: 3rem;
    }

    .faq-header { width: 100%; margin: 0; }
    .faq-header h2 { font-size: 1.25rem; }
    .faq-header p { font-size: 1rem; line-height: 1.75; }
    .faq-header p br { display: none; }

    .faq-content {
      width: 100%;
      margin: 1.5rem 0 0;
      display: flex;
      flex-direction: column;
      gap: 2rem;
    }
    .faq-list { gap: 0.75rem; }
    .faq-list__item { min-height: 3rem; padding-inline: 0.4375rem; font-size: 0.8125rem; }
    .faq-card { width: 100%; min-height: 20.5rem; margin: 0; padding: 1.5625rem 0.8125rem 2.0625rem; }
    .faq-card__question { font-size: 0.8125rem; }
    .faq-card h3 { font-size: 1rem; line-height: 1.75; }
    .faq-card__answer { font-size: 1rem; line-height: 1.5; }

    .faq-label {
      position: absolute;
      left: 0;
      bottom: 3rem;
      height: 10.1875rem;
      display: flex;
      align-items: end;
      gap: 0.3125rem;
    }
    .faq-label > span { position: static; display: block; font-size: 2rem; }
    .faq-label h3 { margin: 0; font-size: 1.25rem; line-height: 1.05; }
  }
</style>
