---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import workshop from "../../assets/images/comotrabajamos.png";

const process = [
  {
    number: "01",
    title: "Datos del pedido",
    text: "Contanos qué necesitás, qué cantidad y para qué proyecto. Te asesoramos de manera personalizada para definir juntos las mejores opciones y resolver todas tus dudas.",
    icon: "lucide:file-text",
    tone: "cyan",
  },
  {
    number: "02",
    title: "Diseño",
    text: "Podés enviarnos tu archivo en formato AI, CDR, PDF, EPS o SVG. También puede ser PNG en alta resolución.",
    note: "Si no contás con un archivo listo para producción, no hay problema! Nuestro equipo de diseño puede adaptarlo y crear tu diseño desde cero.",
    icon: "lucide:pen-line",
    tone: "magenta",
  },
  {
    number: "03",
    title: "Producción",
    text: "Una vez aprobado el diseño, seleccionamos los materiales y la técnica de estampado o impresión más adecuada para tu proyecto. Nos ocupamos de cada detalle para lograr un producto de calidad.",
    icon: "lucide:sliders-horizontal",
    tone: "yellow",
  },
  {
    number: "04",
    title: "Envío",
    text: "Coordinamos el envío según bulto y destino, para que recibas tu producto terminado en las mejores condiciones.",
    icon: "lucide:package",
    tone: "white",
  },
];
---

<section id="proceso" class="industrial" aria-labelledby="industrial-heading">
  <div class="industrial__rail" aria-hidden="true">Como trabajamos</div>
  <h2 id="industrial-heading" class="industrial__title">Paso<br />a paso</h2>

  <div class="industrial__stage">
    <div class="industrial__image-wrap">
      <Image
        class="industrial__image"
        src={workshop}
        alt="Interior del local de Química Estampados"
        loading="lazy"
        widths={[480, 720, 960]}
        sizes="(max-width: 64rem) 88vw, 36rem"
      />
    </div>

    <div class="process-list">
      {process.map(({ number, title, text, note, icon, tone }) => (
        <article class:list={["process-step", `process-step--${tone}`]}>
          <span class="process-step__number">{number}</span>
          <div class="process-step__card">
            <div class="process-step__heading">
              <h3>{title}</h3>
              <Icon name={icon} aria-hidden="true" />
            </div>
            <p>{text}</p>
            {note && <p class="process-step__note">{note}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>

</section>

<style>
  .industrial {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 66.875rem;
    overflow: hidden;
    background: var(--color-background);
  }

  .industrial__rail {
    position: absolute;
    bottom: 0;
    left: 3.6458%;
    z-index: 2;
    color: var(--color-magenta);
    font-family: var(--font-montserrat);
    font-size: clamp(3.5rem, 3.75vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .industrial__title {
    position: absolute;
    bottom: 0.375rem;
    left: 8.2292%;
    z-index: 2;
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: clamp(2.5rem, 2.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.33;
    text-transform: uppercase;
  }

  .industrial__stage {
    display: contents;
  }

  .industrial__image-wrap {
    position: absolute;
    top: 10.625rem;
    left: 18.9063%;
    width: 30.4167%;
  }

  .industrial__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .process-list {
    position: absolute;
    top: 1.75rem;
    left: 56.4063%;
    width: 39.1667%;
    display: grid;
    gap: 0;
  }

  .process-step {
    --step-color: var(--color-text);
    min-width: 0;
    position: relative;
    z-index: 1;
    padding-left: 6.0625rem;
    padding-bottom: 3rem;
  }

  .process-step:last-child { padding-bottom: 0; }

  .process-step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 2.5rem;
    bottom: 0;
    left: 1.25rem;
    z-index: -1;
    border-left: 0.0625rem solid rgba(255, 255, 255, 0.16);
  }

  .process-step--cyan { --step-color: var(--color-cyan); }
  .process-step--magenta { --step-color: var(--color-magenta); }
  .process-step--yellow { --step-color: var(--color-yellow); }

  .process-step__number {
    position: absolute;
    top: 0;
    left: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    color: var(--step-color);
    background: var(--color-background);
    border: 0.0625rem solid var(--color-border);
    font-family: var(--font-jetbrains-mono);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1;
  }

  .process-step__card {
    min-height: 11.875rem;
    padding: 2.0625rem 2.5625rem;
    background: rgba(19, 19, 19, 0.5);
    border: 0.0625rem solid #353534;
    backdrop-filter: blur(0.125rem);
  }

  .process-step__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--step-color);
  }

  .process-step__heading h3 {
    font-family: var(--font-jetbrains-mono);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .process-step__heading svg {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    stroke-width: 1.75;
  }

  .process-step__card > p {
    max-width: 35.75rem;
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.87);
    font-family: var(--font-poppins);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.625;
  }

  .process-step__card > .process-step__note {
    margin-top: 0.75rem;
    color: var(--color-magenta);
    font-size: 0.8125rem;
    letter-spacing: 0;
    line-height: 1.6;
  }

  @media (max-width: 80rem) {
    .industrial {
      height: auto;
      min-height: 70rem;
      padding: 6rem 3rem 11rem 12rem;
    }

    .industrial__stage {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(20rem, 0.9fr) minmax(27rem, 1.1fr);
      gap: 3rem;
      align-items: center;
    }

    .industrial__image-wrap,
    .process-list {
      position: static;
      width: 100%;
    }

    .process-step { padding-left: 3.5rem; }
    .process-step__card { padding-inline: 1.75rem; }
  }

  @media (max-width: 64rem) {
    .industrial {
      height: auto;
      min-height: 0;
      padding: 5rem clamp(1.5rem, 5vw, 4rem) 6rem;
    }

    .industrial__rail { display: none; }

    .industrial__title {
      position: static;
      margin-bottom: 3rem;
      font-size: clamp(2.5rem, 7vw, 4rem);
    }

    .industrial__stage {
      width: 100%;
      height: auto;
      grid-template-columns: minmax(16rem, 0.8fr) minmax(24rem, 1.2fr);
      gap: 2rem;
    }

    .process-step { padding-left: 3rem; padding-bottom: 1rem; }
    .process-step__number { width: 2rem; height: 2rem; font-size: 0.875rem; }
    .process-step:not(:last-child)::after { top: 2rem; left: 1rem; }
    .process-step__card { min-height: 0; padding: 1.5rem; }

  }

  @media (max-width: 46rem) {
    .industrial__stage { grid-template-columns: 1fr; gap: 2.5rem; }
    .industrial__image-wrap { width: min(100%, 30rem); }
    .process-step__heading h3 { font-size: 1rem; }
    .process-step__card > p { font-size: 0.875rem; }
  }
</style>
