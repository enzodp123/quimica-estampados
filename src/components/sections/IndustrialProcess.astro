---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import workshop from "../../assets/images/comotrabajamos.png";
import BackgroundText from "../shared/BackgroundText.astro";

const process = [
  {
    number: "01",
    title: "Datos del pedido",
    text: "Contanos qué necesitás, qué cantidad y para qué proyecto. Te asesoramos de manera personalizada para definir juntos las mejores opciones y resolver todas tus dudas.",
    icon: "lucide:file-text",
    tone: "cyan",
  },
  {
    number: "02",
    title: "Diseño",
    text: "Podés enviarnos tu archivo en formato AI, CDR, PDF, EPS o SVG. También puede ser PNG en alta resolución.",
    note: "Si no contás con un archivo listo para producción, no hay problema! Nuestro equipo de diseño puede adaptarlo y crear tu diseño desde cero.",
    icon: "lucide:pen-line",
    tone: "magenta",
  },
  {
    number: "03",
    title: "Producción",
    text: "Una vez aprobado el diseño, seleccionamos los materiales y la técnica de estampado o impresión más adecuada para tu proyecto. Nos ocupamos de cada detalle para lograr un producto de calidad.",
    icon: "lucide:sliders-horizontal",
    tone: "yellow",
  },
  {
    number: "04",
    title: "Envío",
    text: "Coordinamos el envío según bulto y destino, para que recibas tu producto terminado en las mejores condiciones.",
    icon: "lucide:package",
    tone: "white",
  },
];
---

<section id="proceso" class="industrial" aria-labelledby="industrial-heading">
  <BackgroundText />
  <div class="industrial__rail" aria-hidden="true">Como trabajamos</div>
  <h2 id="industrial-heading" class="industrial__title">Paso<br />a paso</h2>

  <div class="industrial__stage">
    <div class="industrial__image-wrap">
      <Image
        class="industrial__image"
        src={workshop}
        alt="Interior del local de Química Estampados"
        loading="lazy"
        widths={[480, 720, 960]}
        sizes="(max-width: 64rem) 88vw, 36rem"
      />
    </div>

    <div class="process-list">
      {process.map(({ number, title, text, note, icon, tone }) => (
        <article class:list={["process-step", `process-step--${tone}`]}>
          <span class="process-step__number">{number}</span>
          <div class="process-step__card">
            <div class="process-step__heading">
              <h3>{title}</h3>
              <Icon name={icon} aria-hidden="true" />
            </div>
            <p>{text}</p>
            {note && <p class="process-step__note">{note}</p>}
          </div>
        </article>
      ))}
    </div>
  </div>

</section>

<style>
  .industrial {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 66.875rem;
    overflow: hidden;
    background: var(--color-background);
  }

  .industrial__rail {
    position: absolute;
    bottom: 0;
    left: 3.6458%;
    z-index: 2;
    color: var(--color-magenta);
    font-family: var(--font-montserrat);
    font-size: clamp(3.5rem, 3.75vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .industrial__title {
    position: absolute;
    bottom: 0.375rem;
    left: 8.2292%;
    z-index: 2;
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: clamp(2.5rem, 2.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.33;
    text-transform: uppercase;
  }

  .industrial__stage {
    display: contents;
  }

  .industrial__image-wrap {
    position: absolute;
    top: 10.625rem;
    left: 18.9063%;
    width: 30.4167%;
  }

  .industrial__image {
    width: 100%;
    height: auto;
    display: block;
  }

  .process-list {
    position: absolute;
    top: 1.75rem;
    left: 56.4063%;
    width: 39.1667%;
    display: grid;
    gap: 0;
  }

  .process-step {
    --step-color: var(--color-text);
    min-width: 0;
    position: relative;
    z-index: 1;
    padding-left: 6.0625rem;
    padding-bottom: 3rem;
  }

  .process-step:last-child { padding-bottom: 0; }

  .process-step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 2.5rem;
    bottom: 0;
    left: 1.25rem;
    z-index: -1;
    border-left: 0.0625rem solid rgba(255, 255, 255, 0.16);
  }

  .process-step--cyan { --step-color: var(--color-cyan); }
  .process-step--magenta { --step-color: var(--color-magenta); }
  .process-step--yellow { --step-color: var(--color-yellow); }

  .process-step__number {
    position: absolute;
    top: 0;
    left: 0;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    color: var(--step-color);
    background: var(--color-background);
    border: 0.0625rem solid var(--color-border);
    font-family: var(--font-jetbrains-mono);
    font-size: 1.125rem;
    font-weight: 400;
    line-height: 1;
  }

  .process-step__card {
    min-height: 11.875rem;
    padding: 2.0625rem 2.5625rem;
    background: rgba(19, 19, 19, 0.5);
    border: 0.0625rem solid #353534;
    backdrop-filter: blur(0.125rem);
  }

  .process-step__heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--step-color);
  }

  .process-step__heading h3 {
    font-family: var(--font-jetbrains-mono);
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .process-step__heading svg {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 auto;
    stroke-width: 1.75;
  }

  .process-step__card > p {
    max-width: 35.75rem;
    margin-top: 1rem;
    color: rgba(255, 255, 255, 0.87);
    font-family: var(--font-poppins);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.625;
  }

  .process-step__card > .process-step__note {
    margin-top: 0.75rem;
    color: var(--color-magenta);
    font-size: 0.8125rem;
    letter-spacing: 0;
    line-height: 1.6;
  }

  @media (min-width: 40.0625rem) and (max-width: 64rem) {
    .industrial {
      width: calc(100% - 3rem);
      height: 93.625rem;
      margin-inline: auto;
    }

    .industrial__stage { display: contents; }

    .process-list {
      top: 4.8125rem;
      left: 10.143%;
      width: 79.303%;
      height: 55rem;
      display: block;
    }

    .process-step {
      position: absolute;
      width: 66.667%;
      padding: 0 0 2rem 2.0625rem;
      border-left: 0.0625rem solid #222;
    }

    .process-step:nth-child(1) { top: 0; left: 0; }
    .process-step:nth-child(2) { top: 14.3125rem; left: 33.85%; padding-left: 2.3125rem; }
    .process-step:nth-child(3) { top: 32.5rem; left: -0.0625rem; }
    .process-step:nth-child(4) { top: 48.5rem; left: 33.85%; padding-left: 2rem; }

    .process-step:not(:last-child)::after {
      top: 2.5rem;
      bottom: -2.5rem;
      left: -0.0625rem;
      border-left-color: #222;
    }

    .process-step__number {
      top: 0;
      left: -1.25rem;
      width: 2.5rem;
      height: 2.5rem;
      font-size: 1.25rem;
    }

    .process-step__card {
      min-height: 0;
      padding: 2.0625rem 2.5625rem;
    }

    .process-step__heading h3 { font-size: 1.25rem; }
    .process-step__card > p { font-size: 1rem; line-height: 1.625; }

    .industrial__image-wrap {
      top: 67.8125rem;
      left: 20.389%;
      width: 59.016%;
      height: auto;
      aspect-ratio: 12 / 7;
      overflow: hidden;
    }

    .industrial__image { height: 100%; object-fit: cover; }

    .industrial__rail { left: 0; font-size: 3rem; }
    .industrial__title { left: 3.6875rem; bottom: 0; font-size: 2.25rem; line-height: 1.05; }
  }

  @media (min-width: 40.0625rem) and (max-width: 52rem) {
    .industrial { height: 118rem; }

    .industrial__image-wrap {
      top: 5rem;
      left: 15%;
      width: 70%;
      max-width: none;
    }

    .process-list {
      top: 30rem;
      left: 9%;
      width: 82%;
      height: auto;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .process-step,
    .process-step:nth-child(1),
    .process-step:nth-child(2),
    .process-step:nth-child(3),
    .process-step:nth-child(4) {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      border-left: 0;
    }

    .process-step__number {
      position: relative;
      top: auto;
      left: auto;
      flex: 0 0 auto;
    }

    .process-step__card {
      padding: 1.75rem 2rem;
      border-left-color: #222;
    }

    .process-step:not(:last-child)::after {
      top: 2.5rem;
      bottom: -2.25rem;
      left: 1.25rem;
    }
  }

  @media (max-width: 40rem) {
    .industrial {
      width: calc(100% - 1.5rem);
      height: 129.3125rem;
      margin-inline: auto;
    }

    .industrial__stage { display: contents; }

    .industrial__image-wrap {
      top: 5.6875rem;
      left: 1.375rem;
      width: calc(100% - 2.75rem);
      max-width: 19.1875rem;
      height: 21.9375rem;
      overflow: hidden;
    }

    .industrial__image { height: 100%; object-fit: cover; }

    .process-list {
      top: 31.1875rem;
      left: 2.3125rem;
      width: calc(100% - 5.375rem);
      display: flex;
      flex-direction: column;
      gap: 1.125rem;
    }

    .process-step {
      width: 100%;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.125rem;
    }

    .process-step:not(:last-child)::after {
      top: 2.5rem;
      bottom: -2.5rem;
      left: 0;
      border-left-color: #222;
    }

    .process-step__number {
      position: relative;
      top: auto;
      left: auto;
      width: 2.5rem;
      height: 2.5rem;
      flex: 0 0 auto;
      font-size: 1.25rem;
    }

    .process-step__card {
      min-height: 0;
      margin-left: 0;
      padding: 1.5625rem;
      border-left-color: #222;
    }

    .process-step__heading h3 { font-size: 1rem; line-height: 2; }
    .process-step__heading svg { width: 1.25rem; height: 1.25rem; }
    .process-step__card > p { margin-top: 0.875rem; font-size: 0.875rem; line-height: normal; }
    .process-step__card > .process-step__note { font-size: 0.75rem; line-height: normal; }

    .industrial__rail { left: 0; bottom: 0; font-size: 2rem; }
    .industrial__title { left: 2.75rem; bottom: 0; font-size: 1.25rem; line-height: 1.05; }
  }
</style>
