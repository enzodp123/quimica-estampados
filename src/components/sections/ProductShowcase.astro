---
import { Image } from "astro:assets";
import crewneck from "../../assets/images/buzo.png";
import hoodie from "../../assets/images/hero-hoodie.png";
import cap from "../../assets/images/gorra.png";
import BackgroundText from "../shared/BackgroundText.astro";

const products = [
  {
    name: "Remera oversize",
    description: "Algodón premium peinado 24.1",
    image: crewneck,
    imageClass: "product-card__image--crewneck",
    href: "/productos/remera-oversize/",
  },
  {
    name: "Buzo con capucha",
    description: "Algodón premium peinado 24.1",
    image: hoodie,
    imageClass: "product-card__image--hoodie",
    href: "/productos/buzo-canguro/",
  },
  {
    name: "Gorra visera",
    description: "Algodón premium peinado 24.1",
    image: cap,
    imageClass: "product-card__image--cap",
    href: "/productos/gorra-trucker/",
  },
];
---

<section id="impresiones" class="product-showcase" aria-labelledby="products-heading">
  <BackgroundText />

  <div class="product-showcase__rail product-showcase__rail--left" aria-hidden="true">
    Impresiones
  </div>

  <h2 id="products-heading" class="product-showcase__title">DTF<br />textil</h2>

  <div class="product-showcase__content">
    <header class="product-showcase__header">
      <div class="product-showcase__dots" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <p>Impresiones DTF de alta calidad para emprendedores, marcas y empresas.</p>
    </header>

    <div class="product-grid">
      {products.map(({ name, description, image, imageClass, href }) => (
        <a class="product-card" href={href} aria-label={`Ver ${name}`}>
          <div class="product-card__visual">
            <Image
              class:list={["product-card__image", imageClass]}
              src={image}
              alt={name}
              loading="lazy"
              widths={[320, 480, 640]}
              sizes="(max-width: 40rem) 85vw, (max-width: 64rem) 42vw, 25rem"
            />
          </div>

          <div class="product-card__body">
            <h3>{name}</h3>
            <p class="product-card__description">{description}</p>

            <div class="product-card__packs">
              <p>Packs disponibles:</p>
              <ul aria-label={`Packs disponibles para ${name}`}>
                <li>X5</li>
                <li>X10</li>
                <li>X20</li>
              </ul>
            </div>

            <div class="product-card__price">
              <span>Desde</span>
              <strong>$160.000</strong>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="product-showcase__pagination" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>
  </div>
</section>

<style>
  .product-showcase {
    --background-text-inset: 3.416875rem 0 3.4625rem 5.0625rem;
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 52.625rem;
    overflow: hidden;
    background: var(--color-background);
  }

  .product-showcase__content {
    display: contents;
  }

  .product-showcase__header {
    position: static;
    color: var(--color-text);
    font-family: var(--font-jetbrains-mono);
    text-transform: uppercase;
  }

  .product-showcase__dots {
    position: absolute;
    top: 1.6875rem;
    left: calc(50% - 17.46875rem);
    display: flex;
    gap: 0.25rem;
  }

  .product-showcase__dots span {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--color-cyan);
  }

  .product-showcase__dots span:nth-child(2) {
    background: var(--color-magenta);
  }

  .product-showcase__dots span:nth-child(3) {
    background: var(--color-yellow);
  }

  .product-showcase__header > p {
    position: absolute;
    top: 3.1875rem;
    left: calc(50% - 17.46875rem);
    font-family: var(--font-montserrat);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .product-grid {
    position: absolute;
    top: 9.25rem;
    left: 16.875%;
    width: 72.5%;
    height: 38.25rem;
    margin-top: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.625rem;
  }

  .product-card {
    height: 38.25rem;
    padding: 3.0625rem 2.0625rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    overflow: hidden;
    background: rgba(19, 19, 19, 0.5);
    border: 0.0625rem solid #353534;
    backdrop-filter: blur(2px);
    transition: transform var(--transition), border-color var(--transition);
  }

  .product-card:first-child { border-color: #1081b0; }

  .product-card:hover {
    transform: translateY(-0.375rem);
    border-color: rgba(0, 191, 232, 0.72);
  }

  .product-card__visual {
    width: 100%;
    height: 21.875rem;
    flex: 0 0 21.875rem;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .product-card__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 1.5rem 1.25rem rgba(0, 0, 0, 0.72));
  }

  .product-card__image--crewneck,
  .product-card__image--hoodie {
    max-width: 100%;
    max-height: 100%;
  }

  .product-card__image--cap {
    max-width: 100%;
    max-height: 100%;
  }

  .product-card__body {
    position: relative;
    min-height: 8.75rem;
    padding: 0;
    flex: 1;
    font-family: var(--font-jetbrains-mono);
    text-transform: uppercase;
  }

  .product-card h3 {
    color: var(--color-cyan);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .product-card__description,
  .product-card__packs > p {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.075em;
    line-height: 1.3;
  }

  .product-card__description {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .product-card__packs {
    margin-top: 1rem;
  }

  .product-card__packs > p {
    color: #8d8d8d;
    font-size: 0.75rem;
  }

  .product-card__packs ul {
    margin-top: 0.75rem;
    display: flex;
    gap: 0.75rem;
  }

  .product-card__packs li {
    width: 2.5rem;
    min-width: 2.5rem;
    min-height: 2.5rem;
    padding-inline: 0.375rem;
    display: grid;
    place-items: center;
    color: var(--color-cyan);
    border: 0.0625rem solid #353534;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .product-card__price {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }

  .product-card__price span {
    color: #a0a0a0;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .product-card__price strong {
    color: var(--color-text);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .product-showcase__pagination {
    position: absolute;
    top: 49.75rem;
    left: calc(50% + 3.75rem);
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transform: translateX(-50%);
  }

  .product-showcase__pagination span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: #fff;
  }

  .product-showcase__pagination span:first-child {
    width: 0.75rem;
    height: 0.75rem;
    background: var(--color-cyan);
  }

  .product-showcase__rail {
    position: absolute;
    z-index: 1;
    color: rgba(17, 159, 218, 0.8);
    font-family: var(--font-montserrat);
    font-size: clamp(3rem, 3.75vw, 4.5rem);
    font-weight: var(--vertical-title-font-weight);
    letter-spacing: -0.045em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .product-showcase__rail--left {
    bottom: 0;
    left: 3.6458%;
  }

  .product-showcase__title {
    position: absolute;
    bottom: 0;
    left: 8.3854%;
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: clamp(2.25rem, 2.5vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 0.97;
    text-transform: uppercase;
  }

  @media (max-width: 75rem) {
    .product-showcase__content {
      width: min(calc(100% - 12rem), 80.75rem);
    }

    .product-grid {
      gap: 1.5rem;
    }

    .product-showcase__rail--left {
      left: var(--editorial-rail-left);
    }

    .product-showcase__title {
      left: var(--editorial-title-left);
      font-size: 2.5rem;
    }
  }

  @media (min-width: 40.0625rem) and (max-width: 64rem) {
    .product-showcase {
      width: calc(100% - 3rem);
      height: 52.625rem;
      min-height: 52.625rem;
      margin-inline: auto;
      padding: 0;
    }

    .product-showcase__header {
      width: auto;
      margin: 0;
    }

    .product-showcase__dots {
      position: absolute;
      top: 4rem;
      left: 8.0625rem;
      margin: 0;
    }

    .product-showcase__header > p {
      position: absolute;
      top: 5.6875rem;
      left: 8.0625rem;
      font-size: 1rem;
    }

    .product-grid {
      position: absolute;
      top: 9.5625rem;
      left: 8.0625rem;
      width: max-content;
      height: 33.5rem;
      margin: 0;
      display: flex;
      gap: 1.5rem;
    }

    .product-card,
    .product-card:last-child {
      width: 19.5625rem;
      height: 33.5rem;
      padding: 1.5rem;
      flex: 0 0 19.5625rem;
      gap: 1rem;
    }

    .product-card__visual {
      height: 17rem;
      flex-basis: 17rem;
    }

    .product-card__body { min-height: 0; }

    .product-card h3 { font-size: 1.25rem; }

    .product-showcase__rail,
    .product-showcase__title {
      display: block;
    }

    .product-showcase__rail {
      bottom: 0;
      left: 1.75rem;
      font-size: 4rem;
    }

    .product-showcase__title {
      bottom: 0;
      left: 5.6875rem;
      font-size: 2.5rem;
    }

    .product-showcase__pagination { display: none; }
  }

  @media (max-width: 40rem) {
    .product-showcase {
      width: calc(100% - 1.5rem);
      height: 58.1875rem;
      min-height: 58.1875rem;
      margin-inline: auto;
      padding: 0;
      display: block;
    }

    .product-showcase__content {
      display: block;
    }

    .product-showcase__header {
      width: 100%;
    }

    .product-showcase__dots {
      position: absolute;
      top: 46rem;
      left: 50%;
      margin: 0;
      transform: translateX(-50%);
    }

    .product-showcase__header > p {
      position: absolute;
      top: 47.9375rem;
      left: 1.5rem;
      width: calc(100% - 3rem);
      font-size: 0.875rem;
      line-height: 1.2;
      text-align: center;
    }

    .product-grid {
      position: absolute;
      inset: 3rem 0 auto;
      width: 100%;
      height: 34.125rem;
      margin: 0;
      display: block;
    }

    .product-card,
    .product-card:last-child {
      width: 100%;
      height: 34.125rem;
      padding: 1.5rem;
      gap: 1rem;
    }

    .product-card:not(:first-child) { display: none; }

    .product-card__visual {
      height: 17rem;
      flex-basis: 17rem;
    }

    .product-card__body {
      min-height: 0;
      display: flex;
      flex-direction: column;
    }

    .product-card__price {
      position: static;
      margin-top: 1.5rem;
      align-self: flex-end;
    }

    .product-showcase__pagination {
      top: 38.25rem;
      left: 50%;
      display: flex;
    }

    .product-showcase__pagination span:nth-child(n + 4) { display: none; }

    .product-showcase__rail {
      bottom: 3.125rem;
      left: 0;
      display: block;
      font-size: 2rem;
    }

    .product-showcase__title {
      bottom: 3.125rem;
      left: 1.6875rem;
      display: block;
      font-size: 1.25rem;
      line-height: 1.05;
    }
  }
</style>
