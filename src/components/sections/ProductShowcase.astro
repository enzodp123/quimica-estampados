---
import { Image } from "astro:assets";
import crewneck from "../../assets/images/buzo.png";
import hoodie from "../../assets/images/buzo_capucha.png";
import cap from "../../assets/images/gorra.png";
import BackgroundText from "../shared/BackgroundText.astro";

const products = [
  {
    name: "Remera oversize",
    description: "Algodón premium peinado 24.1",
    image: crewneck,
    imageClass: "product-card__image--crewneck",
  },
  {
    name: "Buzo con capucha",
    description: "Algodón premium peinado 24.1",
    image: hoodie,
    imageClass: "product-card__image--hoodie",
  },
  {
    name: "Gorra visera",
    description: "Algodón premium peinado 24.1",
    image: cap,
    imageClass: "product-card__image--cap",
  },
];
---

<section id="impresiones" class="product-showcase" aria-labelledby="products-heading">
  <BackgroundText />

  <div class="product-showcase__rail product-showcase__rail--left" aria-hidden="true">
    Impresiones
  </div>

  <h2 id="products-heading" class="product-showcase__title">DTF<br />textil</h2>

  <div class="product-showcase__content">
    <header class="product-showcase__header">
      <div class="product-showcase__dots" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <p>Impresiones DTF de alta calidad para emprendedores, marcas y empresas.</p>
      <a href="#servicios">Productos similares</a>
    </header>

    <div class="product-grid">
      {products.map(({ name, description, image, imageClass }) => (
        <article class="product-card">
          <div class="product-card__visual">
            <Image
              class:list={["product-card__image", imageClass]}
              src={image}
              alt={name}
              loading="lazy"
              widths={[320, 480, 640]}
              sizes="(max-width: 40rem) 85vw, (max-width: 64rem) 42vw, 25rem"
            />
          </div>

          <div class="product-card__body">
            <h3>{name}</h3>
            <p class="product-card__description">{description}</p>

            <div class="product-card__packs">
              <p>Packs disponibles:</p>
              <ul aria-label={`Packs disponibles para ${name}`}>
                <li>XS</li>
                <li>X10</li>
                <li>X20</li>
              </ul>
            </div>

            <div class="product-card__price">
              <span>Desde</span>
              <strong>$160.000</strong>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .product-showcase {
    --editorial-heading-bottom: 5.25rem;
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 53.875rem;
    overflow: hidden;
    background: var(--color-background);
  }

  .product-showcase__content {
    width: min(calc(100% - 18rem), 80.75rem);
    margin-inline: auto;
    padding-top: 2rem;
  }

  .product-showcase__header {
    color: var(--color-text);
    font-family: var(--font-jetbrains-mono);
    text-transform: uppercase;
  }

  .product-showcase__dots {
    margin-bottom: 0.375rem;
    display: flex;
    gap: 0.25rem;
  }

  .product-showcase__dots span {
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--color-cyan);
  }

  .product-showcase__dots span:nth-child(2) {
    background: var(--color-magenta);
  }

  .product-showcase__dots span:nth-child(3) {
    background: var(--color-yellow);
  }

  .product-showcase__header > p {
    font-family: var(--font-montserrat);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .product-showcase__header > a {
    width: fit-content;
    margin-top: 0.625rem;
    padding-left: 0.75rem;
    display: block;
    color: var(--color-cyan);
    border-left: 0.0625rem solid var(--color-cyan);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    line-height: 1;
    transition: color var(--transition);
  }

  .product-showcase__header > a:hover,
  .product-showcase__header > a:focus-visible {
    color: var(--color-text);
  }

  .product-grid {
    margin-top: 3.375rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.375rem;
  }

  .product-card {
    height: 34.875rem;
    display: grid;
    grid-template-rows: 23.75rem 1fr;
    overflow: hidden;
    background: rgba(8, 8, 8, 0.68);
    border: 0.0625rem solid var(--color-border);
    transition: transform var(--transition), border-color var(--transition);
  }

  .product-card:hover {
    transform: translateY(-0.375rem);
    border-color: rgba(0, 191, 232, 0.72);
  }

  .product-card__visual {
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .product-card__image {
    width: auto;
    height: auto;
    object-fit: contain;
    filter: drop-shadow(0 1.5rem 1.25rem rgba(0, 0, 0, 0.72));
  }

  .product-card__image--crewneck,
  .product-card__image--hoodie {
    max-width: 76%;
    max-height: 19rem;
  }

  .product-card__image--cap {
    max-width: 82%;
    max-height: 15.5rem;
  }

  .product-card__body {
    position: relative;
    padding: 0.25rem 1.875rem 1.5rem;
    font-family: var(--font-jetbrains-mono);
    text-transform: uppercase;
  }

  .product-card h3 {
    color: var(--color-cyan);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.045em;
    line-height: 1.25;
  }

  .product-card__description,
  .product-card__packs > p {
    color: var(--color-text);
    font-weight: 700;
    letter-spacing: 0.075em;
    line-height: 1.3;
  }

  .product-card__description {
    margin-top: 0.875rem;
    font-size: 0.875rem;
  }

  .product-card__packs {
    margin-top: 0.875rem;
  }

  .product-card__packs > p {
    color: #8d8d8d;
    font-size: 0.75rem;
  }

  .product-card__packs ul {
    margin-top: 0.625rem;
    display: flex;
    gap: 0.625rem;
  }

  .product-card__packs li {
    min-width: 2.125rem;
    min-height: 2.125rem;
    padding-inline: 0.375rem;
    display: grid;
    place-items: center;
    color: var(--color-cyan);
    border: 0.0625rem solid rgba(0, 191, 232, 0.25);
    font-size: 0.625rem;
    font-weight: 700;
  }

  .product-card__price {
    position: absolute;
    right: 1.875rem;
    bottom: 2.125rem;
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
  }

  .product-card__price span {
    color: #a0a0a0;
    font-size: 0.625rem;
    font-weight: 700;
  }

  .product-card__price strong {
    color: var(--color-text);
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .product-showcase__rail {
    position: absolute;
    z-index: 1;
    color: var(--color-cyan);
    font-family: var(--font-montserrat);
    font-size: var(--vertical-title-font-size);
    font-weight: var(--vertical-title-font-weight);
    letter-spacing: -0.045em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .product-showcase__rail--left {
    bottom: var(--editorial-heading-bottom);
    left: var(--editorial-rail-left);
  }

  .product-showcase__title {
    position: absolute;
    bottom: var(--editorial-heading-bottom);
    left: var(--editorial-title-left);
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-transform: uppercase;
  }

  @media (max-width: 75rem) {
    .product-showcase__content {
      width: min(calc(100% - 12rem), 80.75rem);
    }

    .product-grid {
      gap: 1.5rem;
    }

    .product-showcase__rail--left {
      left: var(--editorial-rail-left);
    }

    .product-showcase__title {
      left: var(--editorial-title-left);
      font-size: 2.5rem;
    }
  }

  @media (max-width: 64rem) {
    .product-showcase {
      height: auto;
      min-height: 53.875rem;
      padding-block: 4rem 5rem;
    }

    .product-showcase__content {
      width: min(calc(100% - 8rem), 50rem);
      padding-top: 0;
    }

    .product-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .product-card:last-child {
      grid-column: 1 / -1;
      width: calc(50% - 0.75rem);
      justify-self: center;
    }

    .product-showcase__rail,
    .product-showcase__title {
      display: none;
    }
  }

  @media (max-width: 40rem) {
    .product-showcase__content {
      width: calc(100% - 3rem);
    }

    .product-showcase__header > p {
      max-width: 29rem;
    }

    .product-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .product-card,
    .product-card:last-child {
      width: 100%;
      height: 33rem;
      grid-column: auto;
      grid-template-rows: 21rem 1fr;
    }

    .product-card__body {
      padding-inline: 1.25rem;
    }

    .product-card__price {
      right: 1.25rem;
      bottom: 1.75rem;
    }
  }
</style>
