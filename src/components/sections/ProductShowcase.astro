---
import BackgroundText from "../shared/BackgroundText.astro";
import ProductCarousel from "../product/ProductCarousel.astro";
import { printingCards } from "../../data/product-cards";
---

<section id="impresiones" class="product-showcase" aria-labelledby="products-heading" data-figma-node="974:1922">
  <BackgroundText />
  <div class="product-showcase__rail" aria-hidden="true">Impresiones</div>
  <h2 id="products-heading" class="product-showcase__title">DTF<br />textil</h2>
  <div class="product-showcase__content">
    <header class="product-showcase__header">
      <div class="product-showcase__dots" aria-hidden="true"><span></span><span></span><span></span></div>
      <p>Impresiones DTF de alta calidad para emprendedores, marcas y empresas.</p>
    </header>
    <ProductCarousel id="featured-products" label="Carrusel de productos destacados" cards={printingCards} figmaNode="1144:2781" />
  </div>
</section>

<style>
  .product-showcase {
    --section-title-offset: 0rem;
    --background-text-inset: 3.416875rem 0 3.4625rem 5.0625rem;
    position: relative;
    isolation: isolate;
    width: 100%;
    padding-block: var(--section-block-padding);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--color-background);
  }
  .product-showcase__content { order: 1; width: calc(100% - var(--section-content-start) - 1.5rem); margin-left: var(--section-content-start); }
  .product-showcase__header { margin-bottom: var(--card-gap); color: var(--color-text); font-family: var(--font-poppins); text-transform: uppercase; }
  .product-showcase__dots { display: flex; gap: 0.25rem; margin-bottom: 0.75rem; }
  .product-showcase__dots span { width: 0.875rem; height: 0.875rem; border-radius: 50%; background: var(--color-cyan); }
  .product-showcase__dots span:nth-child(2) { background: var(--color-magenta); }
  .product-showcase__dots span:nth-child(3) { background: var(--color-yellow); }
  .product-showcase__header > p { font-size: 1rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.25; }
  .product-showcase__rail {
    position: absolute; z-index: 1; bottom: var(--section-block-padding);
    left: calc(var(--section-title-inset) - var(--section-title-offset));
    color: rgba(17, 159, 218, 0.8); font-family: var(--font-poppins);
    font-size: var(--section-title-rail-size); font-weight: var(--vertical-title-font-weight);
    letter-spacing: -0.045em; line-height: 1; text-transform: uppercase;
    writing-mode: vertical-rl; transform: rotate(180deg);
  }
  .product-showcase__title {
    position: relative; order: 2; width: fit-content; margin-top: var(--section-content-gap);
    left: calc(var(--section-title-inset) - var(--section-title-offset) + var(--section-title-rail-size) + var(--section-title-gap));
    color: var(--color-text); font-family: var(--font-poppins); font-size: clamp(2.25rem, 2.5vw, 3rem);
    font-weight: 700; letter-spacing: -0.04em; line-height: 0.97; text-transform: uppercase;
  }
  @media (min-width: 40.0625rem) and (max-width: 80rem) {
    .product-showcase { --section-title-offset: 1.5rem; width: calc(100% - 3rem); margin-inline: auto; }
    .product-showcase__title { font-size: 2.5rem; }
  }
  @media (max-width: 40rem) {
    .product-showcase { --section-title-offset: 0.75rem; width: calc(100% - 1.5rem); margin-inline: auto; }
    .product-showcase__content { width: calc(100% - var(--section-content-start)); }
    .product-showcase__header > p { font-size: 0.875rem; line-height: 1.5; }
    .product-showcase__title { margin-top: 0.9375rem; font-size: 1.25rem; line-height: 1.05; }
  }
</style>
