---
import { Image } from "astro:assets";
import stickers from "../../assets/images/IMG1.png";
import cards from "../../assets/images/img2.png";
import dimensionalSign from "../../assets/images/img3.png";
import BackgroundText from "../shared/BackgroundText.astro";

const services = [
  {
    name: "Calcos",
    description: "Aplicaciones resistentes para productos, envases y vidrieras, con excelente adhesión y terminaciones de alta calidad.",
    image: stickers,
    imageAlt: "Calcos impresos a color para una marca gastronómica",
    imagePosition: "50% 48%",
  },
  {
    name: "Tarjetas personales",
    description: "Tarjetas profesionales con acabados premium que transmiten una excelente primera impresión.",
    image: cards,
    imageAlt: "Tarjetas personales negras con terminación brillante",
    imagePosition: "50% 42%",
  },
  {
    name: "Corpóreos en polifan",
    description: "Vinilos de corte para vidrieras, vehículos, señalética y aplicaciones comerciales con acabados de alta precisión.",
    image: dimensionalSign,
    imageAlt: "Cartel corpóreo de polifan instalado sobre una pared",
    imagePosition: "50% 50%",
  },
  {
    name: "Calcos",
    description: "Aplicaciones resistentes para productos, envases y vidrieras, con excelente adhesión y terminaciones de alta calidad.",
    image: stickers,
    imageAlt: "Calcos impresos a color para una marca gastronómica",
    imagePosition: "50% 48%",
  },
];
---

<section id="servicios" class="services" aria-labelledby="services-heading">
  <BackgroundText />

  <div class="services__rail" aria-hidden="true">Servicios</div>

  <div class="services__content">
    <div class="services__grid">
      {services.map(({ name, description, image, imageAlt, imagePosition }, index) => (
        <article class:list={["service-card", `service-card--${index + 1}`]}>
          <div class="service-card__visual">
            <Image
              class="service-card__image"
              src={image}
              alt={imageAlt}
              loading="lazy"
              widths={[480, 720, 960]}
              sizes="(max-width: 42rem) 86vw, (max-width: 64rem) 42vw, 25rem"
              style={`object-position: ${imagePosition};`}
            />
          </div>

          <div class="service-card__body">
            <h3>{name}</h3>
            <p>{description}</p>
          </div>
        </article>
      ))}
    </div>

    <div class="services__pagination" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>

    <h2 id="services-heading" class="services__title">Potenciamos<br />tu marca</h2>
  </div>
</section>

<style>
  .services {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 75.1875rem;
    overflow: hidden;
    background: var(--color-background);
    --background-text-inset: 14.6875rem 0 14.8125rem 5.0625rem;
  }

  .services__rail {
    position: absolute;
    left: 3.6458%;
    bottom: 0;
    z-index: 2;
    color: var(--color-yellow);
    font-family: var(--font-montserrat);
    font-size: clamp(3.5rem, 3.75vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .services__content {
    display: contents;
  }

  .services__grid {
    position: absolute;
    top: 7.75rem;
    left: 2.9167%;
    width: 94.1666%;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.875rem;
    align-items: start;
  }

  .service-card {
    height: 32.5538rem;
    min-width: 0;
    overflow: hidden;
    background: rgba(19, 19, 19, 0.5);
    border: 0.0625rem solid #353534;
    backdrop-filter: blur(0.125rem);
    transition: transform var(--transition), border-color var(--transition);
  }

  .service-card--1,
  .service-card--3 { margin-top: 5.946rem; }

  .service-card--2 { border-color: var(--color-yellow); }

  .service-card--4 { margin-top: 0.0625rem; }

  .service-card:hover,
  .service-card:focus-within {
    transform: translateY(-0.35rem);
    border-color: var(--color-yellow);
  }

  .service-card__visual {
    height: 23.75rem;
    overflow: hidden;
    background: #111;
  }

  .service-card--2 .service-card__visual { height: 21.9288rem; }

  .service-card__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  .service-card:hover .service-card__image { transform: scale(1.025); }

  .service-card__body {
    padding: 1.5rem 1.5rem 2rem;
  }

  .service-card h3 {
    color: var(--color-yellow);
    font-family: var(--font-jetbrains-mono);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.045em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .service-card p {
    margin-top: 0.75rem;
    color: rgba(255, 255, 255, 0.69);
    font-family: var(--font-poppins);
    font-size: 1rem;
    line-height: 1.5;
  }

  .services__pagination {
    position: absolute;
    top: 48.9375rem;
    left: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transform: translateX(-50%);
  }

  .services__pagination span {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
    background: #fff;
  }

  .services__pagination span:first-child {
    width: 0.75rem;
    height: 0.75rem;
    background: var(--color-yellow);
  }

  .services__title {
    position: absolute;
    left: 8.3854%;
    bottom: 0;
    z-index: 2;
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: clamp(2.5rem, 2.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.33;
    text-transform: uppercase;
  }

  @media (max-width: 75rem) {
    .services__grid { gap: 1.5rem; }
    .service-card__body { padding-inline: 1.25rem; }
    .service-card h3 { font-size: 1rem; }
    .service-card p { font-size: 0.875rem; }
  }

  @media (max-width: 64rem) {
    .services {
      height: auto;
      min-height: 0;
      padding: 5rem clamp(1.5rem, 5vw, 4rem) 6rem;
      --background-text-inset: 4rem 0 4rem 1rem;
    }

    .services__rail { display: none; }

    .services__content {
      display: flex;
      flex-direction: column;
    }

    .services__title {
      position: static;
      order: -1;
      margin-bottom: 3rem;
      font-size: clamp(2.5rem, 7vw, 4rem);
    }

    .services__grid {
      position: static;
      width: 100%;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.5rem;
    }

    .service-card,
    .service-card--1,
    .service-card--3,
    .service-card--4 {
      height: auto;
      margin-top: 0;
    }

    .service-card__visual,
    .service-card--2 .service-card__visual { height: 18rem; }

    .services__pagination {
      position: static;
      margin: 2.5rem auto 0;
      transform: none;
    }
  }

  @media (max-width: 42rem) {
    .services { padding-inline: 1rem; }
    .services__grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .service-card__visual { height: clamp(15rem, 69vw, 21rem); }
    .service-card__body { min-height: auto; }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card__image { transition: none; }
  }
</style>
