---
import { Image } from "astro:assets";
import stickers from "../../assets/services/calcos.png";
import cards from "../../assets/services/tarjetas-personales.png";
import folletos from "../../assets/services/folletos.png";
import labels from "../../assets/services/etiquetas.png";
import BackgroundText from "../shared/BackgroundText.astro";
import { whatsappUrl } from "../../data/site";

const services = [
  {
    name: "Calcos",
    responsiveName: "Calcos",
    description: "Son aptas interior/exterior, impresas con tintas ecosolventes, colores vibrantes, resistentes al agua.",
    image: stickers,
    imageAlt: "Calcos impresos a color para una marca gastronómica",
    imagePosition: "50% 50%",
    href: "/productos/calcos-papel/",
  },
  {
    name: "Tarjetas personales",
    responsiveName: "Tarjetas personales",
    description: "Terminación mate (sin brillo) o brillante. Ideales para profesionales, comercios y emprendimientos.",
    image: cards,
    imageAlt: "Tarjetas personales negras con terminación brillante",
    imagePosition: "50% 50%",
    href: "/productos/tarjetas-personales/",
  },
  {
    name: "Folletos",
    responsiveName: "Folletos",
    description: "Papel ilustración terminación brillante o matelina, hasta 120gr",
    image: folletos,
    imageAlt: "Folletos personalizados impresos a color",
    imagePosition: "50% 50%",
    href: "/productos/folletos/",
  },
  {
    name: "Etiquetas",
    responsiveName: "Etiquetas",
    description: "Terminación mate (sin brillo) o brillante. Ideales para profesionales, comercios y emprendimientos.",
    image: labels,
    imageAlt: "Etiquetas colgantes impresas para productos",
    imagePosition: "50% 50%",
    href: "/productos/etiquetas/",
  },
];
---

<section id="servicios" class="services" aria-labelledby="services-heading">
  <BackgroundText />

  <div class="services__rail" aria-hidden="true">Servicios</div>

  <div class="services__content">
    <div class="services__intro">
      <div class="services__intro-dots" aria-hidden="true"><span></span><span></span><span></span></div>
      <p>Todo lo que tu marca necesita, en un solo lugar. Conocé nuestros servicios de impresión, estampado y comunicación visual.</p>
    </div>

    <div class="services__grid">
      {services.map(({ name, responsiveName, description, image, imageAlt, imagePosition, href }, index) => (
        <a class:list={["service-card", `service-card--${index + 1}`]} href={href} aria-label={`Ver ${name}`}>
          <div class="service-card__visual">
            <Image
              class="service-card__image"
              src={image}
              alt={imageAlt}
              loading="lazy"
              widths={[480, 720, 960]}
              sizes="(max-width: 40rem) 18rem, (max-width: 64rem) 18rem, 25rem"
              style={`object-position: ${imagePosition};`}
            />
          </div>

          <div class="service-card__body">
            <h3>
              <span class="service-name service-name--desktop">{name}</span>
              <span class="service-name service-name--responsive">{responsiveName}</span>
            </h3>
            <p>{description}</p>
          </div>
        </a>
      ))}
    </div>

    <a class="services__all-cta" href="#contacto">Todos los servicios</a>

    <div class="services__extras">
      <article class="service-extra service-extra--cyan">
        <h3>Corpóreos en Polifan</h3>
        <p>Letras, logos y diseños realizados en polifan, ideales para destacar tu marca en vidrieras, locales, eventos y espacios comerciales.</p>
        <p class="service-extra__detail"><strong>¿Querés cotizar el tuyo?</strong> El presupuesto se realiza de manera personalizada según las medidas, cantidad, diseño y terminación</p>
        <a href={whatsappUrl("Hola, quisiera consultar por corpóreos en polifan.")} target="_blank" rel="noreferrer">Consultar</a>
      </article>
      <article class="service-extra service-extra--magenta">
        <h3>Impresión de gran formato</h3>
        <p>Impresión de alta calidad para vidrieras, locales, vehículos, cartelería y diferentes proyectos comerciales. Trabajamos con distintos tipos de materiales según la superficie, el uso y el resultado que quieras lograr.</p>
        <p class="service-extra__detail"><strong>Cada proyecto es diferente.</strong> Te asesoramos sobre cada material y cotizamos según las medidas, la cantidad y las características de cada trabajo.</p>
        <a href={whatsappUrl("Hola, quisiera consultar por impresión de gran formato.")} target="_blank" rel="noreferrer">Consultar</a>
      </article>
    </div>

    <h2 id="services-heading" class="services__title">Potenciamos<br />tu marca</h2>
  </div>
</section>

<style>
  .services {
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 77.375rem;
    overflow: hidden;
    background: var(--color-background);
    --background-text-inset: 14.6875rem 0 14.8125rem 5.0625rem;
  }

  .services__rail {
    position: absolute;
    left: 3.6458%;
    bottom: 0;
    z-index: 2;
    color: var(--color-yellow);
    font-family: var(--font-montserrat);
    font-size: clamp(3.5rem, 3.75vw, 4.5rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .services__content { display: contents; }
  .services__intro,
  .services__all-cta { display: none; }

  .services__grid {
    position: absolute;
    top: 8.25rem;
    left: 2.9167%;
    width: 94.1666%;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2.875rem;
    align-items: start;
  }

  .service-card {
    height: 32.5rem;
    min-width: 0;
    display: block;
    overflow: hidden;
    background: rgba(19, 19, 19, 0.5);
    border: 0.0625rem solid #353534;
    backdrop-filter: blur(0.125rem);
    transition: transform var(--transition), border-color var(--transition);
  }

  .service-card--1,
  .service-card--3 { margin-top: 5.946rem; }
  .service-card--2 { height: 32.5538rem; }
  .service-card--3 { height: 31.3038rem; }
  .service-card--4 { height: 34.375rem; margin-top: 0.125rem; }

  .service-card:hover,
  .service-card:focus-within {
    transform: translateY(-0.35rem);
    border-color: var(--color-yellow);
  }

  .service-card__visual {
    height: 21.875rem;
    overflow: hidden;
    background: #111;
  }

  .service-card--2 .service-card__visual { height: 21.9288rem; }
  .service-card--3 .service-card__visual { height: 22.4288rem; }
  .service-card--4 .service-card__visual { height: 23.75rem; }

  .service-card__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 420ms ease;
  }

  .service-card:hover .service-card__image { transform: scale(1.025); }
  .service-card__body { padding: 1.5rem 1.5rem 2rem; }

  .service-card h3,
  .service-extra h3 {
    color: var(--color-yellow);
    font-family: var(--font-jetbrains-mono);
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.045em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .service-name--responsive { display: none; }

  .service-card p,
  .service-extra p {
    margin-top: 0.75rem;
    color: rgba(255, 255, 255, 0.69);
    font-family: var(--font-poppins);
    font-size: 1rem;
    line-height: 1.5;
  }

  .service-extra p { margin-top: 1.5rem; }

  .services__extras {
    position: absolute;
    top: 49.625rem;
    left: 35.0521%;
    width: 59.4271%;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5625rem;
  }

  .service-extra {
    height: auto;
    min-height: 23.8125rem;
    padding: 1.5rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background: rgba(19, 19, 19, 0.72);
    border: 0.0625rem solid var(--color-border);
    transition: transform var(--transition), border-color var(--transition);
  }

  .service-extra--cyan { margin-top: 3rem; }
  .service-extra h3 { color: var(--color-yellow); }
  .service-extra__detail { margin-bottom: 1.5rem; }
  .service-extra__detail strong { display: block; color: var(--color-yellow); font-weight: 400; }

  .service-extra--cyan:hover,
  .service-extra--cyan:focus-within {
    transform: translateY(-0.35rem);
    border-color: var(--color-cyan);
  }

  .service-extra--magenta:hover,
  .service-extra--magenta:focus-within {
    transform: translateY(-0.35rem);
    border-color: var(--color-magenta);
  }

  .service-extra a {
    position: relative;
    width: 14.125rem;
    min-height: 3.4375rem;
    margin-top: auto;
    display: grid;
    place-items: center;
    color: var(--color-yellow);
    border: 0.09375rem solid var(--color-yellow);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-extra a::before,
  .service-extra a::after {
    content: "";
    position: absolute;
    height: 0.125rem;
    background: var(--color-background);
    pointer-events: none;
  }

  .service-extra a::before { top: -0.09375rem; left: 0.65625rem; width: 1.5625rem; }
  .service-extra a::after {
    right: 0.65625rem;
    bottom: -0.09375rem;
    width: 2.8125rem;
    background: linear-gradient(90deg, var(--color-background) 0 1.5625rem, transparent 1.5625rem 2.1875rem, var(--color-background) 2.1875rem);
  }

  .services__title {
    position: absolute;
    left: 8.3854%;
    bottom: 0;
    z-index: 2;
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: clamp(2.5rem, 2.5vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.33;
    text-transform: uppercase;
  }

  @media (max-width: 75rem) {
    .services__grid { gap: 1.5rem; }
    .service-card__body { padding-inline: 1.25rem; }
    .service-card h3 { font-size: 1rem; }
    .service-card p { font-size: 0.875rem; }
  }

  @media (min-width: 80.0625rem) and (max-width: 110rem) {
    .services { height: 86rem; }

    .services__grid {
      top: 6rem;
      left: 3rem;
      width: calc(100% - 6rem);
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(1rem, 2vw, 2.5rem);
    }

    .service-card,
    .service-card--1,
    .service-card--2,
    .service-card--3,
    .service-card--4 {
      height: auto;
      min-height: 34rem;
    }

    .service-card--1,
    .service-card--3 { margin-top: 4rem; }

    .service-card--2,
    .service-card--4 { margin-top: 0; }

    .service-card__visual,
    .service-card--1 .service-card__visual,
    .service-card--2 .service-card__visual,
    .service-card--3 .service-card__visual,
    .service-card--4 .service-card__visual {
      height: clamp(17rem, 20vw, 21.875rem);
    }

    .service-card__body {
      min-height: 0;
      padding: 1.5rem;
    }

    .services__extras {
      top: 48rem;
      left: 24%;
      width: 72%;
      gap: clamp(1.5rem, 2.5vw, 2.5625rem);
    }
  }

  @media (min-width: 40.0625rem) and (max-width: 80rem) {
    .services {
      width: calc(100% - 3rem);
      height: 92rem;
      margin-inline: auto;
    }

    .services__grid {
      top: 4.375rem;
      left: 1.125rem;
      width: calc(100% - 2.25rem);
      display: flex;
      gap: 0.8125rem;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline proximity;
      scrollbar-width: none;
    }

    .services__grid::-webkit-scrollbar { display: none; }

    .service-card,
    .service-card--1,
    .service-card--2,
    .service-card--3,
    .service-card--4 {
      width: 19.5625rem;
      height: auto;
      min-height: 26.125rem;
      flex: 0 0 19.5625rem;
      margin-top: 4.0625rem;
      scroll-snap-align: start;
    }

    .service-card--2,
    .service-card--4 { margin-top: 0; }

    .service-card--4 { display: block; }

    .service-card__visual,
    .service-card--1 .service-card__visual,
    .service-card--2 .service-card__visual,
    .service-card--3 .service-card__visual,
    .service-card--4 .service-card__visual { height: 14rem; }
    .service-card__body { min-height: 12.125rem; padding: 1.5rem; }
    .service-name--desktop { display: none; }
    .service-name--responsive { display: inline; }

    .services__pagination { display: none; }

    .services__extras {
      top: 40.5rem;
      left: 8.0625rem;
      width: calc(100% - 9.625rem);
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(1.5rem, 3.2vw, 2.5625rem);
    }

    .service-extra { min-width: 0; }

    .services__all-cta {
      position: absolute;
      top: 34.75rem;
      left: 50%;
      width: 13.5rem;
      min-height: 3rem;
      display: none;
      place-items: center;
      color: var(--color-yellow);
      border: 0.0625rem solid var(--color-yellow);
      font-family: var(--font-jetbrains-mono);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      transform: translateX(-50%);
    }

    .services__intro {
      position: absolute;
      right: 0;
      bottom: 6.625rem;
      width: 59%;
      display: none;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
    }

    .services__intro-dots { display: flex; gap: 0.2rem; margin-bottom: 0.75rem; }
    .services__intro-dots span { width: 0.75rem; height: 0.75rem; border-radius: 50%; background: var(--color-cyan); }
    .services__intro-dots span:nth-child(2) { background: var(--color-magenta); }
    .services__intro-dots span:nth-child(3) { background: var(--color-yellow); }
    .services__intro p {
      color: #e1e1df;
      font-family: var(--font-jetbrains-mono);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.035em;
      line-height: 1.55;
      text-transform: uppercase;
    }

    .services__rail { left: 0; font-size: var(--vertical-title-font-size); }
    .services__title { left: 4.5rem; font-size: 2rem; line-height: 1.05; }
  }

  @media (min-width: 40.0625rem) and (max-width: 56rem) {
    .services {
      height: auto;
      min-height: 0;
      padding: 3.5rem 0 11rem;
    }

    .services__content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .services__intro {
      position: static;
      width: 90%;
      display: flex;
      align-items: center;
      text-align: center;
    }

    .services__grid {
      position: static;
      width: 90%;
      margin-top: 2rem;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
      overflow: visible;
    }

    .service-card,
    .service-card--1,
    .service-card--2,
    .service-card--3 {
      width: 100%;
      height: auto;
      min-height: 26.125rem;
      margin-top: 0;
    }

    .service-card--3 {
      grid-column: 1 / -1;
      width: calc((100% - 1rem) / 2);
      justify-self: center;
    }

    .service-card--4 { display: none; }

    .services__all-cta {
      position: static;
      margin-top: 2rem;
      display: grid;
      transform: none;
    }

    .services__extras {
      position: static;
      width: min(90%, 34.375rem);
      margin-top: 3rem;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .service-extra--cyan { margin-top: 0; }
    .services__rail { bottom: 3rem; }
    .services__title { bottom: 3rem; }
  }

  @media (max-width: 40rem) {
    .services {
      width: calc(100% - 1.5rem);
      height: auto;
      min-height: 109.4375rem;
      margin-inline: auto;
      padding: 3rem 0 10rem;
    }

    .services__content {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .services__intro {
      width: 100%;
      min-height: 7.75rem;
      padding-inline: 0.75rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .services__intro-dots { display: flex; gap: 0.2rem; margin-bottom: 0.75rem; }
    .services__intro-dots span { width: 0.75rem; height: 0.75rem; border-radius: 50%; background: var(--color-cyan); }
    .services__intro-dots span:nth-child(2) { background: var(--color-magenta); }
    .services__intro-dots span:nth-child(3) { background: var(--color-yellow); }
    .services__intro p {
      max-width: 19.5rem;
      color: #e1e1df;
      font-family: var(--font-jetbrains-mono);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.035em;
      line-height: 1.55;
      text-transform: uppercase;
    }

    .services__grid {
      position: static;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.5rem;
    }

    .service-card,
    .service-card--1,
    .service-card--2,
    .service-card--3 {
      width: min(18rem, 100%);
      height: auto;
      margin-top: 0;
    }

    .service-card--1 { order: 2; }
    .service-card--2 { order: 1; }
    .service-card--3 { order: 3; }
    .service-card--4 { display: none; }
    .service-card__visual,
    .service-card--1 .service-card__visual,
    .service-card--2 .service-card__visual,
    .service-card--3 .service-card__visual,
    .service-card--4 .service-card__visual { height: 14rem; }
    .service-card__body { min-height: 11.25rem; padding: 1.5rem 1.5rem 2rem; }
    .service-card h3 { font-size: 1rem; }
    .service-card p { font-size: 0.875rem; line-height: 1.7; }
    .service-name--desktop { display: none; }
    .service-name--responsive { display: inline; }

    .services__pagination,
    .services__all-cta { display: none; }

    .services__extras {
      position: static;
      width: min(100%, 22rem);
      margin-top: 2.5rem;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }

    .service-extra {
      width: 100%;
      min-height: 0;
      padding: 1.5rem 1.25rem 2rem;
    }

    .service-extra--cyan { margin-top: 0; }
    .service-extra h3 { font-size: 1rem; }
    .service-extra p { font-size: 0.875rem; line-height: 1.7; }
    .service-extra a { width: min(14.125rem, 100%); }

    .services__rail {
      left: 0;
      bottom: 3rem;
      display: block;
      font-size: 2rem;
    }

    .services__title {
      left: 3.375rem;
      bottom: 3rem;
      font-size: 1.25rem;
      line-height: 1.05;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card__image { transition: none; }
  }
</style>
