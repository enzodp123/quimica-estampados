---
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BackgroundText from "../shared/BackgroundText.astro";
import brandImage from "../../assets/images/img1_marcas.png";
import brand1 from "../../assets/images/marca1.png";
import brand2 from "../../assets/images/marca2.png";
import brand3 from "../../assets/images/marca3.png";
import brand4 from "../../assets/images/marca4.png";
import brand5 from "../../assets/images/marca5.png";
import brand6 from "../../assets/images/marca6.png";

const testimonials = [
  {
    author: "Otra Cultura",
    quote: "“Los chicos trabajan excelente, a nosotros nos hicieron toda la grafica y la ropa que usamos todos los días, de una calidad hermosa. los super recomiendo”",
  },
  {
    author: "Veterinaria Pocas Pulgas",
    quote: "“Ese equipo la rompe toda! Son unos genios! Excelente calidad de diseños y materiales a un precio increíble. 100% recomendables“",
  },
  {
    author: "Lucia Novello",
    quote: "Siempre en el detalle para que quede tal cual lo imaginabas y mejor todavía ✨️Super profesionales y dedicados, gracias!! 👏❤️",
  },
];

const brands = [
  { src: brand1, alt: "Weber Panadería" },
  { src: brand2, alt: "Toys Victoria" },
  { src: brand3, alt: "FitMe Sportwear" },
  { src: brand4, alt: "La Fonda de Orly" },
  { src: brand5, alt: "Morfi" },
  { src: brand6, alt: "Unidad Educativa N.º 38 Sagrada Familia" },
];
---

<section id="marcas" class="brands" aria-labelledby="brands-heading" data-figma-node="1131:2432">
  <BackgroundText />

  <header class="brands__header">
    <div class="brands__dots" aria-hidden="true"><span></span><span></span><span></span></div>
    <h2 id="brands-heading">Marcas que eligieron<br />trabajar con nosotros</h2>
    <p>Acompañamos a marcas de distintos rubros ofreciendo producción confiable<br />y acabados de alta calidad.</p>
  </header>

  <div class="brands__body">
    <div id="testimonial-track" class="brands__testimonials" data-testimonial-carousel>
      {testimonials.map(({ author, quote }, index) => (
        <article class:list={["brands__value", `brands__value--${index + 1}`]} data-testimonial-card>
          <Icon class="brands__quote-icon" name="lucide:quote" aria-hidden="true" />
          <figure class="brands__testimonial">
            <figcaption>
              <Icon name="lucide:circle-user-round" aria-hidden="true" />
              <span>{author}</span>
            </figcaption>
            <blockquote><p>{quote}</p></blockquote>
          </figure>
          <span class="brands__value-line-slot" aria-hidden="true">
            <span class="brands__value-line"></span>
          </span>
        </article>
      ))}
    </div>

    <div class="brands__pagination" role="group" aria-label="Elegir testimonio">
      {testimonials.map(({ author }, index) => (
        <button
          type="button"
          aria-label={`Mostrar testimonio de ${author}`}
          aria-controls="testimonial-track"
          aria-current={index === 0 ? "true" : "false"}
          data-testimonial-dot
          data-index={index}
        ></button>
      ))}
    </div>

    <aside class="brands__cta" aria-label="Propuesta de productos personalizados">
      <Image
        class="brands__cta-image"
        src={brandImage}
        alt="Gorra y buzo personalizados por Química Estampados"
        widths={[480, 720, 960]}
        sizes="(max-width: 48rem) 100vw, 24vw"
        loading="lazy"
      />
      <div class="brands__cta-copy">
        <h3>¿Listo para ser la próxima marca?</h3>
        <p>Sumate a las empresas que ya confían en nuestro trabajo.</p>
        <p>Cada proyecto comienza con una idea y termina con un producto que representa tu marca.</p>
        <a href="#contacto">Pedir presupuesto</a>
      </div>
    </aside>
  </div>

  <div class="brands__trusted">
    <div class="brands__trusted-heading">
      <span aria-hidden="true">Marcas</span>
      <h3>Que confiaron<br />en nosotros</h3>
    </div>
    <div class="brands__logos" role="group" aria-label="Marcas que trabajan con Química Estampados">
      {brands.map(({ src, alt }) => (
        <Image src={src} alt={alt} widths={[160, 240, 320]} sizes="(max-width: 40rem) 40vw, 10vw" loading="lazy" />
      ))}
    </div>
  </div>
</section>

<script>
  const testimonialCarousel = document.querySelector<HTMLElement>("[data-testimonial-carousel]");
  const testimonialCards = Array.from(document.querySelectorAll<HTMLElement>("[data-testimonial-card]"));
  const testimonialDots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-testimonial-dot]"));

  const selectTestimonial = (index: number, shouldScroll = true) => {
    testimonialDots.forEach((dot, dotIndex) => dot.setAttribute("aria-current", String(dotIndex === index)));
    if (shouldScroll && testimonialCarousel) {
      testimonialCarousel.scrollTo({
        left: testimonialCarousel.clientWidth * index,
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
      });
    }
  };

  testimonialDots.forEach((dot) => {
    dot.addEventListener("click", () => selectTestimonial(Number(dot.dataset.index ?? 0)));
  });

  let testimonialScrollFrame = 0;
  testimonialCarousel?.addEventListener("scroll", () => {
    cancelAnimationFrame(testimonialScrollFrame);
    testimonialScrollFrame = requestAnimationFrame(() => {
      if (!testimonialCarousel.clientWidth) return;
      const index = Math.min(
        testimonialCards.length - 1,
        Math.max(0, Math.round(testimonialCarousel.scrollLeft / testimonialCarousel.clientWidth)),
      );
      selectTestimonial(index, false);
    });
  }, { passive: true });
</script>

<style>
  .brands {
    --brands-gutter: clamp(1rem, 4.8vw, 5.75rem);
    --background-text-inset: clamp(8rem, 9.2vw, 11rem) 0 clamp(7rem, 9.4vw, 11.25rem) var(--watermark-left);
    position: relative;
    isolation: isolate;
    height: 69rem;
    min-height: 69rem;
    overflow: hidden;
    padding: clamp(0.35rem, 0.42vw, 0.5rem) var(--brands-gutter) 0;
    background: var(--color-background);
  }

  .brands__header {
    position: relative;
    z-index: 1;
    margin-inline: auto;
    text-align: center;
  }

  .brands__dots {
    margin-bottom: clamp(0.35rem, 0.48vw, 0.58rem);
    display: flex;
    justify-content: center;
    gap: 0.2rem;
  }

  .brands__dots span {
    width: clamp(0.55rem, 0.68vw, 0.8rem);
    height: clamp(0.55rem, 0.68vw, 0.8rem);
    border-radius: 50%;
    background: var(--color-cyan);
  }

  .brands__dots span:nth-child(2) { background: var(--color-magenta); }
  .brands__dots span:nth-child(3) { background: var(--color-yellow); }

  .brands__header h2 {
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: clamp(1.25rem, 1.875vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.0833;
    text-transform: uppercase;
  }

  .brands__header p {
    margin-top: clamp(0.65rem, 0.7vw, 0.82rem);
    color: #e0e0de;
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.75rem, 0.8333vw, 1rem);
    font-weight: 700;
    letter-spacing: 0.055em;
    line-height: 1.75;
    text-transform: uppercase;
  }

  .brands__body {
    position: relative;
    z-index: 1;
    width: 100%;
    min-height: clamp(22.5rem, 32vw, 38.4rem);
    margin: clamp(0.7rem, 0.82vw, 1rem) auto 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr)) minmax(15.5rem, 1.28fr);
    gap: clamp(1.5rem, 3.5vw, 4.2rem);
    align-items: start;
  }

  .brands__testimonials { display: contents; }

  .brands__pagination { display: none; }

  .brands__pagination button {
    width: 0.625rem;
    height: 0.625rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fff;
    cursor: pointer;
  }

  .brands__pagination button[aria-current="true"] {
    width: 0.75rem;
    height: 0.75rem;
    background: var(--color-cyan);
  }

  .brands__value {
    min-width: 0;
    min-height: clamp(13.5rem, 19.7vw, 23.6rem);
    padding: clamp(1.85rem, 2.5vw, 3rem) clamp(1.2rem, 1.68vw, 2rem) clamp(1.2rem, 1.4vw, 1.7rem);
    display: flex;
    flex-direction: column;
    background: rgba(19, 19, 19, 0.5);
    border: 0.0625rem solid #353534;
    backdrop-filter: blur(2px);
  }

  .brands__value--1,
  .brands__value--3 { margin-top: clamp(1.8rem, 2.85vw, 3.4rem); }

  .brands__value--2 { margin-top: clamp(8.4rem, 12.25vw, 14.7rem); }

  .brands__quote-icon {
    width: clamp(0.8rem, 0.8vw, 0.95rem);
    height: clamp(0.8rem, 0.8vw, 0.95rem);
    flex: 0 0 auto;
    color: var(--color-cyan);
    stroke-width: 1.4;
  }

  .brands__testimonial {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .brands__testimonial figcaption {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #efefed;
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.875rem, 1.0417vw, 1.25rem);
    font-weight: 800;
    letter-spacing: 0.035em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .brands__testimonial figcaption :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
    flex: 0 0 1.5rem;
    color: var(--color-cyan);
    stroke-width: 1.5;
  }

  .brands__testimonial blockquote {
    margin-top: clamp(0.7rem, 1.05vw, 1.25rem);
  }

  .brands__testimonial p {
    color: #9a9a98;
    font-family: var(--font-poppins);
    font-size: clamp(0.875rem, 0.8333vw, 1rem);
    line-height: 1.5;
  }

  .brands__value-line-slot {
    min-height: clamp(2.5rem, 3vw, 3.625rem);
    display: flex;
    align-items: end;
    justify-content: center;
  }

  .brands__value-line {
    width: clamp(5.7rem, 7.5vw, 9rem);
    height: 0.0625rem;
    display: block;
    background: var(--color-cyan);
  }

  @media (min-width: 64.0625rem) {
    .brands__dots { gap: 0.25rem; }
    .brands__dots span { width: 0.875rem; height: 0.875rem; }
    .brands__header h2 { font-size: 2rem; }
    .brands__body { min-height: 38.5625rem; }
    .brands__value { height: 23.75rem; min-height: 23.75rem; padding: 3.0625rem 2.0625rem; }
    .brands__quote-icon { width: 1.5rem; height: 1.5rem; }
    .brands__testimonial { height: 10.25rem; min-height: 10.25rem; }
    .brands__testimonial figcaption { font-size: 1rem; line-height: 1.75; }
    .brands__testimonial p { font-size: 1rem; line-height: 1.5; }
    .brands__value-line-slot { min-height: 3.625rem; }
    .brands__value-line { width: 10rem; }
  }

  .brands__cta {
    min-width: 0;
    min-height: clamp(26rem, 32vw, 38.4rem);
    padding: clamp(1.65rem, 2.4vw, 2.9rem) clamp(1.65rem, 1.68vw, 2rem) 2rem;
    background: rgba(10, 10, 10, 0.92);
    border: 0.0625rem solid #353534;
    transition: border-color var(--transition), transform var(--transition);
  }

  .brands__cta:hover,
  .brands__cta:focus-within {
    border-color: var(--color-cyan);
  }

  .brands__cta-image {
    width: 100%;
    height: auto;
    aspect-ratio: 1.625 / 1;
    display: block;
    object-fit: cover;
  }

  .brands__cta-copy { padding-top: clamp(1.45rem, 1.45vw, 1.75rem); }

  .brands__cta h3 {
    color: var(--color-cyan);
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.875rem, 0.8333vw, 1rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    line-height: 1.75;
    text-transform: uppercase;
  }

  .brands__cta p {
    margin-top: 0.8rem;
    color: #a2a2a0;
    font-family: var(--font-poppins);
    font-size: clamp(0.875rem, 0.8333vw, 1rem);
    line-height: 1.5;
  }

  .brands__cta a {
    width: fit-content;
    min-width: clamp(9.8rem, 11.7vw, 14rem);
    min-height: clamp(2.45rem, 3vw, 3.6rem);
    margin: clamp(1.25rem, 1.4vw, 1.7rem) auto 0;
    padding: 0.6rem 0.9rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-cyan);
    border: 0.0625rem solid var(--color-cyan);
    font-family: var(--font-jetbrains-mono);
    font-size: clamp(0.75rem, 0.7292vw, 0.875rem);
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4286;
    text-transform: uppercase;
    transition: color var(--transition), background var(--transition);
  }

  .brands__cta a:hover,
  .brands__cta a:focus-visible {
    color: #050505;
    background: var(--color-cyan);
  }

  @media (min-width: 64.0625rem) {
    .brands__cta { min-height: 38.5625rem; }
  }

  .brands__trusted {
    position: relative;
    z-index: 1;
    min-height: 8.75rem;
    margin: clamp(2rem, 4.4vw, 5.3rem) calc(var(--brands-gutter) * -1) 0;
    padding: 0 0 0 var(--brands-gutter);
    display: grid;
    grid-template-columns: 27rem minmax(0, 1fr);
    align-items: center;
    border-top: 0.0625rem solid rgba(255, 255, 255, 0.035);
  }

  .brands__trusted-heading {
    position: relative;
    height: 8.75rem;
    display: flex;
    align-items: end;
  }

  .brands__trusted-heading > span {
    position: absolute;
    bottom: 2.3rem;
    left: 0;
    color: var(--color-cyan);
    font-family: var(--font-montserrat);
    font-size: 4.5rem;
    font-weight: 700;
    letter-spacing: -0.05em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .brands__trusted-heading h3 {
    margin-left: 4rem;
    padding-bottom: 2.2rem;
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: clamp(1.4rem, 1.875vw, 2.25rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.0833;
    text-transform: uppercase;
  }

  .brands__logos {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: center;
    gap: clamp(1rem, 2vw, 2.4rem);
  }

  .brands__logos :global(img) {
    width: 100%;
    height: clamp(3.3rem, 5vw, 6rem);
    display: block;
    object-fit: contain;
  }

  @media (min-width: 40.0625rem) and (max-width: 110rem) {
    .brands {
      width: calc(100% - 3rem);
      height: 68rem;
      min-height: 0;
      margin-inline: auto;
      padding: 0;
    }

    .brands__header {
      position: absolute;
      top: 4.25rem;
      left: 50%;
      width: 60.963%;
      transform: translateX(-50%);
    }

    .brands__header h2 { font-size: 1.5rem; }
    .brands__header p { font-size: 1rem; line-height: 1.75; }
    .brands__header p br { display: none; }

    .brands__body { display: contents; }
    .brands__testimonials {
      position: absolute;
      top: 20.9375rem;
      left: 10.451%;
      width: 36.885%;
      height: 23.75rem;
      display: flex;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .brands__testimonials::-webkit-scrollbar { display: none; }
    .brands__value,
    .brands__value--1,
    .brands__value--2,
    .brands__value--3 {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      height: 23.75rem;
      min-height: 0;
      margin: 0;
      padding: 3.0625rem clamp(1.25rem, 3.223vw, 2.0625rem);
      display: flex;
      flex: 0 0 100%;
      scroll-snap-align: start;
    }

    .brands__quote-icon { width: 1.5rem; height: 1.5rem; }
    .brands__testimonial { min-height: 10.25rem; }
    .brands__testimonial figcaption { font-size: 1rem; line-height: 1.75; }
    .brands__testimonial p { font-size: 1rem; line-height: 1.5; }
    .brands__pagination {
      position: absolute;
      top: 45.375rem;
      left: 28.8935%;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
      transform: translateX(-50%);
    }

    .brands__pagination button {
      width: 0.625rem;
      height: 0.625rem;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: #fff;
      cursor: pointer;
    }

    .brands__pagination button[aria-current="true"] {
      width: 0.75rem;
      height: 0.75rem;
      background: var(--color-cyan);
    }
    .brands__cta {
      position: absolute;
      top: 17rem;
      left: 52.152%;
      width: 40.676%;
      height: 33.25rem;
      min-height: 0;
      margin: 0;
      padding: clamp(1.5rem, 3.223vw, 2.0625rem);
    }

    .brands__cta-image { height: 12.5rem; aspect-ratio: auto; }
    .brands__cta h3,
    .brands__cta p { font-size: 1rem; }
    .brands__cta a { min-width: 14.125rem; min-height: 3.4375rem; font-size: 0.875rem; }

    .brands__trusted { display: contents; }
    .brands__trusted-heading {
      position: absolute;
      left: 0;
      bottom: 0;
      width: 48.566%;
      height: 13.75rem;
    }
    .brands__trusted-heading > span { bottom: 0; left: 0; font-size: 3rem; }
    .brands__trusted-heading h3 { margin-left: 4.4375rem; padding-bottom: 0; font-size: 2.25rem; line-height: 1.05; }
    .brands__logos {
      position: absolute;
      right: -1.537%;
      bottom: 5.6875rem;
      width: 91.086%;
      height: 10rem;
      padding: 0 6.455% 0 0;
      display: grid;
      grid-template-columns: repeat(6, 10rem);
      gap: 3.5rem;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
      scroll-snap-type: inline proximity;
      scrollbar-width: none;
      border: 0.0625rem solid rgba(240, 237, 230, 0.1);
    }
    .brands__logos::-webkit-scrollbar { display: none; }
    .brands__logos :global(img) { width: 10rem; height: 10rem; scroll-snap-align: start; }
  }

  @media (min-width: 40.0625rem) and (max-width: 52rem) {
    .brands { height: 100rem; }

    .brands__header {
      top: 4rem;
      left: 6%;
      width: 88%;
      transform: none;
      text-align: left;
    }

    .brands__dots { justify-content: flex-start; }

    .brands__body {
      position: absolute;
      top: 16rem;
      left: 6%;
      width: 88%;
      min-height: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.125rem;
    }

    .brands__testimonials {
      position: relative;
      top: auto;
      left: auto;
      width: min(100%, 22.5rem);
      height: 23.75rem;
      flex: 0 0 auto;
    }

    .brands__pagination {
      position: static;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.25rem;
      transform: none;
    }

    .brands__cta {
      position: relative;
      top: auto;
      left: auto;
      width: min(100%, 28rem);
    }

    .brands__trusted {
      position: absolute;
      left: 0;
      bottom: 0;
      width: 100%;
      min-height: 18rem;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      border: 0;
    }

    .brands__logos {
      position: static;
      order: 1;
      width: 100%;
      height: 8.5rem;
      padding-right: 3rem;
      grid-template-columns: repeat(6, 7.5rem);
      gap: 2.5rem;
    }

    .brands__logos :global(img) { width: 7.5rem; height: 7.5rem; }

    .brands__trusted-heading {
      position: static;
      order: 2;
      width: 100%;
      height: 8.25rem;
      display: flex;
      align-items: end;
      gap: 0.5rem;
    }

    .brands__trusted-heading > span {
      position: static;
      font-size: 3rem;
    }

    .brands__trusted-heading h3 {
      margin: 0;
      padding: 0;
      font-size: 2rem;
    }
  }

  @media (max-width: 40rem) {
    .brands {
      width: calc(100% - 1.5rem);
      height: auto;
      min-height: 101.88rem;
      margin-inline: auto;
      padding: 3rem 0 10rem;
    }

    .brands__header { text-align: left; }
    .brands__header h2 { font-size: 1.25rem; }
    .brands__header p { margin-top: 0.875rem; font-size: 1rem; line-height: 1.75; }
    .brands__header p br { display: none; }
    .brands__dots { justify-content: flex-start; }

    .brands__body {
      min-height: 0;
      margin-top: 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.125rem;
    }

    .brands__testimonials {
      width: 100%;
      max-width: 19.875rem;
      display: flex;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }
    .brands__testimonials::-webkit-scrollbar { display: none; }
    .brands__value,
    .brands__value--1,
    .brands__value--2,
