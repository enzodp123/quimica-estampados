---
import { Image } from "astro:assets";
import BackgroundText from "../shared/BackgroundText.astro";
import work1 from "../../assets/images/nuestros1.png";
import work2 from "../../assets/images/nuestros2.png";
import work3 from "../../assets/images/nuestros3.png";
import work4 from "../../assets/images/nuestros4.png";
import work5 from "../../assets/images/nuestros5.png";
import galleryClose from "../../assets/icons/gallery-close.svg";
import calcos1 from "../../assets/works/calcos/1.png";
import calcos2 from "../../assets/works/calcos/2.png";
import calcos3 from "../../assets/works/calcos/3.png";
import calcos4 from "../../assets/works/calcos/4.png";
import calcos5 from "../../assets/works/calcos/5.png";
import papeleria1 from "../../assets/works/papeleria/1.png";
import papeleria2 from "../../assets/works/papeleria/2.png";
import papeleria3 from "../../assets/works/papeleria/3.png";
import papeleria4 from "../../assets/works/papeleria/4.png";
import papeleria5 from "../../assets/works/papeleria/5.png";
import formato1 from "../../assets/works/gran-formato/1.png";
import formato2 from "../../assets/works/gran-formato/2.png";
import formato3 from "../../assets/works/gran-formato/3.png";
import formato4 from "../../assets/works/gran-formato/4.png";
import formato5 from "../../assets/works/gran-formato/5.png";
import corporeos1 from "../../assets/works/corporeos/1.png";
import corporeos2 from "../../assets/works/corporeos/2.png";
import corporeos3 from "../../assets/works/corporeos/3.png";
import corporeos4 from "../../assets/works/corporeos/4.png";
import corporeos5 from "../../assets/works/corporeos/5.png";

const workCategories = [
  {
    id: "textil",
    label: "Estampado textil",
    figmaNode: "estado original",
    works: [
      { label: "Estampado textil personalizado", image: work1 },
      { label: "Tarjetas personales estampadas", image: work2 },
      { label: "Calcos personalizados aplicados", image: work3 },
      { label: "Stickers impresos", image: work4 },
      { label: "Gorras estampadas", image: work5 },
    ],
  },
  {
    id: "calcos",
    label: "Calcos",
    figmaNode: "1032:2174",
    works: [
      { label: "Calcos institucionales troquelados", image: calcos1 },
      { label: "Calcos transparentes personalizados", image: calcos2 },
      { label: "Calcos para emprendimientos", image: calcos3 },
      { label: "Calcos tipográficos en relieve", image: calcos4 },
      { label: "Calcos circulares personalizados", image: calcos5 },
    ],
  },
  {
    id: "papeleria",
    label: "Papelería",
    figmaNode: "1033:2254",
    works: [
      { label: "Tarjetas personales azules", image: papeleria1 },
      { label: "Tarjetas personales color coral", image: papeleria2 },
      { label: "Tarjetas para cerrajería", image: papeleria3 },
      { label: "Tarjetas personales grises", image: papeleria4 },
      { label: "Papelería comercial impresa", image: papeleria5 },
    ],
  },
  {
    id: "gran-formato",
    label: "Impresión en gran formato",
    figmaNode: "1033:2334",
    works: [
      { label: "Vidriera comercial impresa", image: formato1 },
      { label: "Banners impresos para comercio", image: formato2 },
      { label: "Exhibidores gráficos impresos", image: formato3 },
      { label: "Gráfica para minimercado", image: formato4 },
      { label: "Gráfica de gran formato para vidriera", image: formato5 },
    ],
  },
  {
    id: "corporeos",
    label: "Corpóreos en polifan",
    figmaNode: "1033:2414",
    works: [
      { label: "Logo corpóreo para oficina", image: corporeos1 },
      { label: "Letras corpóreas para fachada histórica", image: corporeos2 },
      { label: "Cartel corpóreo para carnicería", image: corporeos3 },
      { label: "Letras corpóreas de alto impacto", image: corporeos4 },
      { label: "Cartel corpóreo para comercio", image: corporeos5 },
    ],
  },
];

const initialWorks = workCategories[0].works;
---

<section id="trabajos" class="work-gallery" aria-labelledby="work-gallery-heading">
  <BackgroundText />

  <div class="work-gallery__rail" aria-hidden="true">Nuestros</div>
  <h2 id="work-gallery-heading" class="work-gallery__title">Trabajos<br />realizados</h2>

  <div class="work-gallery__content">
    <header class="work-gallery__header">
      <div class="work-gallery__dots" aria-hidden="true"><span></span><span></span><span></span></div>
      <h3>Cada detalle cuenta</h3>
      <p>Desde prendas personalizadas hasta piezas gráficas y corporativas, cada trabajo está pensado para representar una marca con la mejor terminación posible.</p>
    </header>

    <nav class="work-gallery__filters work-gallery__filters--desktop" aria-label="Categorías de trabajos">
      {workCategories.map((category, index) => (
        <button
          class:list={{ "is-active": index === 0 }}
          type="button"
          data-work-filter={category.id}
          aria-controls={`work-panel-${category.id}`}
          aria-pressed={index === 0 ? "true" : "false"}
        >{category.label}</button>
      ))}
    </nav>

    <nav class="work-gallery__filters work-gallery__filters--responsive" aria-label="Categorías de trabajos">
      {workCategories.map((category, index) => (
        <button
          class:list={{ "is-active": index === 0 }}
          type="button"
          data-work-filter={category.id}
          aria-controls={`work-panel-${category.id}`}
          aria-pressed={index === 0 ? "true" : "false"}
        >{category.label}</button>
      ))}
    </nav>

    {workCategories.map((category, categoryIndex) => (
      <div
        id={`work-panel-${category.id}`}
        class="work-gallery__grid"
        data-work-panel={category.id}
        data-figma-node={category.figmaNode}
        aria-label={`Galería de ${category.label}`}
        hidden={categoryIndex !== 0}
      >
        <div class="work-gallery__mosaic">
          {category.works.slice(0, 2).map(({ label, image }, index) => (
            <button
              class:list={["work-gallery__media", `work-gallery__media--${index + 1}`]}
              type="button"
              data-work-image
              data-image-src={image.src}
              data-image-alt={label}
              aria-label={`Ampliar ${label}`}
            >
              <Image class="work-gallery__image" src={image} alt={label} loading="lazy" widths={[480, 720, 960]} sizes="(max-width: 42rem) 100vw, 40vw" />
            </button>
          ))}
          {category.works.slice(2, 4).map(({ label, image }, index) => (
            <button
              class:list={["work-gallery__media", `work-gallery__media--${index + 4}`]}
              type="button"
              data-work-image
              data-image-src={image.src}
              data-image-alt={label}
              aria-label={`Ampliar ${label}`}
            >
              <Image class="work-gallery__image" src={image} alt={label} loading="lazy" widths={[480, 720, 960]} sizes="(max-width: 42rem) 100vw, 40vw" />
            </button>
          ))}
        </div>

        <button
          class="work-gallery__media work-gallery__media--3"
          type="button"
          data-work-image
          data-image-src={category.works[4].image.src}
          data-image-alt={category.works[4].label}
          aria-label={`Ampliar ${category.works[4].label}`}
        >
          <Image class="work-gallery__image" src={category.works[4].image} alt={category.works[4].label} loading="lazy" widths={[480, 720, 960]} sizes="(max-width: 42rem) 100vw, 28vw" />
        </button>
      </div>
    ))}

    <a class="work-gallery__cta" href="#contacto">Ver más trabajos</a>
  </div>

  <dialog class="work-lightbox" data-work-lightbox aria-label="Vista ampliada del trabajo">
    <button class="work-lightbox__close" type="button" data-work-lightbox-close aria-label="Cerrar imagen ampliada">
      <img src={galleryClose.src} width="32" height="32" alt="" />
    </button>
    <div class="work-lightbox__frame">
      <img class="work-lightbox__image" data-work-lightbox-image src={initialWorks[4].image.src} alt={initialWorks[4].label} />
    </div>
  </dialog>
</section>

<script>
  const workLightbox = document.querySelector<HTMLDialogElement>("[data-work-lightbox]");
  const workLightboxImage = workLightbox?.querySelector<HTMLImageElement>("[data-work-lightbox-image]");
  const workLightboxClose = workLightbox?.querySelector<HTMLButtonElement>("[data-work-lightbox-close]");
  const workFilters = document.querySelectorAll<HTMLButtonElement>("[data-work-filter]");
  const workPanels = document.querySelectorAll<HTMLElement>("[data-work-panel]");

  const selectWorkCategory = (category: string) => {
    workFilters.forEach((filter) => {
      const active = filter.dataset.workFilter === category;
      filter.classList.toggle("is-active", active);
      filter.setAttribute("aria-pressed", String(active));
    });
    workPanels.forEach((panel) => {
      panel.hidden = panel.dataset.workPanel !== category;
    });
  };

  workFilters.forEach((filter) => {
    filter.addEventListener("click", () => {
      if (filter.dataset.workFilter) selectWorkCategory(filter.dataset.workFilter);
    });
  });

  const closeWorkLightbox = () => {
    workLightbox?.close();
  };

  document.querySelectorAll<HTMLButtonElement>("[data-work-image]").forEach((item) => {
    item.addEventListener("click", () => {
      if (!workLightbox || !workLightboxImage) return;
      workLightboxImage.src = item.dataset.imageSrc ?? "";
      workLightboxImage.alt = item.dataset.imageAlt ?? "Trabajo realizado";
      workLightbox.showModal();
      document.documentElement.classList.add("has-open-lightbox");
      workLightboxClose?.focus();
    });
  });

  workLightboxClose?.addEventListener("click", closeWorkLightbox);
  workLightbox?.addEventListener("click", (event) => {
    if (event.target === workLightbox) closeWorkLightbox();
  });
  workLightbox?.addEventListener("close", () => {
    document.documentElement.classList.remove("has-open-lightbox");
  });
</script>

<style>
  .work-gallery {
    --work-heading-bottom: 0rem;
    position: relative;
    isolation: isolate;
    width: 100%;
    height: 73.4375rem;
    overflow: hidden;
    background: var(--color-background);
  }

  .work-gallery__rail {
    position: absolute;
    bottom: var(--work-heading-bottom);
    left: var(--editorial-rail-left);
    z-index: 2;
    color: var(--color-cyan);
    font-family: var(--font-montserrat);
    font-size: var(--vertical-title-font-size);
    font-weight: var(--vertical-title-font-weight);
    letter-spacing: -0.045em;
    line-height: 1;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .work-gallery__title {
    position: absolute;
    bottom: var(--work-heading-bottom);
    left: clamp(5.5rem, 8.23vw, 9.875rem);
    z-index: 2;
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: 3rem;
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.98;
    text-transform: uppercase;
  }

  .work-gallery__content {
    width: min(67.55vw, 81.0625rem);
    margin-left: clamp(17.5rem, 21.15vw, 25.375rem);
    padding-top: 4.25rem;
  }

  .work-gallery__header {
    width: min(100%, 51.375rem);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .work-gallery__dots {
    margin: 0;
    display: flex;
    gap: 0.2rem;
  }

  .work-gallery__dots span {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 50%;
    background: var(--color-cyan);
  }

  .work-gallery__dots span:nth-child(2) { background: var(--color-magenta); }
  .work-gallery__dots span:nth-child(3) { background: var(--color-yellow); }

  .work-gallery__header h3 {
    color: var(--color-text);
    font-family: var(--font-montserrat);
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .work-gallery__header p {
    max-width: 51rem;
    margin: 0;
    color: #e1e1df;
    font-family: var(--font-jetbrains-mono);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.045em;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .work-gallery__filters {
    margin-top: 2.25rem;
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  .work-gallery__filters--responsive { display: none; }

  .work-gallery__filters button {
    min-height: 3rem;
    padding: 0.0625rem 1.5625rem;
    color: #d7d7d5;
    background: rgba(8, 8, 8, 0.84);
    border: 0.0625rem solid var(--color-border);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.075em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
  }

  .work-gallery__filters button:hover,
  .work-gallery__filters button:focus-visible,
  .work-gallery__filters button.is-active {
    color: var(--color-text);
    border-color: var(--color-cyan);
  }

  @media (min-width: 64.0625rem) and (max-width: 80rem) {
    .work-gallery__filters button {
      padding-inline: 0.9rem;
      font-size: 0.68rem;
    }
  }

  .work-gallery__grid {
    height: 42rem;
    margin-top: 2.75rem;
    display: grid;
    grid-template-columns: 2.15fr 1fr;
    gap: 0.8125rem;
  }

  .work-gallery__grid[hidden] { display: none; }

  .work-gallery__mosaic {
    min-width: 0;
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 0.8125rem;
  }

  .work-gallery__media {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: #101010;
    border: 0.0625rem solid var(--color-border);
    cursor: zoom-in;
  }

  .work-gallery__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    background: rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(2px);
    transition: opacity var(--transition);
    pointer-events: none;
  }

  .work-gallery__media:hover::after,
  .work-gallery__media:focus-visible::after { opacity: 0; }

  .work-gallery__media:focus-visible { outline: 0.125rem solid var(--color-cyan); outline-offset: -0.125rem; }

  .work-gallery__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  .work-lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(16.5px);
  }

  .work-lightbox:not([open]) { display: none; }

  .work-lightbox[open] {
    display: grid;
    place-items: center;
  }

  .work-lightbox::backdrop {
    background: rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(16.5px);
  }

  .work-lightbox__close {
    position: absolute;
    top: 8.57%;
    right: 5.63%;
    z-index: 2;
    width: 2rem;
    height: 2rem;
    padding: 0;
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: transform var(--transition), opacity var(--transition);
  }

  .work-lightbox__close:hover,
  .work-lightbox__close:focus-visible { transform: scale(1.08); }
  .work-lightbox__close:focus-visible { outline: 0.125rem solid var(--color-cyan); outline-offset: 0.35rem; }
  .work-lightbox__close img { width: 100%; height: 100%; display: block; }

  .work-lightbox__frame {
    width: min(34.01vw, 40.8125rem);
    height: min(63.28dvh, 42rem);
    padding: 0.125rem;
    overflow: hidden;
    background: rgba(19, 19, 19, 0.5);
    border: 0.125rem solid var(--color-cyan);
    backdrop-filter: blur(2px);
  }

  .work-lightbox__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  :global(html.has-open-lightbox) { overflow: hidden; }

  .work-gallery__media--1 { grid-column: 1 / span 4; grid-row: 1; }
  .work-gallery__media--2 { grid-column: 5 / span 3; grid-row: 1; }
  .work-gallery__media--4 { grid-column: 1 / span 3; grid-row: 2; }
  .work-gallery__media--5 { grid-column: 4 / span 4; grid-row: 2; }

  .work-gallery__cta {
    width: fit-content;
    min-width: 14.25rem;
    min-height: 3.4375rem;
    margin: 3rem auto 0;
    transform: translateX(-1.5rem);
    padding: 0.75rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-cyan);
    border: 0.0625rem solid var(--color-cyan);
    font-family: var(--font-jetbrains-mono);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    transition: color var(--transition), background var(--transition);
  }

  .work-gallery__cta:hover,
  .work-gallery__cta:focus-visible {
    color: #050505;
    background: var(--color-cyan);
  }

  @media (min-width: 40.0625rem) and (max-width: 64rem) {
    .work-gallery {
      width: calc(100% - 3rem);
      height: 58.9375rem;
      margin-inline: auto;
    }

    .work-gallery__content {
      position: absolute;
      top: 5.4375rem;
      left: 7.377%;
      width: 85.35%;
      margin: 0;
      padding: 0;
    }

    .work-gallery__header { width: 98.68%; }
    .work-gallery__header h3 { font-size: 1.5rem; }
    .work-gallery__header p { max-width: none; font-size: 1rem; line-height: 1.5; }

    .work-gallery__filters--desktop { display: none; }
    .work-gallery__filters--responsive {
      margin-top: 2rem;
      display: flex;
      justify-content: flex-start;
      flex-wrap: nowrap;
      gap: 0.75rem;
      padding-bottom: 0.25rem;
      overflow-x: auto;
      transform: none;
      scrollbar-width: thin;
    }

    .work-gallery__filters button { min-height: 3rem; flex: 0 0 auto; font-size: 0.75rem; }

    .work-gallery__grid {
      height: 30.125rem;
      margin-top: 2rem;
      grid-template-columns: 2.15fr 1fr;
      gap: 0.5rem;
    }

    .work-gallery__cta {
      min-width: 14.125rem;
      min-height: 2.8125rem;
      margin-top: 2.3125rem;
      transform: none;
      font-size: 0.875rem;
    }

    .work-gallery__rail { left: 0; bottom: 0; font-size: 3rem; }
    .work-gallery__title { left: 3.6875rem; bottom: 0; font-size: 2.25rem; line-height: 1.05; }
  }

  @media (min-width: 40.0625rem) and (max-width: 52rem) {
    .work-gallery__filters--responsive {
      justify-content: flex-start;
      flex-wrap: wrap;
      overflow: visible;
      transform: none;
    }
  }

  @media (max-width: 40rem) {
    .work-gallery {
      width: calc(100% - 1.5rem);
      height: 75.5rem;
      margin-inline: auto;
      padding-block: 3rem;
    }

    .work-gallery__content {
      position: static;
      width: 100%;
      margin: 0;
      padding: 0;
    }

    .work-gallery__header { width: 100%; }
    .work-gallery__header h3 { font-size: 1.25rem; }
    .work-gallery__header p { max-width: none; font-size: 0.875rem; line-height: 1.714; }

    .work-gallery__filters--desktop { display: none; }
    .work-gallery__filters--responsive {
      margin-top: 2.375rem;
      display: flex;
      justify-content: flex-start;
      flex-wrap: wrap;
      gap: 0.75rem;
      overflow: visible;
    }

    .work-gallery__filters button {
      min-height: 3rem;
      padding: 0.75rem 1.5625rem;
      font-size: 0.75rem;
    }

    .work-gallery__grid {
      height: 34.8125rem;
      margin-top: 2.1875rem;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-template-rows: repeat(3, minmax(0, 1fr));
      gap: 0.3125rem;
    }

    .work-gallery__mosaic { display: contents; }
    .work-gallery__media { min-width: 0; min-height: 0; aspect-ratio: auto; }
    .work-gallery__media--1 { grid-column: 1 / span 2; grid-row: 1; }
    .work-gallery__media--2 { grid-column: 3 / span 2; grid-row: 1; }
    .work-gallery__media--3 { grid-column: 1 / span 4; grid-row: 2; }
    .work-gallery__media--4 { grid-column: 1 / span 2; grid-row: 3; }
    .work-gallery__media--5 { grid-column: 3 / span 2; grid-row: 3; }

    .work-gallery__cta { display: none; }
    .work-gallery__rail { left: 0; bottom: 3rem; font-size: 2rem; }
    .work-gallery__title { left: 2.75rem; bottom: 3rem; font-size: 1.25rem; line-height: 1.05; }

    .work-lightbox__close { top: 1.5rem; right: 1rem; }
    .work-lightbox__frame {
      width: calc(100vw - 2rem);
      height: min(72dvh, 42rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-lightbox__close,
    .work-gallery__media::after { transition: none; }
  }
</style>
