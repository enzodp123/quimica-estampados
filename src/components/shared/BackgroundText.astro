---
import backgroundCopy from "../../assets/images/background-copy.svg";
---

<div class="background-text" aria-hidden="true">
  <img src={backgroundCopy.src} width="1758" height="732" alt="" />
</div>

<style>
  .background-text {
    position: absolute;
    top: var(--background-text-top, 50%);
    left: var(--background-text-left, 4.21875%);
    z-index: -1;
    width: 91.58125%;
    transform: translateY(-50%);
    pointer-events: none;
    user-select: none;
  }

  .background-text img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 64rem) {
    .background-text {
      display: none;
    }
  }
</style>
