---
import { Icon } from "astro-icon/components";
import whatsappIcon from "../../assets/icons/whatsapp.svg";
import { whatsappUrl } from "../../data/site";
---

<div class="floating-actions">
  <a class="floating-actions__button floating-actions__top" href="#page-top" aria-label="Volver arriba" title="Volver arriba" data-back-to-top>
    <Icon name="lucide:arrow-up" aria-hidden="true" />
  </a>
  <a class="floating-actions__button floating-actions__whatsapp" href={whatsappUrl()} target="_blank" rel="noopener noreferrer" aria-label="Contactar por WhatsApp (abre en otra pestaña)" title="Contactar por WhatsApp">
    <img src={whatsappIcon.src} width="28" height="28" alt="" />
  </a>
</div>

<script>
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element) || !event.target.closest("[data-back-to-top]")) return;
    if (event instanceof MouseEvent && (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey)) return;
    event.preventDefault();
    window.scrollTo({
      top: 0,
      behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "instant" : "smooth",
    });
    if (event.detail === 0) {
      document.querySelector<HTMLAnchorElement>(".skip-link")?.focus({ preventScroll: true });
    }
  });
</script>

<style>
  .floating-actions {
    position: fixed;
    right: max(1.5rem, env(safe-area-inset-right));
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    z-index: 15;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .floating-actions__button {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 50%;
    box-shadow: 0 3px 12px rgb(0 0 0 / 25%);
    transition: transform 180ms ease, background-color 180ms ease;
  }
  .floating-actions__button:hover { transform: translateY(-2px); }
  .floating-actions__top {
    color: var(--color-text);
    background: var(--color-background);
    border: 1px solid var(--color-border);
  }
  .floating-actions__top:hover { background: #202020; }
  .floating-actions__top :global(svg) { width: 1.5rem; height: 1.5rem; }
  .floating-actions__whatsapp { background: #25d366; }
  .floating-actions__whatsapp:hover { background: #20bd5a; }
  @media (max-width: 40rem) {
    .floating-actions {
      right: max(0.875rem, env(safe-area-inset-right));
      bottom: max(0.875rem, env(safe-area-inset-bottom));
      gap: 0.625rem;
    }
    .floating-actions__button { width: 3rem; height: 3rem; }
  }
  @media print { .floating-actions { display: none; } }
</style>
