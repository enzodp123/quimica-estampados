---
import { Image } from "astro:assets";
import { visibleProducts } from "../../data/products";
import { outlinedGarmentSlugs } from "../../data/garment-outlines";
import shirt from "../../assets/images/remera_home_blanca.png";
import hoodie from "../../assets/images/hero-hoodie.png";
import cap from "../../assets/products/gorra-trucker/angled-2026.png";
import type { ImageMetadata } from "astro";

// The basic shirt appears once; sizes and colors share its hero slide.
const shirtVariants = new Set(["remera-oversize", "remera-nino"]);
const opening = ["buzo-canguro", "remera-unisex", "gorra-trucker"];
const products = [
  ...opening.map((slug) => visibleProducts.find((product) => product.slug === slug)!),
  ...visibleProducts.filter((product) => !opening.includes(product.slug) && !shirtVariants.has(product.slug)),
];
const heroImages: Record<string, ImageMetadata> = {
  "buzo-canguro": hoodie,
  "remera-unisex": shirt,
  "gorra-trucker": cap,
};
---

<div class="hero-products" data-hero-products aria-hidden="true" inert>
  {products.map((product, index) => (
    <div class="hero-products__item" data-hero-product={product.slug}
      data-position={index === 0 ? "left" : index === 1 ? "center" : index === 2 ? "right" : "hidden"}>
      <Image src={heroImages[product.slug] ?? product.heroImage ?? product.gallery[0]}
        class={outlinedGarmentSlugs.has(product.slug) ? "hero-products__image is-outlined" : "hero-products__image"}
        alt="" draggable="false" loading={index < 3 ? "eager" : "lazy"}
        fetchpriority={index === 1 ? "high" : "auto"}
        widths={[240, 480, 720, 960]} sizes="(max-width: 40rem) 15.5rem, (max-width: 80rem) 25rem, 27vw" />
    </div>
  ))}
</div>

<script>
  import { initHeroProducts } from "../../scripts/hero-products";
  initHeroProducts();
  document.addEventListener("astro:page-load", initHeroProducts);
</script>

<style>
  .hero-products { position: relative; width: 100%; height: 100%; pointer-events: none; user-select: none; }
  .hero-products__item {
    position: absolute;
    left: 87.12%;
    bottom: 0;
    width: calc(64% * var(--product-scale, 0.48));
    height: calc(100% * var(--product-scale, 0.48));
    transform: translateX(-50%);
    opacity: 0;
    visibility: hidden;
    transition: left 850ms cubic-bezier(0.22, 1, 0.36, 1),
      width 850ms cubic-bezier(0.22, 1, 0.36, 1),
      height 850ms cubic-bezier(0.22, 1, 0.36, 1), opacity 250ms ease;
  }
  .hero-products__item[data-position="left"] { visibility: visible; opacity: 1; left: 12.88%; }
  .hero-products__item[data-position="center"] { --product-scale: 1; visibility: visible; opacity: 1; left: 50%; }
  .hero-products__item[data-position="right"] { visibility: visible; opacity: 1; transition-delay: 0ms, 0ms, 0ms, 850ms; }
  .hero-products__image { width: 100%; height: 100%; object-fit: contain; object-position: center bottom; }
  .is-outlined { filter: drop-shadow(1px 0 0 #fff) drop-shadow(-1px 0 0 #fff) drop-shadow(0 1px 0 #fff) drop-shadow(0 -1px 0 #fff); }
  @media (max-width: 80rem) {
    .hero-products__item:not([data-position="center"]) { display: none; }
    .hero-products__item[data-position="center"] {
      left: 50%;
      width: min(100%, 25rem);
      height: 100%;
      transition: none;
      animation: product-appear 300ms ease;
    }
    .hero-products__image { object-position: center; }
  }
  @media (max-width: 40rem) {
    .hero-products__item[data-position="center"] { width: min(100%, 15.5rem); }
  }
  @keyframes product-appear {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-products__item { transition: opacity 250ms linear; }
    .hero-products__item[data-position="right"] { transition-delay: 0ms; }
    .hero-products__item[data-position="center"] { animation: none; }
  }
</style>
