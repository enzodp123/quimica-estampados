---
import MainLayout from "../layouts/MainLayout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/layout/Hero.astro";
import Footer from "../components/layout/footer.astro";
import Benefits from "../components/sections/Benefits.astro";
import ProductShowcase from "../components/sections/ProductShowcase.astro";
import Services from "../components/sections/Services.astro";
import IndustrialProcess from "../components/sections/IndustrialProcess.astro";
import WorkGallery from "../components/sections/WorkGallery.astro";
import About from "../components/sections/About.astro";
import Contact from "../components/sections/Contact.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import Faq from "../components/sections/Faq.astro";
---

<MainLayout title="Química Estampados | Tu marca, idea y negocio">
