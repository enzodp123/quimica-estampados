---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/footer.astro";
import ProductDetail from "../../components/product/ProductDetail.astro";
import { products, type Product } from "../../data/products";

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const pageTitle = product.seoTitle ?? product.title;
---

<MainLayout
  title={`${pageTitle} | Química Estampados`}
  description={`${pageTitle}. Productos personalizados de Química Estampados.`}
>
  <Header />
  <ProductDetail product={product} />
  <Footer />
</MainLayout>
